---
import Base from '../layouts/Base.astro';
import VisualHero from '../components/VisualHero.astro';
import MangaEntry from '../components/MangaEntry.astro';
import GuideArtwork from '../components/GuideArtwork.astro';
import RelatedConnectivityLinks from '../components/RelatedConnectivityLinks.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import { providers, byId, jpDate } from '../lib/data';
import { guides, categoryLabel } from '../lib/guides';
import { offers } from '../lib/offers';
import { SITE } from '../site.config.mjs';
const picks=[{id:'bbiq',audience:'au・UQ mobileと九州電力',reason:'戸建ての電気・スマホをまとめる',label:'13カ月目以降・割引条件あり'},{id:'docomo-hikari',audience:'ドコモの対象プラン',reason:'家族のドコモ回線とセットに',label:'1ギガ・タイプA・2年定期'},{id:'softbank-hikari',audience:'ソフトバンク・ワイモバイル',reason:'指定オプションとおうち割を使う',label:'1ギガ・2年自動更新'}].map(p=>({...p,provider:byId(p.id)!}));
const title='しらべまとめ帳｜通信・スマホ・学習サービスの条件を比較';
const description='全国のWi-Fi・光回線、主要なスマホ・SIM、セキュリティソフト、中古スマホと英語学習を比較。公式情報をもとに、料金・契約・保証の条件から選べます。47都道府県・市区町村から提供エリアの確認先も探せます。';
const collectionLd={'@context':'https://schema.org','@type':'CollectionPage',name:title,url:SITE.url+'/',description,inLanguage:'ja',mainEntity:{'@type':'ItemList',itemListElement:guides.map((g,i)=>({'@type':'ListItem',position:i+1,name:g.title,url:SITE.url+'/guides/'+g.slug+'/'}))}};
---
<Base title={title} description={description} jsonLd={[collectionLd]}>
  <div class="home-comparison">
    <header class="home-intro site-container"><VisualHero title={"家族の通信費を、\nまとめて診断。"} lead="家族の回線数・キャリア・使う年数から、自宅とスマホの組合せを比較。今の契約条件も確かめながら、自分たちに合う候補を探せます。" image="internet" eyebrow="回線・スマホをまとめて見直す"><div class="home-diagnosis-entry"><a class="home-diagnosis-button" href="/shindan/#diagnosis-form"><strong>家族の通信費を診断する</strong><span>詳しい住所・連絡先の入力は不要</span></a><a class="home-diagnosis-area" href="/hikari/area/">都道府県・市区町村からエリアを確認</a></div><nav aria-label="比較するテーマ"><a class="topic-shortcut" href="/hikari/"><strong>光回線の比較を見る</strong></a><a class="topic-shortcut" href="#learning"><strong>英語学習を選ぶ</strong></a></nav></VisualHero></header>

    <div class="site-container"><MangaEntry /></div>
    <aside class="site-container national-entry" aria-labelledby="national-entry-title"><div><p>全国のWi-Fi・光回線</p><h2 id="national-entry-title">自分の住む地域で、使える回線を確認する</h2></div><a href="/hikari/area/">47都道府県・市区町村から探す</a></aside>
    <div class="site-container"><RelatedConnectivityLinks /></div>
    <section id="internet" class="site-container home-section" aria-labelledby="internet-title"><div class="section-heading"><div><h2 id="internet-title">鹿児島の光回線は、スマホから絞る</h2></div><a href="/hikari/?prefecture=46" class="all-link">{providers.filter(p=>p.kind==='fiber').length}社の料金・工事費を比べる →</a></div>
      <div class="home-picks">{picks.map(({provider:p,...item})=><article><p class="pick-audience">{item.audience}</p><h3>{p.name}</h3><p class="pick-price"><span>戸建て月額</span><strong>{p.house?.label}</strong></p><p class="pick-condition">{item.label}</p>{p.campaign && <aside class="campaign-note"><strong>{p.campaign.label}</strong><p>戸建限定・6カ月内開通・8カ月継続・口座登録</p><details><summary>還元条件の詳細</summary><p>{p.campaign.detail}</p><a href={p.campaign.url} target="_blank" rel="noopener">還元条件の出典 ↗</a></details></aside>}<AffiliateButton provider={p} building="house" /><a class="detail-link" href={`/hikari/${p.id}/`}>料金・エリア・注意点を見る →</a></article>)}</div>
      <div class="need-links"><a href="/hikari/#compare">格安SIM・月額で比べたい →</a><a href="/hikari/mansion/">マンションで使いたい →</a><a href="/hikari/home-router/">工事なしで使いたい →</a><a href="/guides/hikari-one-year/">1年だけ使いたい →</a></div>
      <p class="source-note">料金は税込。BBIQは電気・3年自動更新の割引条件を含みます。SoftBank 光は2026年12月以降、契約によって料金改定の適用月が異なります。各社ページに確認日と公式出典を掲載しています。</p>
    </section>

    <section id="learning" class="home-learning"><div class="site-container home-section"><VisualHero heading="h2" compact title={"英語学習は、\n目的から選ぶ。"} lead="TOEIC対策か、日常会話の基礎か。自習と講師レッスンの違いを見て、自分に合うコースへ。" image="learning" eyebrow="学び・スキル"><a href="/guides/study-sapuri-toeic-vs-eikaiwa/" class="learning-visual-link">コースの違いを比較する →</a></VisualHero>
      <div class="learning-picks">{offers.map((offer,index)=><article><p class="pick-audience">{index===0?'TOEIC L&R TESTの受験が目的':'旅行・日常のフレーズを学びたい'}</p><h3>{index===0?'TOEIC L&R TEST対策コース':'新日常英会話コース'}</h3><p class="learning-service">スタディサプリENGLISH / ベーシック</p><p class="pick-price"><span>Web月額</span><strong>{index===0?'3,278円':'2,178円'}</strong></p><ul>{(index===0?['試験形式の問題演習と解説で学ぶ','受験日から学習計画を立てたい人に']:['ストーリー形式で日常表現を学ぶ','講師との会話レッスンは含まれません']).map(point=><li>{point}</li>)}</ul><AffiliateButton provider={offer} /><a class="detail-link" href="/guides/study-sapuri-toeic-vs-eikaiwa/">料金・プランの比較を読む →</a></article>)}</div>
      <p class="source-note">税込・2026年11月22日確認。月額払いの通常料金です。複数月パックやアプリ内決済は条件が異なります。無料体験の対象と課金開始日は、申込画面で確認してください。<a href="https://eigosapuri.jp/plan/" target="_blank" rel="noopener">出典：リクルート公式料金</a></p><a class="learning-checklist" href="/guides/online-english-trial-checklist/">無料体験の前に：課金日・予約回数・やめ方のチェックリスト →</a>
    </div></section>

    <section class="site-container home-section" aria-labelledby="guides-title"><div class="section-heading"><div><p class="eyebrow">比較・選び方ガイド</p><h2 id="guides-title">迷っている内容から読む</h2></div><a href="/guides/" class="all-link">全{guides.length}本を見る →</a></div><div class="guide-grid">{guides.map(guide=><article><a href={`/guides/${guide.slug}/`}><GuideArtwork slug={guide.slug} /><span class="guide-category">{categoryLabel[guide.category]}</span><h3>{guide.title}</h3><p>{guide.description}</p><span class="guide-bottom"><time datetime={guide.updatedAt}>{jpDate(guide.updatedAt)}</time><b>比較を見る →</b></span></a></article>)}</div></section>
    <aside class="site-container editorial-note"><h2>料金だけでなく、使う条件まで比較します</h2><p>公式情報をもとに、対象プラン・契約期間・追加費用・向かないケースを整理しています。自分の条件に合った候補が見つかったら、申込先の最新情報を確認してお進みください。</p><a href="/about/">編集方針・情報の調べ方 →</a></aside>
  </div>
</Base>
<style>
.home-diagnosis-entry{margin-top:18px;max-width:420px}.home-diagnosis-button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;min-height:66px;padding:13px 18px;border:1px solid #9b4627;border-radius:7px;background:#ae512e;box-shadow:0 3px 0 #843a20;color:#fff;text-align:center;text-decoration:none}.home-diagnosis-button:hover{background:#914023}.home-diagnosis-button:focus-visible{outline:3px solid #175d50;outline-offset:5px}.home-diagnosis-button strong{font-size:19px;line-height:1.6;font-weight:800}.home-diagnosis-button span{font-size:13px;line-height:1.6;color:#fff4e9}.home-diagnosis-area{display:inline-block;min-height:44px;padding:11px 0 5px;color:#175d50;font-size:13px;line-height:1.8;text-decoration:underline;text-underline-offset:4px}.home-intro .topic-shortcut{padding:7px 12px;background:transparent;border-color:#d5d9ce}.home-intro .topic-shortcut strong{font-size:13px;font-weight:700}@media(max-width:700px){.home-diagnosis-entry{margin-top:16px;max-width:none}.home-diagnosis-button{min-height:65px;padding:11px 10px}.home-diagnosis-button strong{font-size:18px}.home-diagnosis-button span{font-size:12px}.home-diagnosis-area{font-size:13px}.home-intro nav{margin-top:8px!important}.home-intro .topic-shortcut{padding:8px 5px}.home-intro .topic-shortcut strong{font-size:12px}}
.national-entry{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:20px;border:1px solid #c9dcd0;border-radius:7px;background:#f0f6f2;padding:18px 20px}.national-entry p{font-size:13px;font-weight:700;color:#175d50}.national-entry h2{font-size:20px;font-weight:700;line-height:1.7;margin-top:4px}.national-entry>a{display:flex;align-items:center;justify-content:center;flex-shrink:0;min-height:46px;border:1px solid #175d50;border-radius:5px;background:#fff;padding:10px 14px;color:#175d50;font-size:14px;font-weight:700;text-align:center;line-height:1.7}.national-entry>a:hover{background:#e5efe8}@media(max-width:800px){.national-entry{align-items:stretch;flex-direction:column;gap:12px;padding:17px}.national-entry h2{font-size:18px}.national-entry>a{width:100%;font-size:14px}}

  .home-comparison{background:#fff;color:#24392e;font-size:16px;line-height:1.85;padding-bottom:26px}.home-intro{padding-block:20px 18px;border-bottom:1px solid #dce5de}.eyebrow{color:#175d50;font-size:14px;font-weight:700;margin-bottom:8px}.home-intro h1{font-family:var(--font-sans);font-size:clamp(28px,4vw,43px);font-weight:800;line-height:1.5;margin:0}.home-intro h1 span{color:#175d50}.mobile-break{display:none}.home-intro>p:last-of-type{font-size:16px;color:#57675d;margin-top:12px;line-height:1.9}.home-intro nav{display:flex;flex-wrap:wrap;gap:10px;margin-top:13px;max-width:870px}.topic-shortcut{display:flex;gap:10px;align-items:center;padding:8px 14px;background:#f0f6f1;border:1px solid #d5e2d8;border-radius:7px}.topic-shortcut>span:first-child{display:none}.topic-shortcut strong{font-size:15px}.topic-shortcut>span:last-child{font-size:13px;color:#5c7061}.topic-shortcut:last-child{background:#fff8ef;border-color:#eadfce}.topic-shortcut:last-child>span:first-child{color:#bc6a3a}.home-section{padding-block:23px 0}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:20px}.section-heading h2{font-family:var(--font-sans);font-size:clamp(22px,2.6vw,28px);font-weight:800;line-height:1.5}.section-heading .eyebrow{margin-bottom:5px}.all-link{flex-shrink:0;font-size:14px;font-weight:700;color:#175d50;text-decoration:underline;text-underline-offset:4px}.section-lead{font-size:15px;line-height:1.9;color:#58685e;margin-top:10px}.home-picks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:start;gap:16px;margin-top:13px}.home-picks>article,.learning-picks>article{display:flex;flex-direction:column;border:1px solid #cddcd2;border-top:4px solid #175d50;border-radius:7px;background:#fff;padding:20px}.pick-audience{align-self:flex-start;padding:3px 8px;background:#edf4ef;color:#175d50;font-size:13px;font-weight:700;border-radius:4px}.home-picks h3,.learning-picks h3{font-size:23px;font-weight:800;line-height:1.6;margin-top:8px}.pick-reason{font-size:15px;color:#4e6356;line-height:1.8;margin-top:3px}.pick-price{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;margin-top:11px}.pick-price>span{font-size:13px;color:#5d7062}.pick-price strong{font-size:27px;line-height:1.5;color:#175d50}.campaign-note{border:1px solid #ecd8be;background:#fff7e9;border-radius:5px;padding:9px 10px;margin-bottom:12px;color:#8c4a25}.campaign-note>strong{display:block;font-size:16px;line-height:1.6}.campaign-note>p{font-size:13px;line-height:1.8;margin-top:5px}.campaign-note>a{font-size:13px;text-decoration:underline;text-underline-offset:3px}.pick-condition{font-size:13px;line-height:1.8;color:#5b6d60;margin:4px 0 16px}.home-picks :global(.affiliate-block),.learning-picks :global(.affiliate-block){margin-top:0}.home-picks :global(a[data-affiliate-link]),.learning-picks :global(a[data-affiliate-link]){font-size:14px;line-height:1.65;padding:12px 8px}.home-picks :global(.text-\[11px\]),.learning-picks :global(.text-\[11px\]){font-size:13px;line-height:1.6}.detail-link{display:block;font-size:13px;font-weight:700;text-align:center;color:#175d50;text-decoration:underline;text-underline-offset:3px;margin-top:10px}.need-links{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-top:14px}.need-links a{display:flex;min-height:48px;align-items:center;justify-content:center;border:1px solid #d5dfd8;border-radius:5px;background:#f6f9f5;padding:10px;font-size:14px;font-weight:700;color:#175d50}.source-note{font-size:13px;line-height:1.9;color:#607164;margin-top:12px}.source-note a{color:#175d50;text-decoration:underline;text-underline-offset:3px;margin-left:4px}.home-learning{background:#f4f7f2;border-block:1px solid #dce5de;margin-top:32px;padding-bottom:28px}.learning-picks{display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:18px;margin-top:18px}.learning-picks>article{border-top-color:#ab602f}.learning-picks .pick-audience{background:#fff3e2;color:#8b4c24}.learning-service{font-size:13px;color:#647166;margin-top:3px}.learning-picks ul{padding-left:20px;list-style:disc;margin:12px 0 18px;font-size:15px;line-height:1.85;color:#4e6455}.learning-checklist{display:block;margin-top:14px;padding:14px 18px;border:1px solid #d2dfd4;border-radius:5px;background:#fff;font-size:15px;font-weight:700;color:#175d50}.guide-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px;margin-top:19px}.guide-grid article{border:1px solid #d6e1d8;border-radius:6px;background:#fff}.guide-grid article>a{display:flex;flex-direction:column;height:100%;padding:20px}.guide-category{font-size:13px;color:#a35a32;font-weight:700}.guide-grid h3{font-size:18px;font-weight:700;line-height:1.75;margin-top:7px}.guide-grid p{font-size:14px;line-height:1.9;color:#607064;margin:10px 0 18px}.guide-bottom{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:auto;font-size:13px;color:#637467}.guide-bottom b{color:#175d50;white-space:nowrap}.editorial-note{padding:22px 24px;border:1px solid #d5e1d8;border-radius:6px;background:#f5f8f3;margin-top:32px}.editorial-note h2{font-family:var(--font-sans);font-size:19px;font-weight:700;line-height:1.7}.editorial-note p{font-size:14px;color:#5c6f60;line-height:1.9;margin-top:8px}.editorial-note>a{display:inline-block;margin-top:10px;font-size:14px;font-weight:700;color:#175d50;text-decoration:underline;text-underline-offset:3px}@media(max-width:950px){.section-heading{display:block}.all-link{display:inline-block;margin-top:10px}.home-picks{gap:12px}.home-picks>article{padding:16px}.home-picks h3{font-size:21px}.pick-reason{font-size:14px}.need-links{grid-template-columns:1fr 1fr}.guide-grid{grid-template-columns:1fr 1fr}}@media(max-width:700px){.home-intro{padding-block:20px}.home-intro h1{font-size:29px;line-height:1.5}.mobile-break{display:block}.desktop-break{display:none}.home-intro>p:last-of-type{font-size:15px;margin-top:10px}.home-intro nav{grid-template-columns:1fr;gap:9px;margin-top:17px}.topic-shortcut{padding:11px 15px}.topic-shortcut strong{font-size:17px}.topic-shortcut>span:last-child{font-size:13px}.home-section{padding-top:25px}.section-heading h2{font-size:23px;line-height:1.6}.section-lead{font-size:15px}.home-picks,.learning-picks{grid-template-columns:1fr;gap:14px}.home-picks>article,.learning-picks>article{padding:18px}.home-picks h3,.learning-picks h3{font-size:23px}.pick-reason{font-size:15px}.pick-price strong{font-size:28px}.home-picks :global(a[data-affiliate-link]),.learning-picks :global(a[data-affiliate-link]){font-size:15px}.need-links{gap:8px}.need-links a{font-size:13px;padding:9px}.home-learning{margin-top:25px;padding-bottom:24px}.guide-grid{grid-template-columns:1fr;gap:13px}.guide-grid article>a{padding:18px}.guide-grid h3{font-size:18px}.guide-bottom{font-size:13px}.editorial-note{padding:18px;margin-top:25px}.editorial-note h2{font-size:18px}}
.campaign-note details{margin-top:4px;font-size:13px;line-height:1.7}.campaign-note summary{cursor:pointer;font-weight:700;text-decoration:underline;text-underline-offset:3px}.campaign-note details p{margin-top:7px;font-size:13px;line-height:1.8}.campaign-note details a{font-size:13px;text-decoration:underline;text-underline-offset:3px}
@media(max-width:700px){.home-intro nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.topic-shortcut{justify-content:center;padding:10px 6px;min-width:0;min-height:44px}.topic-shortcut strong{font-size:13px}}
.guide-grid article>a{padding:0 0 20px;overflow:hidden}.guide-grid article>a>span,.guide-grid article>a>h3,.guide-grid article>a>p{margin-left:20px;margin-right:20px}.guide-grid article>a>.guide-category{margin-top:16px}.guide-grid :global(.guide-artwork){margin:0}.home-intro{border:0;padding-bottom:5px}.home-learning :global(.visual-hero){margin-bottom:16px}.learning-visual-link{display:inline-flex;align-items:center;gap:8px;background:#175d50;color:white;font-size:14px;font-weight:700;border-radius:5px;padding:10px 14px;margin-top:12px}
</style>
