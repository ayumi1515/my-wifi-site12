<script>
  // ② 追従バー：主役ボタンを通りすぎたあと、Q1・診断の箱・フッターのどれも見えていないときだけ出す
  (() => {
    const bar = document.querySelector<HTMLElement>('[data-sticky-diag]');
    const hero = document.querySelector<HTMLElement>('[data-diag-watch="hero"]');
    if (!bar || !hero || !('IntersectionObserver' in window)) return;
    // 申込み条件を見ているカード（回線比較・英語学習）の間は、外の申込み窓口へのボタンと競合しないように消す
    const watched = [...document.querySelectorAll<HTMLElement>('[data-diag-watch], .net-card, .learning-grid > article'), ...document.querySelectorAll<HTMLElement>('.site-footer')];
    // 見えているかは、そのつど位置で確かめる（大きく飛んだときに知らせが遅れても、まちがえないように）
    const inView = (el: Element) => { const r = el.getBoundingClientRect(); return r.bottom > 0 && r.top < window.innerHeight; };
    let shown = false;
    const update = () => {
      const show = hero.getBoundingClientRect().bottom < 0 && !watched.some(inView);
      if (show === shown) return;
      shown = show;
      bar.classList.toggle('is-shown', show);
      bar.toggleAttribute('inert', !show);
      bar.setAttribute('aria-hidden', show ? 'false' : 'true');
    };
    const io = new IntersectionObserver(update);
    watched.forEach((el) => io.observe(el));
    let ticking = false;
    window.addEventListener('scroll', () => { if (ticking) return; ticking = true; requestAnimationFrame(() => { ticking = false; update(); }); }, { passive: true });
  })();
  // タブ（キーボードの左右でも動く）。JavaScriptが動かないときは、最初のパネルだけが見える
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (t: HTMLButtonElement) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(x.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k !== 'ArrowRight' && k !== 'ArrowLeft') return;
        const n = tabs[(i + (k === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(n); n.focus();
      });
    });
  });
</script>

