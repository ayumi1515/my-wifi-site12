---
import Base from '../layouts/Base.astro';
import { providers, jpDate } from '../lib/data';
import { guides, categoryLabel } from '../lib/guides';
import { SITE } from '../site.config.mjs';

const featuredGuides = guides.slice(0, 6);
const internetCount = guides.filter((guide) => guide.category === 'internet').length;
const learningCount = guides.filter((guide) => guide.category === 'learning').length;
const title = 'しらべまとめ帳｜通信・学びの料金と条件を比較';
const description = '買う前、申し込む前の疑問を、公式情報から調べてまとめる比較ガイド。通信サービスや学びの料金・条件・向き不向きを整理して、納得できる選び方をお手伝いします。';
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: SITE.url + '/',
  description,
  inLanguage: 'ja',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: featuredGuides.map((guide, index) => ({
      '@type': 'ListItem', position: index + 1,
      name: guide.title, url: SITE.url + '/guides/' + guide.slug + '/',
    })),
  },
};
---
<Base title={title} description={description} jsonLd={[collectionLd]}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="site-container home-hero-grid">
      <div class="hero-copy">
        <p class="section-kicker">A NOTE FOR BETTER CHOICES</p>
        <h1 id="home-title">買う前に、<br />しらべて<span class="hero-circle-word">納得。</span></h1>
        <p class="hero-lead">料金の違いも、申し込む前の注意点も。<br class="hero-desktop-break" />迷いやすい商品・サービスを、公式情報からほどきます。</p>
        <div class="hero-actions">
          <a href="/hikari/" class="button-primary">通信費から見直す<span aria-hidden="true">↗</span></a>
          <a href="/guides/" class="hero-secondary-link">選び方ガイドを読む<span aria-hidden="true">→</span></a>
        </div>
        <ul class="hero-facts" aria-label="掲載内容と調べ方">
          <li><span class="fact-number">{providers.length}</span><span>通信サービスを比較</span></li>
          {guides.length > 0 && <li><span class="fact-number">{guides.length}</span><span>選び方・比較ガイド</span></li>}
          <li class="fact-editorial"><span aria-hidden="true">✓</span><span>公式情報・出典を掲載</span></li>
        </ul>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="visual-caption"><span></span>あなたの「選ぶ」に、ひとつのメモを。</div>
        <svg viewBox="0 0 560 450" xmlns="http://www.w3.org/2000/svg" class="hero-notebook">
          <defs><pattern id="notebook-dots" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#cbd7be"/></pattern></defs>
          <circle cx="290" cy="232" r="191" fill="#e8eddd"/>
          <rect x="99" y="43" width="376" height="360" fill="url(#notebook-dots)"/>
          <g transform="translate(140 55) rotate(-7 155 166)">
            <rect x="9" y="13" width="302" height="332" rx="9" fill="#c4cfb6" opacity=".42"/>
            <rect width="302" height="332" rx="9" fill="#fffefa" stroke="#d1dcc4"/>
            <path d="M31 0v332" stroke="#c7d7bf"/>
            <path d="M17 33h28M17 62h28M17 91h28M17 120h28M17 149h28M17 178h28M17 207h28M17 236h28M17 265h28M17 294h28" stroke="#63855b" stroke-width="3" stroke-linecap="round"/>
            <path d="M244 0h24v75l-12-9-12 9Z" fill="#dfa05e"/>
            <text x="62" y="48" fill="#72856b" font-size="10" letter-spacing="2" font-family="Arial,sans-serif">MY CHOICE NOTE</text>
            <text x="61" y="88" fill="#31563a" font-size="22" font-weight="700" font-family="Hiragino Mincho ProN,Yu Mincho,serif">選ぶ前の、確認メモ。</text>
            <path d="M61 108h206" stroke="#e3e8db"/>
            <g transform="translate(63 135)"><rect width="15" height="15" rx="2" fill="#edf2e5" stroke="#9bb18c"/><path d="m3 7 3 3 7-8" fill="none" stroke="#3f6a43" stroke-width="1.7" stroke-linecap="round"/><text x="29" y="12" font-size="13" fill="#63735b" font-family="Hiragino Sans,Meiryo,sans-serif">料金と必要な費用</text></g>
            <g transform="translate(63 178)"><rect width="15" height="15" rx="2" fill="#edf2e5" stroke="#9bb18c"/><path d="m3 7 3 3 7-8" fill="none" stroke="#3f6a43" stroke-width="1.7" stroke-linecap="round"/><text x="29" y="12" font-size="13" fill="#63735b" font-family="Hiragino Sans,Meiryo,sans-serif">自分に向いている？</text></g>
            <g transform="translate(63 221)"><rect width="15" height="15" rx="2" fill="#edf2e5" stroke="#9bb18c"/><path d="m3 7 3 3 7-8" fill="none" stroke="#3f6a43" stroke-width="1.7" stroke-linecap="round"/><text x="29" y="12" font-size="13" fill="#63735b" font-family="Hiragino Sans,Meiryo,sans-serif">申し込む前の注意点</text></g>
            <path d="M63 281h203" stroke="#dbe3d1"/><text x="63" y="308" fill="#8b997d" font-size="9" letter-spacing="2" font-family="Arial,sans-serif">CHECK THE FACTS. FIND YOUR FIT.</text>
          </g>
          <g transform="translate(385 249) rotate(18)"><rect x="-9" y="33" width="16" height="100" rx="7" fill="#a97140"/><rect x="-6" y="37" width="4" height="83" rx="2" fill="#d5a576"/><circle cy="-8" r="63" fill="#e5eee0" fill-opacity=".88" stroke="#255c44" stroke-width="9"/><circle cy="-8" r="52" fill="none" stroke="#aac4a2" stroke-width="1"/><path d="m-24-8 15 15 29-34" fill="none" stroke="#2b6647" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/></g>
          <g transform="translate(65 340) rotate(-5)"><rect width="163" height="57" rx="7" fill="#fffefa" stroke="#d4dfc9"/><circle cx="24" cy="28" r="12" fill="#f4ead6"/><path d="m19 28 3 3 7-8" fill="none" stroke="#b78546" stroke-width="2" stroke-linecap="round"/><text x="47" y="25" fill="#4d6847" font-size="11" font-weight="700" font-family="Hiragino Sans,Meiryo,sans-serif">公式情報から</text><text x="47" y="41" fill="#7d8d70" font-size="9" font-family="Hiragino Sans,Meiryo,sans-serif">条件まで、しらべます。</text></g>
          <path d="M84 125c-28 4-44 23-38 44M468 98l11-14M492 123l18-3M482 147l14 8" fill="none" stroke="#c49461" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span class="visual-side-note">SHIRABE MATOME / EDITORIAL NOTE</span>
      </div>
    </div>
  </section>

  <section class="site-container home-topics" aria-labelledby="topics-title">
    <div class="section-heading-row">
      <div><p class="section-kicker">START WITH A TOPIC</p><h2 id="topics-title" class="section-title">気になるテーマから、しらべる。</h2></div>
      <p class="section-intro">比べるポイントがわかれば、<br />自分に合う選択肢が見えてきます。</p>
    </div>
    <div class="topic-grid">
      <a class="topic-card topic-internet" href="/hikari/">
        <div class="topic-icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M7 30h34v11H7zM15 30V17m18 13V17M18 11a10 10 0 0 1 12 0M22 16a4 4 0 0 1 4 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="33" cy="35.5" r="1" fill="currentColor"/><circle cx="37" cy="35.5" r="1" fill="currentColor"/></svg></div>
        <div><p class="topic-english">INTERNET &amp; COMMUNICATION</p><h3>通信・ネット</h3><p class="topic-description">光回線、ホームルーター。<br />月額だけでなく、工事費やセット割も比較。</p><p class="topic-count">{providers.length}サービスを比較{internetCount > 0 && <span>・{internetCount}本の選び方ガイド</span>}</p></div>
        <span class="topic-arrow" aria-hidden="true">↗</span>
      </a>
      {learningCount > 0 && <a class="topic-card topic-learning" href="/guides/?category=learning">
        <div class="topic-icon" aria-hidden="true"><svg viewBox="0 0 48 48" fill="none"><path d="M24 13c-7-5-13-5-19-3v26c6-2 12-2 19 3 7-5 13-5 19-3V10c-6-2-12-2-19 3Zm0 0v26M11 17c3 0 5 1 7 2m-7 6c3 0 5 1 7 2m12-8c2-1 4-2 7-2m-7 10c2-1 4-2 7-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <div><p class="topic-english">LEARNING &amp; SKILLS</p><h3>学び・スキル</h3><p class="topic-description">通信講座、学び直し。<br />受講料と学習サポートを、目的に合わせて。</p><p class="topic-count">{learningCount}本の選び方ガイド</p></div>
        <span class="topic-arrow" aria-hidden="true">↗</span>
      </a>}
    </div>
  </section>

  {featuredGuides.length > 0 && <section class="site-container home-guides" aria-labelledby="guides-title">
    <div class="section-heading-row">
      <div><p class="section-kicker">THE COMPARISON NOTES</p><h2 id="guides-title" class="section-title">迷いやすい違いを、ひとつずつ。</h2></div>
      <a href="/guides/" class="section-all-link">すべてのガイドを見る<span aria-hidden="true">→</span></a>
    </div>
    <div class="guide-grid">
      {featuredGuides.map((guide, index) => <article class="home-guide-card">
        <a href={`/guides/${guide.slug}/`} class="guide-card-link">
          <div class:list={['guide-card-art', guide.category === 'learning' ? 'art-learning' : 'art-internet']} aria-hidden="true">
            <span class="art-note-label">SHIRABE MATOME NOTE</span><span class="art-note-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="art-paper"><span></span><span></span><span></span><i>✓</i></div>
            <span class="art-topic-name">{categoryLabel[guide.category]}</span>
          </div>
          <div class="guide-card-content">
            <p class="guide-card-category">{categoryLabel[guide.category]}</p>
            <h3>{guide.title}</h3>
            <p class="guide-card-description">{guide.description}</p>
            <div class="guide-card-bottom"><span>更新：{jpDate(guide.updatedAt)}</span><span class="guide-card-read">続きを読む<span aria-hidden="true">↗</span></span></div>
          </div>
        </a>
      </article>)}
    </div>
  </section>}

  <section class="home-editorial" aria-labelledby="editorial-title">
    <div class="site-container editorial-grid">
      <div><p class="section-kicker">HOW WE MAKE OUR NOTES</p><h2 id="editorial-title" class="section-title">価格だけで決めない。<br />あとから困らないために。</h2><a href="/about/" class="editorial-about-link">編集方針と調べ方を読む<span aria-hidden="true">→</span></a></div>
      <div class="editorial-points">
        <div><span>01</span><div><h3>公式の情報を、確認日とともに。</h3><p>料金・条件には、確認した日と出典を記載。申し込む前に確かめたいポイントも整理します。</p></div></div>
        <div><span>02</span><div><h3>向く人も、向かない人も。</h3><p>よいところだけでなく、費用や契約条件などの注意点も、同じページで確認できます。</p></div></div>
        <div><span>03</span><div><h3>広告であることを、わかる形で。</h3><p>広告リンクを明示し、比較の基準とあわせて説明します。<a href="/ad-policy/">広告について</a></p></div></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .home-hero { padding-block: 49px 53px; border-bottom: 1px solid #dce3d5; }
  .home-hero-grid { display: grid; grid-template-columns: 1.08fr .92fr; align-items: center; gap: 27px; }
  .hero-copy { padding-block: 10px 0; }
  .hero-copy h1 { margin: 21px 0 0; color: #173e30; font-size: clamp(2.5rem, 5.3vw, 4.1rem); font-weight: 700; line-height: 1.65; letter-spacing: .025em; }
  .hero-circle-word { position: relative; isolation: isolate; display: inline-block; }
  .hero-circle-word::after { position: absolute; z-index: -1; right: 7px; bottom: 13px; left: 0; height: 15px; border-radius: 3px; background: #e3c18c77; content: ""; transform: rotate(-2deg); }
  .hero-lead { margin-top: 23px; color: #64705c; font-size: 13px; line-height: 2.15; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 27px; margin-top: 30px; }
  .hero-secondary-link { display: inline-flex; align-items: center; gap: 17px; color: #3c5d3f; font-size: 12px; font-weight: 700; text-decoration: none; }
  .hero-secondary-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .hero-facts { display: flex; flex-wrap: wrap; gap: 22px; margin: 32px 0 0; border-top: 1px solid #dce3d5; padding: 23px 0 0; list-style: none; }
  .hero-facts li { display: flex; align-items: center; gap: 8px; color: #6d795f; font-size: 9px; line-height: 1.7; }
  .hero-facts li + li { border-left: 1px solid #d8e0cf; padding-left: 22px; }
  .fact-number { color: #365a38; font-family: Georgia,serif; font-size: 22px; font-weight: 400; line-height: 1; }
  .fact-editorial > span:first-child { display: inline-flex; width: 21px; height: 21px; align-items: center; justify-content: center; border: 1px solid #a4bb97; border-radius: 50%; color: #5f7e4d; font-size: 10px; }
  .hero-visual { position: relative; min-width: 0; }
  .visual-caption { display: flex; align-items: center; justify-content: center; gap: 8px; color: #8c987a; font-size: 9px; letter-spacing: .07em; }
  .visual-caption > span { width: 5px; height: 5px; border-radius: 50%; background: #c89459; }
  .hero-notebook { display: block; width: 100%; margin-top: 10px; }
  .visual-side-note { display: block; color: #8b987e; font-family: Arial,sans-serif; font-size: 8px; letter-spacing: .17em; text-align: center; }
  .home-topics { padding-top: 57px; }
  .section-heading-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 35px; margin-bottom: 27px; }
  .section-intro { color: #718066; font-size: 11px; line-height: 1.95; }
  .section-title { font-size: clamp(1.45rem, 2.8vw, 2rem); }
  .topic-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 22px; }
  .topic-card { position: relative; display: flex; gap: 23px; min-width: 0; align-items: flex-start; border: 1px solid #d8e1ce; border-radius: 9px; padding: 31px 32px; color: #34543a; text-decoration: none; transition: border-color .18s, transform .18s; }
  .topic-card:hover { border-color: #88a57a; transform: translateY(-2px); }
  .topic-internet { background: #eef3e7; }
  .topic-learning { background: #f5f0e4; border-color: #e1d9c5; color: #715a37; }
  .topic-icon { flex-shrink: 0; width: 47px; height: 47px; margin-top: 4px; }
  .topic-english { font-size: 8px; font-weight: 700; line-height: 1.7; letter-spacing: .15em; opacity: .67; }
  .topic-card h3 { margin-top: 9px; font-family: var(--serif); font-size: 24px; font-weight: 700; line-height: 1.5; letter-spacing: .035em; }
  .topic-description { margin-top: 13px; font-size: 11px; line-height: 1.95; opacity: .85; }
  .topic-count { margin-top: 18px; font-size: 9px; line-height: 1.7; opacity: .7; }
  .topic-arrow { position: absolute; top: 29px; right: 28px; font-family: Arial,sans-serif; font-size: 20px; opacity: .55; }
  .home-guides { padding-top: 71px; }
  .section-all-link { display: inline-flex; align-items: center; gap: 17px; flex-shrink: 0; padding-bottom: 8px; color: #4c6846; font-size: 11px; font-weight: 700; text-decoration: none; }
  .section-all-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .guide-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 26px 22px; }
  .home-guide-card { min-width: 0; border: 1px solid #dde3d6; border-radius: 9px; overflow: hidden; background: #fffefa; transition: transform .18s,border-color .18s; }
  .home-guide-card:hover { border-color: #abc39c; transform: translateY(-3px); }
  .guide-card-link { display: flex; height: 100%; flex-direction: column; color: inherit; text-decoration: none; }
  .guide-card-art { position: relative; height: 146px; overflow: hidden; background: #e4ecdc; }
  .art-learning { background: #eee4d4; }
  .art-note-label { position: absolute; top: 19px; left: 21px; color: #718568; font-family: Arial,sans-serif; font-size: 7px; letter-spacing: .16em; }
  .art-note-number { position: absolute; top: 26px; right: 22px; color: #b3c3a6; font-family: Georgia,serif; font-size: 51px; font-style: italic; line-height: 1; }
  .art-learning .art-note-number { color: #c5b694; }
  .art-paper { position: absolute; right: 76px; bottom: -15px; width: 126px; height: 111px; border: 1px solid #bdcbb0; border-radius: 4px; background: #fffdf3; box-shadow: 5px 5px 0 #d2dcc7; transform: rotate(-12deg); }
  .art-learning .art-paper { border-color: #c8bba1; box-shadow: 5px 5px 0 #e1d4be; transform: rotate(9deg); }
  .art-paper > span { display: block; width: 63px; height: 1px; margin: 14px 0 0 20px; background: #d7dfcb; }
  .art-paper > span:first-child { width: 76px; margin-top: 22px; }
  .art-paper > i { position: absolute; right: 13px; bottom: 13px; display: flex; width: 29px; height: 29px; align-items: center; justify-content: center; border: 1px solid #a7bc94; border-radius: 50%; color: #75985c; font-size: 14px; font-style: normal; }
  .art-topic-name { position: absolute; bottom: 19px; left: 21px; color: #58734c; font-family: var(--serif); font-size: 15px; font-weight: 700; letter-spacing: .04em; }
  .art-learning .art-topic-name { color: #8b754d; }
  .guide-card-content { display: flex; height: 100%; flex-direction: column; padding: 21px 22px 20px; }
  .guide-card-category { color: #839074; font-size: 9px; font-weight: 700; letter-spacing: .03em; }
  .guide-card-content h3 { margin-top: 10px; color: #294830; font-size: 15px; font-weight: 700; line-height: 1.85; }
  .guide-card-description { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 3; -webkit-box-orient: vertical; margin-top: 13px; color: #77816b; font-size: 10px; line-height: 1.95; }
  .guide-card-bottom { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-top: auto; padding-top: 23px; color: #8a947d; font-size: 8px; line-height: 1.8; }
  .guide-card-read { display: inline-flex; align-items: center; flex-shrink: 0; gap: 9px; color: #537145; font-size: 9px; font-weight: 700; }
  .home-editorial { margin-top: 79px; border-top: 1px solid #dce3d5; border-bottom: 1px solid #dce3d5; background: #eff2e8; }
  .editorial-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 88px; padding-block: 47px; }
  .editorial-about-link { display: inline-flex; align-items: center; gap: 20px; margin-top: 26px; color: #537049; font-size: 11px; font-weight: 700; text-decoration: underline; text-underline-offset: 5px; }
  .editorial-points > div { display: flex; gap: 19px; padding-block: 16px; border-bottom: 1px solid #d9e1ce; }
  .editorial-points > div:first-child { padding-top: 0; }
  .editorial-points > div:last-child { border-bottom: 0; padding-bottom: 0; }
  .editorial-points > div > span { padding-top: 1px; color: #9b8056; font-family: Georgia,serif; font-size: 17px; font-style: italic; }
  .editorial-points h3 { color: #3c5c37; font-size: 13px; font-weight: 700; line-height: 1.8; }
  .editorial-points p { margin-top: 6px; color: #7b886f; font-size: 10px; line-height: 1.95; }
  .editorial-points p a { text-decoration: underline; text-underline-offset: 3px; }
