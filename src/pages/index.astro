---
// トップページ（2026-11-27 リデザイン）。
// 方針：①通信・ネットを主役にして、ほかのジャンルは背景色で分ける ②公式ナビゲーター（ママ・ミナ）で案内をそろえる
// ③スマホ会社のタブ・エリアのタブ・診断の1問目で「触れる」 ④主役のボタンは「30秒で診断」1つだけ ⑤色は3色（白〜薄いグレー／深い緑／オレンジ）。
// 金額は公式で確認したデータ（household-homes.json・household-plans.json）だけを使い、見本の数字は出さない。
import Base from '../layouts/Base.astro';
import MangaShelf from '../components/MangaShelf.astro';
import NaviTalk from '../components/NaviTalk.astro';
import GuideArtwork from '../components/GuideArtwork.astro';
import MangaThumbnail from '../components/MangaThumbnail.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import { providers, jpDate } from '../lib/data';
import { guides, categoryLabel, type GuideCategory } from '../lib/guides';
import mobileServices from '../data/mobile-services.json';
import { mobileMangaGuides } from '../lib/manga-mobile';
import type { ConnectivityMangaSheet } from '../lib/connectivity-manga';
import { offers } from '../lib/offers';
import { brands, brandInfo, homes } from '../lib/setwari';
import homeData from '../data/household-homes.json';
import { prefectures, getPrefecturePath } from '../lib/national-areas';
import { SITE } from '../site.config.mjs';

const title = 'しらべまとめ帳｜スマホとネットのセット割・光回線を公式情報で比較';
const description = '今のスマホの会社から、セット割が使える光回線・ホームルーターを比較。30秒・登録不要の診断、47都道府県の提供エリア確認、漫画でわかる選び方。料金・還元条件・解約金まで公式情報で確認日つきで載せています。';
const heroImage = '/images/manga-lp/kojin/hero.webp'; // 公式ナビゲーターの専用の絵ができたら /images/navi/top-hero.webp に差し替える
const yen = (n: number) => `${n.toLocaleString('ja-JP')}円`;
const checked = homeData.checkedAt.replace(/-/g, '/');
// Q1のボタンの左はしの色の点（会社を思わせる色だけ。ロゴは使わない）
const brandDot: Record<string, string> = { docomo: '#b5121b', au: '#eb5505', softbank: '#9aa3ab', ymobile: '#e60012', 'uq-mobile': '#1d5fbf', 'rakuten-mobile': '#bf0d6a', ahamo: '#a7b800', linemo: '#2fae4a', povo: '#e0a800', other: '#94a3b8' };

// ③ スマホ会社のタブ：そのスマホとセット割がある回線だけを出す（データはセット割診断と同じ）
const prefName = (code: string) => prefectures.find((p) => p.code === code)?.name ?? code;
const tabDefs = [
  { key: 'docomo', label: 'ドコモ', brandIds: ['docomo'], note: 'ahamoはセット割の対象外です。' },
  { key: 'au', label: 'au・UQ', brandIds: ['au', 'uq-mobile'], note: 'UQ mobileは、家族割とセット割をいっしょに使えないプランがあります。' },
  { key: 'sb', label: 'ソフトバンク・ワイモバ', brandIds: ['softbank', 'ymobile'], note: 'ワイモバイルは、家族割とセット割をいっしょに使えないプランがあります。' },
  { key: 'other', label: '格安SIM・その他', brandIds: [] as string[], note: '楽天モバイル・povo・LINEMOなどは、このサイトで比べている回線とのセット割はありません。月額で選びます。' },
];
const tabs = tabDefs.map((t) => {
  const list = homes
    .map((h) => {
      const discounts = t.brandIds
        .map((b) => ({ brand: brands.find((x) => x.id === b)!.name, d: brandInfo[b]?.homes[h.id] }))
        .filter((x) => x.d && x.d.max > 0)
        .map((x) => ({ brand: x.brand, max: x.d!.max, exclusive: x.d!.exclusive }));
      return { h, discounts };
    })
    .filter((x) => (t.brandIds.length ? x.discounts.length > 0 : true))
    .sort((a, b) => (a.h.monthly.house ?? 99999) - (b.h.monthly.house ?? 99999))
    .slice(0, t.brandIds.length ? 4 : 3);
  return { ...t, list };
});

// ① エリアのタブ：地方ごとに都道府県を並べる
const regionDefs = [
  { key: 'hokkaido', label: '北海道・東北', from: 1, to: 7 }, { key: 'kanto', label: '関東', from: 8, to: 14 },
  { key: 'chubu', label: '中部', from: 15, to: 23 }, { key: 'kinki', label: '近畿', from: 24, to: 30 },
  { key: 'chugoku', label: '中国・四国', from: 31, to: 39 }, { key: 'kyushu', label: '九州・沖縄', from: 40, to: 47 },
];
const regions = regionDefs.map((r) => ({ ...r, prefs: prefectures.filter((p) => +p.code >= r.from && +p.code <= r.to) }));

// 選び方ガイド（これまでと同じ）
interface HomeGuideCard { href: string; category: GuideCategory; title: string; description: string; updatedAt: string; artworkSlug: string; manga: { sheet: ConnectivityMangaSheet; frame: number } | null }
const homeGuideCards: HomeGuideCard[] = [
  ...guides.map((guide, index) => ({
    href: `/guides/${guide.slug}/`, category: guide.category, title: guide.title, description: guide.description, updatedAt: guide.updatedAt, artworkSlug: guide.slug,
    manga: guide.category === 'internet' ? { sheet: (guide.slug === 'hikari-one-year' || guide.slug === 'moving-internet-kagoshima' ? 'moving' : 'compare') as ConnectivityMangaSheet, frame: guide.slug === 'hikari-one-year' ? 2 : guide.slug === 'moving-internet-kagoshima' ? 0 : index % 2 === 0 ? 0 : 3 } : null,
  })),
  ...['uq-mobile', 'x-mobile'].flatMap((id, index) => {
    const service = mobileServices.find((item) => item.id === id);
    return service ? [{ href: `/mobile/${service.id}/`, category: 'internet' as GuideCategory, title: `${service.name}を漫画で比較｜料金の条件と申込み前の確認`, description: mobileMangaGuides[service.id].intro, updatedAt: service.checkedAt, artworkSlug: '', manga: { sheet: 'mobile' as ConnectivityMangaSheet, frame: index === 0 ? 1 : 4 } }] : [];
  }),
];
const internetGuides = homeGuideCards.filter((c) => c.category === 'internet').slice(0, 6);
const guideCount = guides.length + mobileServices.length + 1;
const learning = ['study-sapuri-toeic', 'study-sapuri-daily'].map((id) => offers.find((o) => o.id === id)).filter((o) => o !== undefined);
const collectionLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: SITE.url + '/', description, inLanguage: 'ja', mainEntity: { '@type': 'ItemList', itemListElement: homeGuideCards.map((card, i) => ({ '@type': 'ListItem', position: i + 1, name: card.title, url: SITE.url + card.href })) } };
---
<Base title={title} description={description} jsonLd={[collectionLd]}>
  <div class="top">
    <!-- ④ ファーストビュー：3秒でわかる見出しと、主役のボタン1つ -->
    <header class="hx">
      <div class="site-container hx-inner">
        <div class="hx-copy">
          <ul class="hx-badges" aria-label="この診断の特長">
            <li>30秒・登録不要</li><li>回答は保存しません</li><li>公式情報で確認日つき</li>
          </ul>
          <h1>家族のスマホとネット、<br /><span>まとめて見直す。</span></h1>
          <p class="hx-lead">今のスマホの会社から、セット割が使える光回線とホームルーターを比べられます。料金・還元の条件・解約金まで、かくさず載せています。</p>
          <a class="btn-main" href="/shindan/#setwari">30秒で通信費を診断する<span>タップで5問・名前や住所は不要</span></a>
          <p class="hx-sub"><a href="#area">住まいの地域で回線をさがす</a><a href="#carrier">スマホの会社で比べる</a></p>
        </div>
        <figure class="hx-visual">
          <img src={heroImage} alt="友だちのミナが、ママにスマホの画面を見せて説明している。" width="1200" height="800" fetchpriority="high" />
        </figure>
      </div>
    </header>

    <!-- ③ 診断の1問目をここに。タップすると診断の2問目から始まる -->
    <section class="quick site-container" aria-labelledby="quick-title">
      <div class="quick-card">
        <NaviTalk who="mama" text="わたしのスマホでも、セット割って使えるの？" />
        <h2 id="quick-title"><span>Q1</span>今お使いのスマホの会社は？</h2>
        <div class="quick-options">
          {brands.map((b) => <a href={`/shindan/?carrier=${b.id}#setwari`}><span class="qdot" style={`background:${brandDot[b.id] ?? '#94a3b8'}`} aria-hidden="true"></span><span class="qlabel">{b.name}</span><span class="qarrow" aria-hidden="true">›</span></a>)}
        </div>
        <p class="quick-note">タップすると、2問目（台数）から続きます。全部で5問・約30秒です。</p>
      </div>
    </section>

    <div class="site-container"><MangaShelf swipe heading="漫画でわかる、ネットとスマホの見直し" lead="ママとミナの会話で、3分で読めます。読んだあとは、診断や比較で自分の条件を確かめられます。" /></div>

    <!-- ③ スマホの会社のタブ：タップで、そのスマホに合う回線だけに切りかわる -->
    <section id="carrier" class="sec site-container" aria-labelledby="carrier-title">
      <p class="sec-eyebrow">光回線・ホームルーター</p>
      <h2 id="carrier-title">スマホの会社で、合う回線を絞る</h2>
      <p class="sec-lead">セット割は「スマホの会社」と「家のネット」の組み合わせで決まります。タブを選ぶと、そのスマホとセット割がある回線だけが出ます。</p>
      <div class="tabs" data-tabs>
        <div class="tab-list" role="tablist" aria-label="スマホの会社">
          {tabs.map((t, i) => <button type="button" role="tab" id={`tab-${t.key}`} aria-controls={`panel-${t.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>)}
        </div>
        {tabs.map((t, i) => (
          <div class="tab-panel" role="tabpanel" id={`panel-${t.key}`} aria-labelledby={`tab-${t.key}`} data-panel hidden={i !== 0}>
            <p class="tab-note">{t.note}</p>
            <div class="net-grid">
              {t.list.map(({ h, discounts }) => {
                const p = providers.find((x) => x.id === h.id);
                return (
                  <article class="net-card">
                    <p class="net-kind">{h.kind === 'fiber' ? '光回線' : 'ホームルーター（工事なし）'}{h.prefectures && <span class="net-area">{h.prefectures.map(prefName).join('・')}で確認</span>}</p>
                    <h3>{h.name}</h3>
                    <dl class="net-price">
                      <div><dt>戸建て</dt><dd>{h.monthly.house != null ? <><strong>{yen(h.monthly.house)}</strong>/月</> : '対象外'}</dd></div>
                      <div><dt>マンション</dt><dd>{h.monthly.mansion != null ? <><strong>{yen(h.monthly.mansion)}</strong>/月</> : '対象外'}</dd></div>
                    </dl>
                    {discounts.length > 0 && <ul class="net-set">{discounts.map((d) => <li><span>{d.brand}のセット割</span>スマホ1台につき<strong>最大{yen(d.max)}</strong>/月引き{d.exclusive && '（家族割と併用不可のプランあり）'}</li>)}</ul>}
                    <AffiliateButton provider={p ?? { id: h.id, name: h.name, officialUrl: h.url, affiliate: null }} actionFirst={true} building="house" notice="対象プラン・必要なオプション・提供エリアを申込先で確認してください。" />
                    <details class="net-more">
                      <summary>料金・セット割の条件の詳細を見る</summary>
                      <ul>
                        {(h.requiredBundleOptionMonthly ?? 0) > 0 && <li>セット割には、月{yen(h.requiredBundleOptionMonthly ?? 0)}のオプションが必要です。</li>}
                        {h.decemberMonthly && <li>2026年12月以降は、戸建て{h.decemberMonthly.house != null ? yen(h.decemberMonthly.house) : '-'}・マンション{h.decemberMonthly.mansion != null ? yen(h.decemberMonthly.mansion) : '-'}に改定（契約によって適用の月がちがいます）。</li>}
                        <li>契約期間：{h.contractMonths ? `${h.contractMonths}カ月` : 'なし'}</li>
                        {homeData.homes.find((x) => x.id === h.id)?.note && <li>{homeData.homes.find((x) => x.id === h.id)?.note}</li>}
                      </ul>
                      <p class="net-src">出典：{homeData.homes.find((x) => x.id === h.id)?.sources?.map((s, k) => <>{k > 0 && '・'}<a href={s.url} target="_blank" rel="noopener">{s.label}</a></>)}（{checked}確認・税込）</p>
                    </details>
                  </article>
                );
              })}
            </div>
          </div>
        ))}
      </div>
      <div class="sec-links"><a href="/shindan/#setwari" class="btn-ghost">家族の台数まで入れて診断する →</a><a href="/hikari/" class="text-link">光回線を一覧で比べる →</a></div>
    </section>

    <!-- ① エリアのタブ：自分の地域を選ぶ -->
    <section id="area" class="sec sec-tint" aria-labelledby="area-title">
      <div class="site-container">
        <p class="sec-eyebrow">提供エリア</p>
        <h2 id="area-title">住まいの地域で、使える回線を確かめる</h2>
        <NaviTalk who="mina" text="同じ回線でも、住所や建物で使えないことがあるよ。まず地域を選んでね。" />
        <div class="tabs area-tabs" data-tabs>
          <div class="tab-list" role="tablist" aria-label="地方">
            {regions.map((r, i) => <button type="button" role="tab" id={`tab-${r.key}`} aria-controls={`panel-${r.key}`} aria-selected={r.key === 'kyushu' ? 'true' : 'false'} tabindex={r.key === 'kyushu' ? 0 : -1}>{r.label}</button>)}
          </div>
          {regions.map((r) => (
            <div class="tab-panel" role="tabpanel" id={`panel-${r.key}`} aria-labelledby={`tab-${r.key}`} data-panel hidden={r.key !== 'kyushu'}>
              {r.key === 'kyushu' && <a class="area-feature" href="/hikari/kagoshima/"><strong>鹿児島の光回線をくわしく</strong><span>5社の料金・市町村ごとの提供率・離島の注意点</span></a>}
              <div class="pref-grid">{r.prefs.map((p) => <a href={getPrefecturePath(p)}>{p.name}</a>)}</div>
            </div>
          ))}
        </div>
        <p class="sec-links"><a href="/hikari/area/" class="text-link">47都道府県・市区町村の名前から探す →</a></p>
      </div>
    </section>

    <!-- 選び方ガイド（通信） -->
    <section class="sec site-container" aria-labelledby="guides-title">
      <p class="sec-eyebrow">漫画と選び方ガイド</p>
      <h2 id="guides-title">迷っていることから読む</h2>
      <div class="guide-grid">{internetGuides.map((card) => <article><a href={card.href}>{card.manga ? <MangaThumbnail sheet={card.manga.sheet} frame={card.manga.frame} /> : <GuideArtwork slug={card.artworkSlug} />}<span class="guide-category">{categoryLabel[card.category]}{card.manga && <span class="manga-label">漫画で比較</span>}</span><h3>{card.title}</h3><span class="guide-bottom"><time datetime={card.updatedAt}>{jpDate(card.updatedAt)}</time><b>読む →</b></span></a></article>)}</div>
      <p class="sec-links"><a href="/guides/" class="text-link">全{guideCount}本を検索する →</a></p>
    </section>

    <!-- ① ほかのジャンル：背景色を変えて、通信とはっきり分ける -->
    <section class="other" aria-labelledby="other-title">
      <div class="site-container">
        <p class="sec-eyebrow">通信のほかのテーマ</p>
        <h2 id="other-title">お金・安全・学びの見直しも</h2>
        <div class="other-grid">
          <a href="/card/"><strong>クレジットカード</strong><span>スマホ代でおトクなカードと、年会費無料のカード</span></a>
          <a href="/security/"><strong>セキュリティ・詐欺対策</strong><span>ウイルス対策ソフト・VPN・偽SMSの見分け方</span></a>
          <a href="/used-smartphones/"><strong>中古スマホ</strong><span>保証と返品の条件で比べる</span></a>
          <a href="/houjin/"><strong>会社・お店向け</strong><span>法人携帯・電話・コピー機・法人カード</span></a>
        </div>
        <div id="learning" class="learning">
          <h3>英語学習は、目的から選ぶ</h3>
          <div class="learning-grid">
            {learning.map((offer, index) => (
              <article>
                <p class="learning-aud">{index === 0 ? 'TOEIC L&R TESTの受験が目的' : '旅行・日常のフレーズを学びたい'}</p>
                <h4>{index === 0 ? 'TOEIC L&R TEST対策コース' : '新日常英会話コース'}</h4>
                <p class="learning-price">スタディサプリENGLISH・Web月額 <strong>{index === 0 ? '3,278円' : '2,178円'}</strong></p>
                <AffiliateButton provider={offer} />
                <details class="net-more"><summary>料金の条件を見る</summary><p>税込・2026年11月22日確認。月額払いの通常料金です。複数月パックやアプリ内決済は条件が異なります。無料体験の対象と課金開始日は、申込画面で確認してください。<a href="https://eigosapuri.jp/plan/" target="_blank" rel="noopener">出典：リクルート公式料金</a></p></details>
              </article>
            ))}
          </div>
          <p class="sec-links"><a href="/guides/study-sapuri-toeic-vs-eikaiwa/" class="text-link">コースのちがいを比べる →</a></p>
        </div>
      </div>
    </section>

    <aside class="site-container trust">
      <h2>料金だけでなく、使う条件まで比べます</h2>
      <p>公式情報をもとに、対象プラン・契約期間・追加費用・向かないケースを整理しています。各ページに確認日と出典を載せています。順位は、広告の報酬ではなく条件で決めています。</p>
      <a href="/about/">編集方針・運営者情報を見る →</a>
    </aside>
  </div>
</Base>

<script>
  // タブ（キーボードの左右でも動く）。JavaScriptが動かないときは、最初のパネルだけが見える
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (t: HTMLButtonElement) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(x.getAttribute('aria-controls')!);
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k !== 'ArrowRight' && k !== 'ArrowLeft') return;
        const n = tabs[(i + (k === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(n); n.focus();
      });
    });
  });
</script>

<style>
  /* ⑤ デザインの決まり：色は3つ（白〜薄いグレー／深い緑／オレンジ）、角丸16px、うすい影、広めの余白 */
  .top { --c-base: #f6f8f6; --c-main: #175d50; --c-main-dark: #0f463c; --c-ink: #173d2b; --c-accent: #ea580c; --c-accent-dark: #c2410c; --c-line: #dbe5dd; --radius: 16px; --shadow: 0 8px 24px rgba(23,61,43,.08); color: #23352e; background: #fff; }
  .top h2 { font-size: clamp(23px, 3vw, 30px); font-weight: 900; line-height: 1.45; color: var(--c-ink); }
  .sec { padding-block: 56px 8px; }
  .sec-tint { background: var(--c-base); padding-block: 56px; margin-top: 56px; }
  .sec-eyebrow { font-size: 13px; font-weight: 800; letter-spacing: .06em; color: var(--c-main); margin-bottom: 6px; }
  .sec-lead { margin-top: 10px; font-size: 15px; line-height: 1.9; color: #4f6a5a; max-width: 760px; }
  .sec-links { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 22px; }
  .text-link { font-size: 15px; font-weight: 800; color: var(--c-main); text-decoration: underline; text-underline-offset: 4px; }

  /* ファーストビュー */
  .hx { background: linear-gradient(160deg, #f1f7f2 0%, #ffffff 62%); border-bottom: 1px solid var(--c-line); }
  .hx-inner { display: grid; grid-template-columns: 1.05fr .95fr; gap: 36px; align-items: center; padding-block: 40px 44px; }
  .hx-badges { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0 0 16px; }
  .hx-badges li { font-size: 13px; font-weight: 800; color: var(--c-main-dark); background: #fff; border: 1.5px solid #bcd3c3; border-radius: 999px; padding: 4px 12px; }
  .hx h1 { font-size: clamp(30px, 4.4vw, 46px); font-weight: 900; line-height: 1.35; color: var(--c-ink); }
  .hx h1 span { color: var(--c-main); }
  .hx-lead { margin-top: 14px; font-size: 16px; line-height: 1.95; color: #4f6a5a; max-width: 560px; }
  .btn-main { display: flex; flex-direction: column; align-items: center; justify-content: center; max-width: 460px; min-height: 72px; margin-top: 22px; padding: 14px 22px; border-radius: 999px; background: var(--c-accent); color: #fff; font-size: 20px; font-weight: 900; text-decoration: none; text-align: center; box-shadow: 0 8px 20px rgba(234,88,12,.32); transition: transform .15s, background .15s; }
