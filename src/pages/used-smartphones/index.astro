---
import RelatedServiceHub from '../../components/RelatedServiceHub.astro';
import usedPhoneShops from '../../data/used-phone-shops.json';
const intro = [
  { title: '使いたい回線とOS更新を確認', body: '機種名だけでなく、型番・SIMの種類・回線の動作確認を見ます。OSの更新対象とアプリの対応も確かめてください。' },
  { title: '本体の状態と電池を確認', body: '同じ機種・容量でも、傷・付属品・バッテリーの状態で価格は変わります。商品ごとの記載と、保証に含まれる範囲を読みましょう。' },
  { title: '保証は内容と期間を確認', body: '初期不良・ネットワーク利用制限・バッテリーなどで、保証の扱いが異なる場合があります。返金か交換か、手続きの期限まで確認します。' },
];
const explain = [
  { title: '同じ条件の商品で比べる', body: '機種名だけで価格を比べず、型番・容量・状態ランク・付属品をそろえます。写真と実物の扱い、傷の説明も商品ページで確認してください。', checks: ['機種・型番・保存容量と状態ランク', 'SIMロックやSIM/eSIMへの対応', '充電器・ケーブルなど付属品の有無'] },
  { title: 'バッテリーと使える期間', body: 'バッテリー最大容量の記載があるか、保証対象かを見ます。OSとアプリの更新への対応も、今後使う期間に合わせて確認してください。', checks: ['バッテリー状態の記載と保証の扱い', '必要なら交換費用を含めた予算', 'OS更新の対象と使いたいアプリの対応'] },
  { title: '赤ロム保証・返品の条件', body: 'ネットワーク利用制限がかかると、携帯回線を使えなくなることがあります。保証の対象・期間・返金や交換の条件を、購入前に確認しましょう。', checks: ['ネットワーク利用制限の状態と保証', '初期不良の連絡期限と返送費用', '購入者都合の返品可否と、必要な証明'] },
];
const related = [
  { href: '/mobile/', title: '合わせて使うSIMを選ぶ', body: '端末を決める前に、対応機種・回線・SIMの種類を公式で確認します。' },
  { href: '/security/', title: '購入後のセキュリティ', body: 'OS更新や基本設定と、追加する保護機能の条件を確認します。' },
  { href: '/hikari/area/', title: '自宅のWi-Fiも確認', body: '自宅で使うネット回線を、住所と建物の設備から確かめます。' },
];
---
<RelatedServiceHub category="used" path="/used-smartphones/" title="中古スマホ販売店を比較｜状態・バッテリー・赤ロム保証の確認方法" description="mmoba・ダイワンテレコム・イオシス・ゲオの公式情報から、中古スマホ購入前の確認点を整理。価格だけでなく状態・付属品・バッテリー・初期不良と赤ロム保証を比較します。" eyebrow="中古スマホ" heading="価格だけで決めず、状態と保証を確かめて選ぶ。" lead="中古スマホは、同じ機種でも状態・容量・保証で条件が変わります。端末と回線の対応を確認し、商品ページに書かれた状態と購入後の対応まで比べましょう。" services={usedPhoneShops} intro={intro} explainTitle="中古スマホは、この3点を商品ごとに確認" explain={explain} related={related} />
