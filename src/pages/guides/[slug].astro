---
import Base from '../../layouts/Base.astro';
import ConnectivityManga from '../../components/ConnectivityManga.astro';
import GuideDecision from '../../components/GuideDecision.astro';
import GuideArtwork from '../../components/GuideArtwork.astro';
import CostStory from '../../components/CostStory.astro';
import ShortTermCost from '../../components/ShortTermCost.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import PointsComparison from '../../components/PointsComparison.astro';
import CancellationGuide from '../../components/CancellationGuide.astro';
import RelatedConnectivityLinks from '../../components/RelatedConnectivityLinks.astro';
import { guides, categoryLabel, readingMinutes, type Guide } from '../../lib/guides';
import { offers } from '../../lib/offers';
import { byId, jpDate, faqLd, breadcrumbLd } from '../../lib/data';
import { SITE } from '../../site.config.mjs';
export function getStaticPaths() { return guides.map(guide => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide: g } = Astro.props as { guide: Guide };
const related = g.relatedSlugs.map(slug => guides.find(guide => guide.slug === slug)).filter(Boolean) as Guide[];
const services = g.relatedProviderIds.map(byId).filter(p => p !== undefined);
const shortStay = g.slug === 'hikari-one-year';
const internetMangaStories = { 'bbiq-vs-docomo-hikari':'compare-docomo', 'bbiq-vs-biglobe-hikari':'compare-biglobe', 'hikari-one-year':'short-stay', 'moving-internet-kagoshima':'moving' } as const;
const internetMangaStory = internetMangaStories[g.slug as keyof typeof internetMangaStories];
const nextStepLink = shortStay ? { href: '#one-year-cost', label: '12カ月の総額を比較' } : { href: '#next-step', label: '候補の条件を確認' };
const matchedOffers = offers.filter(offer => offer.guideSlugs.includes(g.slug));
const crumbs = [{ name: '総合トップ', href: '/' }, { name: '選び方ガイド', href: '/guides/' }, { name: g.title, href: `/guides/${g.slug}/` }];
const articleLd = { '@context':'https://schema.org','@type':'Article',headline:g.title,description:g.description,datePublished:g.updatedAt,dateModified:g.updatedAt,mainEntityOfPage:new URL(`/guides/${g.slug}/`, SITE.url).href,author:{'@type':'Organization',name:SITE.operator,url:`${SITE.url}/about/`},publisher:{'@type':'Organization',name:SITE.name,url:SITE.url},inLanguage:'ja' };
---
<Base title={g.title} description={g.description} jsonLd={[articleLd, breadcrumbLd(SITE.url, crumbs), ...(g.faqs.length ? [faqLd(g.faqs)] : [])]}>
  <div class="page-shell guide-page">
    <Breadcrumbs items={[{name:'総合トップ',href:'/'},{name:'選び方ガイド',href:'/guides/'},{name:categoryLabel[g.category]}]} />
    <header class="guide-header">
      <p class="section-kicker">{categoryLabel[g.category]} / 選び方ガイド</p>
      <h1>{g.title}</h1>
      <p class="guide-lead">{g.lead}</p>
      <div class="guide-byline"><span>{SITE.operator}</span><span>情報確認：<time datetime={g.updatedAt}>{jpDate(g.updatedAt)}</time></span><span>約{readingMinutes(g)}分で読めます</span></div>
    </header>
    <div class="guide-body">
      <article class="guide-main">
        {g.category === 'internet' && internetMangaStory && <ConnectivityManga story={internetMangaStory} context={g.title} comparisonHref="#answer" diagnosisHref={shortStay ? '/shindan/#diagnosis-form' : '/shindan/?prefecture=46#diagnosis-form'} />}
        <GuideDecision slug={g.slug} />
        {g.category === 'internet' && g.relatedProviderIds.includes('docomo-hikari') && <details class="guide-points"><summary>dポイント還元の条件も確認する</summary><PointsComparison systems={['dpoint']} scope="home" compact /></details>}
        {shortStay && <><ShortTermCost /><CostStory /></>}
        {!shortStay && <GuideArtwork slug={g.slug} compact={false} />}
        <nav class="inline-toc" aria-label="この記事の目次"><p>この記事で分かること</p><ol>{g.sections.map(section => <li><a href={`#${section.id}`}>{section.title}<span aria-hidden="true">↓</span></a></li>)}{g.faqs.length>0 && <li><a href="#faq">よくある質問<span aria-hidden="true">↓</span></a></li>}</ol></nav>
        <div id="article-details" class="article-copy prose-ja">
          {g.sections.map(section => <section aria-labelledby={section.id}>
            <h2 id={section.id}>{section.title}</h2>
            {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
            {section.table && <><p class="table-scroll-hint" id={`${section.id}-scroll-hint`}>表は横にスクロールできます</p><div class="article-table" role="region" aria-label={`${section.title}の比較表`} aria-describedby={`${section.id}-scroll-hint`} tabindex="0"><table><caption>{section.title}の比較</caption><thead><tr>{section.table.headers.map(header => <th scope="col">{header}</th>)}</tr></thead><tbody>{section.table.rows.map(row => <tr>{row.map((cell,index) => index===0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div></>}
            {section.bullets && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}
            {section.note && <aside class="article-note"><span>確認ポイント</span><p>{section.note}</p></aside>}
          </section>)}
        </div>
        {!shortStay && (services.length > 0 || matchedOffers.length > 0) && <section id="next-step" class="next-step-section"><p class="section-kicker">次にすること</p><h2 class="guide-section-title">{shortStay ? '解約予定月の総額を、各窓口で確認。' : '条件が合う候補を、もう一度確認。'}</h2><p class="next-step-lead">申込みの前に、対象プラン・追加費用・特典の受取条件をリンク先で確かめてください。</p><div class="service-options">{services.map(p => <article class="surface-card service-option"><h3>{p.name}</h3><p>{shortStay ? '短期向けと断定するものではありません。工事費・端末代の残額と、解約予定月までの総額を確認してください。' : p.goodFor[0]}</p><a href={`/hikari/${p.id}/`} class="detail-link">料金と注意点を読む →</a><AffiliateButton provider={p} /></article>)}{matchedOffers.map(offer => <article class="surface-card service-option"><h3>{offer.name}</h3><p>{offer.note}</p><AffiliateButton provider={offer} /></article>)}</div></section>}
        {g.category === 'internet' && <><CancellationGuide ids={[...(shortStay?['en-hikari']:[]),...g.relatedProviderIds]} kind="home" compact /><RelatedConnectivityLinks /></>}
        {g.faqs.length > 0 && <section id="faq" class="guide-faq"><h2 class="guide-section-title">よくある質問</h2>{g.faqs.map(faq => <details><summary><span aria-hidden="true">Q</span>{faq.q}</summary><p>{faq.a}</p></details>)}</section>}
        <section id="sources" class="sources-section"><h2>出典と確認範囲</h2><p>この記事は、以下の公式情報をもとに編集しています。{g.category === 'learning' ? '教材の受講評価や学習効果の独自検証は行っていません。' : '実機の速度測定や、利用者全体を代表する満足度調査は行っていません。'}料金や受付条件は変わるため、申込み前に公式サイトで最新情報をご確認ください。</p><ul>{g.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener">{source.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul><p>情報確認日：{jpDate(g.updatedAt)} ／ <a href="/about/">編集方針</a> ／ <a href="/contact/">掲載内容について</a></p></section>
      </article>
      <aside class="guide-sidebar"><div><p>この記事の目次</p><a href="#answer">先に結論</a>{g.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}{(services.length>0||matchedOffers.length>0)&&<a href={nextStepLink.href}>{nextStepLink.label}</a>}<a href="#sources">出典と確認範囲</a><span class="sidebar-stamp">公式情報で、<br />選ぶ前のひと調べ。</span></div></aside>
    </div>
    {related.length > 0 && <section class="related-section"><p class="section-kicker">あわせて読みたい</p><h2 class="section-title">もう一歩、選びやすく。</h2><div>{related.map(guide=><a class="surface-card" href={`/guides/${guide.slug}/`}><span>{categoryLabel[guide.category]}</span><h3>{guide.title}</h3><p>{guide.description}</p><b aria-hidden="true">→</b></a>)}</div></section>}
    <a class="all-guides-link" href="/guides/">← 選び方ガイドの一覧へ</a>
  </div>
</Base>

<style>
.guide-points{margin:22px 0;padding:16px 19px;border:1px solid #d8d6be;border-radius:7px;background:#fffdf4}.guide-points>summary{font-size:16px;font-weight:800;line-height:1.85;color:#175d50;cursor:pointer}
.table-scroll-hint{display:none}
.article-table:focus-visible{outline:3px solid #175d50;outline-offset:3px}
@media(max-width:700px){.guide-page .article-copy .table-scroll-hint{display:block;margin:16px 0 8px;font-size:13px;line-height:1.7;color:#536459}.table-scroll-hint+.article-table{margin-top:0}}
.guide-page{max-width:1160px;padding-top:22px;background:#fff}.guide-header{max-width:880px;padding:12px 0 24px}.guide-header h1{font-size:clamp(25px,3vw,36px);font-weight:800;line-height:1.5;margin:10px 0 14px;letter-spacing:0;font-family:var(--font-sans)}.guide-lead{font-size:16px;line-height:1.85;max-width:800px;color:#46534b}.guide-byline{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:13px;color:#59685e;margin-top:15px}.guide-body{display:grid;grid-template-columns:minmax(0,840px) minmax(180px,1fr);gap:32px}.guide-main{min-width:0}.guide-section-title{font-size:24px;font-weight:800;line-height:1.6;margin-bottom:18px}.inline-toc{margin:25px 0;background:#f5f8f6;border:1px solid #dce5de;border-radius:6px;padding:20px}.inline-toc>p{font-size:15px;font-weight:700;margin-bottom:10px}.inline-toc ol{list-style:decimal;padding-left:22px}.inline-toc li a{font-size:14px;line-height:1.7;color:#175d50;display:flex;justify-content:space-between;gap:10px;padding:7px 0;text-decoration:underline;text-underline-offset:3px}.article-copy{font-size:16px}.article-table{overflow-x:auto;margin:20px 0}.article-table table{min-width:550px;font-size:14px}.article-table caption{text-align:left;font-size:13px;color:#536459;padding-bottom:8px}.article-table tbody th{width:25%;background:#f2f6f3}.article-note{background:#fff7e9;border:1px solid #f0dfc2;padding:18px;margin:22px 0;border-radius:5px}.article-note>span{font-size:13px;font-weight:700;color:#97451d}.article-note p{font-size:14px!important;line-height:1.85!important;margin:8px 0 0!important}.guide-sidebar>div{position:sticky;top:20px;border:1px solid #dce5de;border-radius:6px;padding:18px;background:#f7faf8}.guide-sidebar p{font-size:14px;font-weight:700;margin-bottom:12px}.guide-sidebar a{display:block;font-size:13px;line-height:1.75;color:#43574a;margin:12px 0}.sidebar-stamp{display:block;border-top:1px solid #dce5de;margin-top:20px;padding-top:18px;font-size:13px;line-height:1.8}.next-step-section{margin:35px 0}.next-step-section h2{margin:10px 0}.next-step-lead{font-size:15px;line-height:1.8;margin-bottom:18px}.service-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.service-option{padding:22px}.service-option h3{font-size:19px;font-weight:700;line-height:1.5}.service-option>p{font-size:14px;line-height:1.8;margin:12px 0}.detail-link{display:block;font-size:14px;color:#175d50;font-weight:700;text-decoration:underline;margin:15px 0}.guide-faq{margin:35px 0}.guide-faq details{border:1px solid #dce5de;border-bottom:0;padding:18px;background:#fff}.guide-faq details:last-child{border-bottom:1px solid #dce5de}.guide-faq summary{display:flex;gap:12px;cursor:pointer;font-size:16px;line-height:1.7;font-weight:700}.guide-faq summary span{color:#175d50}.guide-faq details p{font-size:15px;line-height:1.9;margin-top:15px}.sources-section{border-top:1px solid #dce5de;padding-top:22px;margin-top:35px;font-size:13px;color:#536459;line-height:1.9}.sources-section h2{font-size:17px;font-weight:700;margin-bottom:12px}.sources-section ul{list-style:disc;padding-left:20px;margin:12px 0}.sources-section a{color:#175d50;text-decoration:underline;overflow-wrap:anywhere}.related-section{margin-top:40px;border-top:1px solid #dce5de;padding-top:30px}.related-section>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:20px}.related-section a{padding:20px}.related-section a>span{font-size:13px;color:#175d50}.related-section h3{font-size:17px;line-height:1.6;font-weight:700;margin:10px 0}.related-section p{font-size:14px;line-height:1.8;color:#536459}.related-section b{display:block;margin-top:14px}.all-guides-link{display:inline-block;margin-top:24px;font-size:14px;color:#175d50;text-decoration:underline}@media(max-width:950px){.guide-body{grid-template-columns:1fr}.guide-sidebar{display:none}}@media(max-width:600px){.guide-page{padding-top:16px}.guide-header{padding:12px 0 20px}.guide-header h1{font-size:25px}.guide-lead{font-size:15px}.guide-byline{font-size:12px}.guide-section-title{font-size:22px}.service-options,.related-section>div{grid-template-columns:1fr}.inline-toc{padding:17px}.guide-faq details{padding:16px}.guide-faq summary{font-size:15px}.guide-page :global(.prose-ja p){font-size:16px}}
</style>
