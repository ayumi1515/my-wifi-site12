---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import { guides, categoryLabel, readingMinutes, type Guide } from '../../lib/guides';
import { offers } from '../../lib/offers';
import { byId, jpDate, faqLd, breadcrumbLd } from '../../lib/data';
import { SITE } from '../../site.config.mjs';
export function getStaticPaths() { return guides.map(guide => ({ params: { slug: guide.slug }, props: { guide } })); }
const { guide: g } = Astro.props as { guide: Guide };
const related = g.relatedSlugs.map(slug => guides.find(guide => guide.slug === slug)).filter(Boolean) as Guide[];
const services = g.relatedProviderIds.map(byId).filter(p => p !== undefined);
const shortStay = g.slug === 'hikari-one-year';
const matchedOffers = offers.filter(offer => offer.guideSlugs.includes(g.slug));
const crumbs = [{ name: '総合トップ', href: '/' }, { name: '選び方ガイド', href: '/guides/' }, { name: g.title, href: `/guides/${g.slug}/` }];
const articleLd = { '@context':'https://schema.org','@type':'Article',headline:g.title,description:g.description,datePublished:g.updatedAt,dateModified:g.updatedAt,mainEntityOfPage:new URL(`/guides/${g.slug}/`, SITE.url).href,author:{'@type':'Organization',name:SITE.operator,url:`${SITE.url}/about/`},publisher:{'@type':'Organization',name:SITE.name,url:SITE.url},inLanguage:'ja' };
---
<Base title={g.title} description={g.description} jsonLd={[articleLd, breadcrumbLd(SITE.url, crumbs), ...(g.faqs.length ? [faqLd(g.faqs)] : [])]}>
  <div class="page-shell guide-page">
    <Breadcrumbs items={[{name:'総合トップ',href:'/'},{name:'選び方ガイド',href:'/guides/'},{name:categoryLabel[g.category]}]} />
    <header class="guide-header">
      <p class="section-kicker">{categoryLabel[g.category]} / 選び方ガイド</p>
      <h1>{g.title}</h1>
      <p class="guide-lead">{g.lead}</p>
      <div class="guide-byline"><span>{SITE.operator}</span><span>情報確認：<time datetime={g.updatedAt}>{jpDate(g.updatedAt)}</time></span><span>約{readingMinutes(g)}分で読めます</span></div>
    </header>
    <div class="guide-body">
      <article class="guide-main">
        <section class="answer-box" aria-labelledby="answer"><p class="section-kicker">先に結論</p><h2 id="answer">まず、ここを確かめる。</h2><ul>{g.summary.map(summary => <li><span aria-hidden="true">✓</span><p>{summary}</p></li>)}</ul></section>
        {g.decisions.length > 0 && <section class="decision-section"><h2 class="guide-section-title" id="situations">あなたの状況なら、どこから選ぶ？</h2><div class="decision-list">{g.decisions.map(decision => <div><p class="situation">{decision.situation}</p><p class="answer">{decision.answer}</p><p class="reason">{decision.reason}</p></div>)}</div></section>}
        <nav class="inline-toc" aria-label="この記事の目次"><p>この記事で分かること</p><ol>{g.sections.map(section => <li><a href={`#${section.id}`}>{section.title}<span aria-hidden="true">↓</span></a></li>)}{g.faqs.length>0 && <li><a href="#faq">よくある質問<span aria-hidden="true">↓</span></a></li>}</ol></nav>
        <div class="article-copy prose-ja">
          {g.sections.map(section => <section aria-labelledby={section.id}>
            <h2 id={section.id}>{section.title}</h2>
            {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
            {section.table && <div class="article-table"><table><caption>{section.title}の比較</caption><thead><tr>{section.table.headers.map(header => <th scope="col">{header}</th>)}</tr></thead><tbody>{section.table.rows.map(row => <tr>{row.map((cell,index) => index===0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>}
            {section.bullets && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}
            {section.note && <aside class="article-note"><span>確認ポイント</span><p>{section.note}</p></aside>}
          </section>)}
        </div>
        {(services.length > 0 || matchedOffers.length > 0) && <section id="next-step" class="next-step-section"><p class="section-kicker">次にすること</p><h2 class="guide-section-title">{shortStay ? '解約予定月の総額を、各窓口で確認。' : '条件が合う候補を、もう一度確認。'}</h2><p class="next-step-lead">申込みの前に、対象プラン・追加費用・特典の受取条件をリンク先で確かめてください。</p><div class="service-options">{services.map(p => <article class="surface-card service-option"><h3>{p.name}</h3><p>{shortStay ? '短期向けと断定するものではありません。工事費・端末代の残額と、解約予定月までの総額を確認してください。' : p.goodFor[0]}</p><a href={`/hikari/${p.id}/`} class="detail-link">料金と注意点を読む →</a><AffiliateButton provider={p} /></article>)}{matchedOffers.map(offer => <article class="surface-card service-option"><h3>{offer.name}</h3><p>{offer.note}</p><AffiliateButton provider={offer} /></article>)}</div></section>}
        {g.faqs.length > 0 && <section id="faq" class="guide-faq"><h2 class="guide-section-title">よくある質問</h2>{g.faqs.map(faq => <details><summary><span aria-hidden="true">Q</span>{faq.q}</summary><p>{faq.a}</p></details>)}</section>}
        <section id="sources" class="sources-section"><h2>出典と確認範囲</h2><p>この記事は、以下の公式情報をもとに編集しています。{g.category === 'learning' ? '教材の受講評価や学習効果の独自検証は行っていません。' : '実機の速度測定や、利用者全体を代表する満足度調査は行っていません。'}料金や受付条件は変わるため、申込み前に公式サイトで最新情報をご確認ください。</p><ul>{g.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener">{source.label}<span aria-hidden="true"> ↗</span></a></li>)}</ul><p>情報確認日：{jpDate(g.updatedAt)} ／ <a href="/about/">編集方針</a> ／ <a href="/contact/">掲載内容について</a></p></section>
      </article>
      <aside class="guide-sidebar"><div><p>この記事の目次</p><a href="#answer">先に結論</a>{g.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}{(services.length>0||matchedOffers.length>0)&&<a href="#next-step">候補の条件を確認</a>}<a href="#sources">出典と確認範囲</a><span class="sidebar-stamp">公式情報で、<br />選ぶ前のひと調べ。</span></div></aside>
    </div>
    {related.length > 0 && <section class="related-section"><p class="section-kicker">あわせて読みたい</p><h2 class="section-title">もう一歩、選びやすく。</h2><div>{related.map(guide=><a class="surface-card" href={`/guides/${guide.slug}/`}><span>{categoryLabel[guide.category]}</span><h3>{guide.title}</h3><p>{guide.description}</p><b aria-hidden="true">→</b></a>)}</div></section>}
    <a class="all-guides-link" href="/guides/">← 選び方ガイドの一覧へ</a>
  </div>
</Base>

<style>
  .guide-header{max-width:880px;padding:20px 0 35px}.guide-header h1{font-size:clamp(1.8rem,3.4vw,2.75rem);font-weight:700;line-height:1.65;margin:18px 0 23px;letter-spacing:.015em}.guide-lead{max-width:760px;font-size:14px;color:var(--ink-light);line-height:2.05}.guide-byline{display:flex;flex-wrap:wrap;gap:7px 20px;margin-top:24px;font-size:10px;color:#788373;line-height:1.8}.guide-byline>span:first-child{color:#40573e}.guide-body{display:grid;grid-template-columns:minmax(0,790px) minmax(190px,1fr);gap:58px}.guide-main{min-width:0}.answer-box{background:#eaf0e3;border:1px solid #d6e1cd;border-radius:14px;padding:28px 32px}.answer-box h2{font-family:var(--serif);font-size:21px;font-weight:700;line-height:1.7;margin:12px 0 20px}.answer-box ul{padding:0;margin:0;list-style:none}.answer-box li{display:flex;gap:12px;padding:13px 0;border-top:1px solid #d5dfcb}.answer-box li>span{color:#467449;font-size:16px;padding-top:1px}.answer-box li p{font-size:14px;line-height:1.9}.guide-section-title{font-family:var(--serif);font-size:clamp(1.25rem,2.5vw,1.65rem);font-weight:700;line-height:1.8;margin:0 0 20px}.decision-section{margin-top:40px}.decision-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.decision-list>div{padding:22px;background:#fff;border:1px solid var(--line);border-radius:10px}.situation{font-size:11px;font-weight:700;color:#8a4b2d;line-height:1.8}.answer{font-size:15px;font-weight:700;line-height:1.8;margin-top:7px}.reason{font-size:12px;color:var(--ink-light);line-height:1.9;margin-top:9px}.inline-toc{margin:35px 0;padding:23px 28px;border:1px solid var(--line);background:#fff;border-radius:10px}.inline-toc>p{font-size:12px;font-weight:700;margin-bottom:15px}.inline-toc ol{padding:0;list-style:none}.inline-toc li{border-top:1px solid #edf0e7}.inline-toc li a{display:flex;justify-content:space-between;gap:10px;padding:12px 0;font-size:12px;line-height:1.8}.inline-toc li a:hover{color:var(--color-brand-600)}.inline-toc span{color:#6f8a65}.article-copy section{padding-bottom:2px}.article-table{overflow-x:auto;margin-bottom:22px}.article-table table{min-width:550px;margin-bottom:0}.article-table caption{text-align:left;font-size:11px;color:var(--ink-light);padding-bottom:10px}.article-table tbody th{width:23%;background:#f4f6ef}.article-note{background:#f0eee3;border-radius:9px;padding:20px 23px;margin:25px 0}.article-note>span{font-size:10px;color:#8a4b2d;font-weight:700;letter-spacing:.06em}.article-note p{font-size:13px!important;line-height:1.95!important;margin:10px 0 0!important}.guide-sidebar>div{position:sticky;top:25px;border-left:1px solid var(--line);padding-left:25px}.guide-sidebar p{font-size:11px;font-weight:700;margin:10px 0 19px}.guide-sidebar a{display:block;font-size:11px;line-height:1.85;color:#64725e;margin:13px 0}.guide-sidebar a:hover{color:#175d50}.sidebar-stamp{display:block;margin-top:35px;padding-top:25px;border-top:1px solid var(--line);font-family:var(--serif);font-size:15px;line-height:1.9;color:#71846b}.next-step-section{margin:45px 0}.next-step-section h2{margin-top:12px}.next-step-lead{font-size:12px;color:var(--ink-light);line-height:1.9;margin-bottom:20px}.service-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.service-option{padding:24px}.service-option h3{font-size:17px;font-weight:700;line-height:1.7}.service-option>p{font-size:12px;line-height:1.9;margin:10px 0 20px;color:var(--ink-light)}.detail-link{display:block;font-size:12px;font-weight:700;color:#175d50;margin-bottom:18px}.guide-faq{margin:45px 0}.guide-faq details{border-top:1px solid var(--line);background:#fff;padding:19px 22px}.guide-faq details:last-child{border-bottom:1px solid var(--line)}.guide-faq summary{display:flex;gap:13px;cursor:pointer;font-size:13px;font-weight:700;line-height:1.9;list-style:none}.guide-faq summary>span{color:#a26b42}.guide-faq details p{font-size:13px;line-height:2;color:var(--ink-light);padding:17px 0 0 26px}.sources-section{border-top:1px solid var(--line);padding-top:27px;margin-top:45px;font-size:11px;color:#6d7866;line-height:2}.sources-section h2{font-size:13px;font-weight:700;color:#344d33;margin-bottom:14px}.sources-section ul{padding-left:17px;list-style:disc;margin:16px 0}.sources-section a{color:#3e6d4a;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}.related-section{margin-top:60px;border-top:1px solid var(--line);padding-top:40px}.related-section>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:25px}.related-section a{position:relative;display:block;padding:25px}.related-section a>span{font-size:10px;color:#8a4b2d;font-weight:700}.related-section h3{font-size:15px;font-weight:700;line-height:1.9;margin:10px 0 12px}.related-section p{font-size:11px;line-height:1.9;color:var(--ink-light)}.related-section b{display:block;margin-top:20px;color:#175d50;font-weight:400}.all-guides-link{display:inline-block;font-size:12px;color:#526850;margin-top:35px}@media(max-width:950px){.guide-body{grid-template-columns:minmax(0,1fr);gap:0}.guide-sidebar{display:none}.guide-header{max-width:none}.related-section>div{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.guide-header{padding-top:10px}.guide-header h1{font-size:25px;line-height:1.65}.guide-lead{font-size:13px}.guide-byline{font-size:9px;gap:5px 14px}.answer-box{padding:23px 20px}.answer-box h2{font-size:20px}.answer-box li p{font-size:13px}.decision-list,.service-options,.related-section>div{grid-template-columns:1fr}.inline-toc{padding:21px}.guide-section-title{font-size:21px}.article-table table{font-size:12px}.service-option{padding:22px}.guide-faq details{padding:17px}.guide-faq details p{padding-left:0}.related-section a{padding:23px}.sources-section{font-size:11px}}
</style>
