---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VisualHero from '../../components/VisualHero.astro';
import HouseholdDiagnosis from '../../components/HouseholdDiagnosis.astro';
import { breadcrumbLd } from '../../lib/data';
import { SITE } from '../../site.config.mjs';
const crumbs=[{name:'総合トップ',href:'/'},{name:'回線・スマホ診断',href:'/shindan/'}];
---
<Base title="家族の通信費診断｜キャリア・格安SIMと光回線、特典込みの節約目安" description="家族の回線数・キャリア・通信量・契約年数から、自宅とスマホの組合せを比較。通常月額と家族割・セット割、条件を満たす特典、乗換費用を分け、利用期間ごとの節約目安を確認できます。" jsonLd={[breadcrumbLd(SITE.url,crumbs)]}>
  <div class="household-page site-container">
    <Breadcrumbs items={[crumbs[0],{name:crumbs[1].name}]} />
    <VisualHero title={"家族の通信費を、\nまとめて見直す。"} lead="キャリアも、格安SIMも。家族それぞれの使い方と契約年数から、自宅回線との組合せと、切替後の節約目安を比べます。" image="internet" eyebrow="家族の回線数・年数・特典まで比べる"><a class="family-start" href="#diagnosis-form">家族の通信費を診断する</a></VisualHero>
    <HouseholdDiagnosis />
    <section class="method"><h2>計算に入れる条件と確認すること</h2><p>掲載した代表プランの通常料金と、対象となる家族割・セット割を比較します。各自宅回線について、入力された通信量とブランド・店舗の希望を満たすスマホの組合せを探し、利用期間の参考費用から、受け取る想定を選んだ特典を差し引いた順に最大3案を表示します。</p><p>回線の提供・通信品質・通話条件は住所や利用状況で変わります。費用を確認できないプランやpovoの都度購入、建物ごとに料金が変わるプランは、定額の自動比較に含めません。全商品・すべての割引を網羅した順位ではありません。</p><p><a href="/hikari/area/">全国の提供エリア確認</a> ／ <a href="/mobile/">掲載中のスマホ・SIM</a> ／ <a href="/guides/hikari-one-year/">1年利用の総額比較</a> ／ <a href="/about/">編集方針</a></p></section>
  </div>
</Base>
<style>
.household-page{max-width:1120px;padding-top:24px;padding-bottom:45px}.household-page :global(.visual-hero){margin-top:18px}.family-start{display:inline-flex;align-items:center;justify-content:center;min-height:54px;border-radius:6px;background:#ae512e;color:#fff;font-size:17px;font-weight:800;line-height:1.7;padding:14px 24px;margin-top:18px}.family-start:hover{background:#8c3f24}.family-start:focus-visible{outline:3px solid #175d50;outline-offset:4px}.method{margin-top:35px;border-top:1px solid #d3dfd7;padding-top:24px}.method h2{font-size:23px;font-weight:800;line-height:1.7}.method p{font-size:15px;line-height:1.95;color:#52685a;margin-top:13px}.method a{color:#175d50;text-decoration:underline;text-underline-offset:4px}@media(max-width:700px){.family-start{display:flex;width:100%;font-size:16px;padding:13px 15px}.household-page{padding-top:18px}}
</style>
