---
import Base from '../../../../layouts/Base.astro';
import ConnectivityManga from '../../../../components/ConnectivityManga.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import NationalInternetChecks from '../../../../components/NationalInternetChecks.astro';
import { breadcrumbLd, jpDate } from '../../../../lib/data';
import { getExistingMunicipalityPath, getMunicipalityKindLabel, getMunicipalityPath, getMunicipalityPrimaryPath, getPrefecturePath, nationalAreaSource, nttAreaChecks, prefectures, type NationalMunicipality, type NationalPrefecture } from '../../../../lib/national-areas';
import { SITE } from '../../../../site.config.mjs';

export function getStaticPaths() {
  return prefectures.flatMap((p) => p.municipalities.map((m) => ({ params: { prefecture: p.code, municipality: m.code }, props: { p, m } })));
}
const { p, m } = Astro.props as { p: NationalPrefecture; m: NationalMunicipality };
const ntt = nttAreaChecks[p.nttRegion];
const parentCity = m.parentCityCode ? p.municipalities.find((city) => city.code === m.parentCityCode) : undefined;
const wards = p.municipalities.filter((ward) => ward.parentCityCode === m.code);
const otherMunicipalities = p.municipalities.filter((other) => other.code !== m.code && other.kind !== 'designated-ward').slice(0, 8);
const existingDetail = getExistingMunicipalityPath(p, m);
const sourceDate = nationalAreaSource.asOf ?? nationalAreaSource.checkedAt;
const crumbs = [{ name: '総合トップ', href: '/' }, { name: '全国の提供エリア確認', href: '/hikari/area/' }, { name: p.name, href: getPrefecturePath(p) }, { name: m.name, href: getMunicipalityPath(p, m) }];
---
<Base title={`${p.name}${m.name}のWi-Fi・光回線｜公式の住所別エリア確認`} description={`${p.name}${m.name}でネット回線を探す方へ。${ntt.name}を原則とする確認先、光回線・ホームルーターの公式エリア案内、戸建てと集合住宅の確認手順を掲載。市区町村名だけでは提供可否は確定しません。`} pr={false} noindex jsonLd={[breadcrumbLd(SITE.url, crumbs)]}>
  <div class="municipality-area-page site-container">
    <Breadcrumbs items={crumbs.map((c, i) => i === crumbs.length - 1 ? { name: c.name } : c)} />
    <header class="municipality-area-header">
      <p class="area-eyebrow">{p.name} / ネット回線の住所確認</p>
      <h1>{m.name}のWi-Fi・光回線を、<br class="desktop-break" />使う住所で確かめる</h1>
      <p>{m.name}という地域名だけでは、利用できる回線やプランは決まりません。番地と建物の設備まで確かめて、候補を絞りましょう。</p>
      <div class="municipality-header-actions">
        <a class="official-jump" href="#official-area-check">公式のエリア確認へ進む</a>
        <a class="official-jump diagnosis-jump" href={`/shindan/?prefecture=${p.code}&municipality=${m.code}`}>{m.name}で回線・スマホを診断する</a>
      </div>
    </header>
    <ConnectivityManga story="area" context={`${p.name} ${m.name}`} comparisonHref="#official-area-check" diagnosisHref={`/shindan/?prefecture=${p.code}&municipality=${m.code}#diagnosis-form`} />
    <section class="municipality-facts" aria-labelledby="municipality-facts-title">
      <h2 id="municipality-facts-title">確認する地域</h2>
      <dl>
        <div><dt>都道府県・市区町村</dt><dd>{p.name} {m.countyName ? `${m.countyName} ` : ''}{m.name}<span>{getMunicipalityKindLabel(m)} / 公的な地域コード {m.code}</span></dd></div>
        <div><dt>光回線設備の原則の確認先</dt><dd>{ntt.name}<span>県境などの一部地域は区分が異なるため、最後は住所で確認します。</span></dd></div>
      </dl>
      {parentCity && <p>この行政区は{parentCity.name}内です。<a href={getMunicipalityPrimaryPath(p, parentCity)}>{parentCity.name}全体の確認ページを見る</a></p>}
    </section>
    {existingDetail && <aside class="existing-area-detail"><h2>{m.name}の詳しい地域情報もあります</h2><p>この地域の既存ページでは、公式の提供エリア情報と回線の選び方をまとめています。</p><a href={existingDetail}>{m.name}の地域情報・選び方を見る</a></aside>}
    {wards.length > 0 && <section class="city-wards" aria-labelledby="city-wards-title"><h2 id="city-wards-title">{m.name}の行政区から選ぶ</h2><ul>{wards.map((ward) => <li><a href={getMunicipalityPath(p, ward)}>{ward.name}</a></li>)}</ul></section>}
    <NationalInternetChecks region={p.nttRegion} />
    <section class="address-preparation" aria-labelledby="address-preparation-title">
      <h2 id="address-preparation-title">公式検索の前に、手元でそろえるもの</h2>
      <p>詳しい住所はこのページに入力しません。公式サイトの検索フォームで、次の情報を確認してください。</p>
      <ol>
        <li><h3>利用する場所の住所</h3><p>郵便番号、町名・番地、建物名と部屋番号。引越しの場合は新しい住所で検索します。</p></li>
        <li><h3>建物に入っている回線</h3><p>マンション・アパートは、管理会社に導入済みの回線と部屋までの配線方式を確認します。</p></li>
        <li><h3>希望プランと工事の可否</h3><p>1ギガ・10ギガなど希望するプランを指定し、工事が必要か、賃貸で許可が必要かを窓口と管理会社に確認します。</p></li>
      </ol>
    </section>
    <section class="municipality-next" aria-labelledby="municipality-next-title">
      <h2 id="municipality-next-title">確認結果に合わせて、次に見ること</h2>
      <div><article><h3>光回線を利用できる場合</h3><p>月額だけでなく、必要なオプション・工事費・開通日・やめるときの支払いも見積りに入れて比べます。</p></article><article><h3>光回線の工事が難しい場合</h3><p>公式の電波エリアと設置住所の申込み可否を確認します。ホームルーターの端末代や途中解約時の残額も比較してください。</p></article></div>
    </section>
    <section class="other-municipalities" aria-labelledby="other-municipalities-title">
      <h2 id="other-municipalities-title">{p.name}のほかの市区町村を探す</h2>
      <ul>{otherMunicipalities.map((other) => <li><a href={getMunicipalityPrimaryPath(p, other)}>{other.name}</a></li>)}</ul>
      <a class="all-municipalities-link" href={`${getPrefecturePath(p)}#municipality-directory-title`}>{p.name}の全市区町村・行政区を名前で探す</a>
    </section>
    <section class="municipality-sources" aria-labelledby="municipality-sources-title">
      <h2 id="municipality-sources-title">名称の出典と掲載範囲</h2>
      <p>地域名とコードは、<a href={nationalAreaSource.url} target="_blank" rel="noopener">{nationalAreaSource.label ?? '公的な市区町村情報'}</a>{sourceDate ? `（${jpDate(sourceDate)}時点）` : ''}をもとに掲載しています。このページは公式の住所確認先を案内するもので、地域内の全住所での提供・通信速度・料金を保証するものではありません。</p>
      <a href={getPrefecturePath(p)}>{p.name}の確認先・出典一覧に戻る</a>
    </section>
  </div>
</Base>
<style>
  .municipality-header-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:19px}.municipality-header-actions .official-jump{margin-top:0}.municipality-header-actions .diagnosis-jump{background:#fff;color:#175d50;border:1px solid #175d50}.municipality-header-actions .diagnosis-jump:hover{background:#edf4ef}@media(max-width:600px){.municipality-header-actions{display:grid;grid-template-columns:1fr}}
  .municipality-area-page{max-width:1040px;padding-top:26px;padding-bottom:28px}.municipality-area-header{max-width:920px}.area-eyebrow{font-size:14px;font-weight:700;color:#175d50;margin:20px 0 8px}.municipality-area-header h1{font-size:clamp(26px,3.1vw,36px);font-weight:800;line-height:1.55}.municipality-area-header>p:last-of-type{font-size:16px;line-height:1.95;color:#4b6055;margin-top:15px}.official-jump{display:inline-flex;align-items:center;justify-content:center;min-height:48px;border-radius:6px;background:#175d50;color:#fff;font-size:15px;font-weight:700;line-height:1.7;padding:12px 20px;margin-top:19px}.official-jump:hover{background:#103c36}.municipality-facts{border:1px solid #cfdfd5;border-radius:8px;background:#fff;padding:23px;margin-top:28px}.municipality-facts h2{font-size:22px;font-weight:700;line-height:1.6}.municipality-facts dl{display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:16px;margin-top:14px}.municipality-facts dl>div{background:#f3f7f4;border-radius:5px;padding:16px}.municipality-facts dt{font-size:14px;color:#546b5b}.municipality-facts dd{font-size:20px;font-weight:700;line-height:1.6;margin-top:5px}.municipality-facts dd span{display:block;font-size:13px;font-weight:400;line-height:1.8;color:#596e60;margin-top:5px}.municipality-facts>p{font-size:15px;line-height:1.9;color:#506658;margin-top:15px}.municipality-facts a{color:#175d50;text-decoration:underline}.existing-area-detail{background:#edf5ef;border:1px solid #c5dace;border-radius:7px;padding:21px;margin-top:24px}.existing-area-detail h2{font-size:20px;font-weight:700;line-height:1.65}.existing-area-detail p{font-size:15px;line-height:1.9;margin:10px 0}.existing-area-detail a{display:inline-block;min-height:44px;padding:9px 0;font-size:15px;font-weight:700;color:#175d50;text-decoration:underline;text-underline-offset:4px}.city-wards,.address-preparation,.municipality-next,.other-municipalities{margin-top:36px}.city-wards h2,.address-preparation h2,.municipality-next h2,.other-municipalities h2{font-size:25px;font-weight:800;line-height:1.6}.city-wards ul,.other-municipalities ul{display:flex;flex-wrap:wrap;gap:10px;list-style:none;padding:0;margin:17px 0 0}.city-wards a,.other-municipalities li a{display:block;min-height:44px;border:1px solid #d1dfd5;border-radius:5px;background:#fff;padding:10px 14px;font-size:15px;line-height:1.65;color:#175d50}.address-preparation>p{font-size:16px;line-height:1.9;color:#506658;margin:10px 0 17px}.address-preparation ol{list-style:decimal;padding-left:25px;margin:0}.address-preparation li{padding-left:5px;margin-top:18px}.address-preparation li::marker{font-weight:700;color:#175d50}.address-preparation h3{font-size:18px;font-weight:700;line-height:1.7}.address-preparation li p{font-size:16px;line-height:1.9;color:#526659;margin-top:6px}.municipality-next>div{display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:16px;margin-top:17px}.municipality-next article{border:1px solid #d2e0d6;border-radius:7px;background:#fff;padding:20px}.municipality-next h3{font-size:18px;font-weight:700;line-height:1.7}.municipality-next article p{font-size:16px;line-height:1.9;color:#526659;margin-top:8px}.all-municipalities-link{display:inline-block;min-height:44px;font-size:15px;font-weight:700;line-height:1.8;color:#175d50;text-decoration:underline;text-underline-offset:4px;padding:10px 0;margin-top:15px}.municipality-sources{margin-top:36px;border-top:1px solid #d4dfd7;padding-top:24px;color:#53685a;font-size:14px;line-height:1.9}.municipality-sources h2{font-size:18px;font-weight:700;margin-bottom:12px}.municipality-sources a{color:#175d50;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}.municipality-sources>a{display:inline-block;padding:10px 0;margin-top:10px}@media(max-width:600px){.municipality-area-page{padding-top:20px}.municipality-area-header h1{font-size:27px}.desktop-break{display:none}.official-jump{display:flex}.municipality-facts{padding:18px}.municipality-facts dl,.municipality-next>div{grid-template-columns:1fr}.city-wards h2,.address-preparation h2,.municipality-next h2,.other-municipalities h2{font-size:22px}.municipality-next article{padding:18px}}
</style>
