---
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import NationalInternetChecks from '../../../../components/NationalInternetChecks.astro';
import NationalMunicipalityList from '../../../../components/NationalMunicipalityList.astro';
import { breadcrumbLd, jpDate } from '../../../../lib/data';
import { getPrefecturePath, nationalAreaReferenceSources, nationalAreaSource, nttAreaChecks, prefectures, type NationalPrefecture } from '../../../../lib/national-areas';
import { SITE } from '../../../../site.config.mjs';

export function getStaticPaths() {
  return prefectures.map((p) => ({ params: { prefecture: p.code }, props: { p } }));
}
const { p } = Astro.props as { p: NationalPrefecture };
const ntt = nttAreaChecks[p.nttRegion];
const crumbs = [{ name: '総合トップ', href: '/' }, { name: '全国の提供エリア確認', href: '/hikari/area/' }, { name: p.name, href: getPrefecturePath(p) }];
const sourceLabel = nationalAreaSource.label ?? nationalAreaSource.title ?? '公的な市区町村情報';
const sourceDate = nationalAreaSource.asOf ?? nationalAreaSource.checkedAt;
---
<Base title={`${p.name}のWi-Fi・光回線エリア確認｜市区町村から公式窓口を探す`} description={`${p.name}の市区町村・行政区を公的データで掲載。${ntt.name}を原則とする確認先、光回線とホームルーターの公式エリア案内、建物ごとの確認手順をまとめました。`} pr={false} jsonLd={[breadcrumbLd(SITE.url, crumbs)]}>
  <div class="national-area-page site-container">
    <Breadcrumbs items={crumbs.map((c, i) => i === crumbs.length - 1 ? { name: c.name } : c)} />
    <header class="national-area-header">
      <p class="area-eyebrow">全国のネット回線・Wi-Fiのエリア確認</p>
      <h1>{p.name}で使える回線を、<br class="desktop-break" />市区町村と住所から確かめる</h1>
      <p>光回線やホームルーターは、同じ{p.name}でも住所・建物・契約するプランによって使えるものが変わります。まず市区町村を選び、公式の住所検索で確認しましょう。</p>
      <nav class="area-jump-links" aria-label="このページの案内">
        <a href="#municipality-directory-title">市区町村から探す</a>
        <a href="#official-area-check">公式のエリア検索へ</a>
        <a href="#building-check">建物ごとの確認方法</a>
      </nav>
    </header>
    <section class="prefecture-summary" aria-labelledby="prefecture-summary-title">
      <h2 id="prefecture-summary-title">{p.name}の確認先</h2>
      <dl>
        <div><dt>光回線設備の原則の確認先</dt><dd>{ntt.name}<span>県境など一部地域は営業区域が異なります。</span></dd></div>
        <div><dt>掲載する市区町村・行政区</dt><dd>{p.municipalities.length}件<span>政令指定都市は市全体と区をそれぞれ掲載。</span></dd></div>
      </dl>
      <p>光回線の1ギガと10ギガ、ホームルーターの4Gと5Gは同じ提供範囲とは限りません。希望するプランを指定して確認してください。</p>
    </section>
    <NationalMunicipalityList prefecture={p} />
    <NationalInternetChecks region={p.nttRegion} />
    <section id="building-check" class="building-check" aria-labelledby="building-check-title">
      <h2 id="building-check-title">住所の確認後は、建物の設備を確認する</h2>
      <div>
        <article><h3>戸建て</h3><p>敷地へ回線を引き込めるか、必要な工事と希望する開通日を窓口に確認します。提供エリア内でも、設備の状況によって利用できない場合があります。</p></article>
        <article><h3>マンション・アパート</h3><p>管理会社に導入済みの回線と部屋までの配線方式を確認します。新しい工事が必要なら、建物側の許可も確かめてください。</p></article>
      </div>
    </section>
    {p.code === '46' && <aside class="kagoshima-detail"><h2>鹿児島県の詳しい地域情報</h2><p>既存の地域ページでは、公式情報をもとに10ギガや離島での確認方法もまとめています。</p><a href="/hikari/">鹿児島県の光回線比較を見る</a><a href="/hikari/area/ritou/">奄美・種子島・屋久島などの確認方法を見る</a></aside>}
    <section class="national-sources" aria-labelledby="area-source-title">
      <h2 id="area-source-title">一覧の出典と確認範囲</h2>
      <p>市区町村・行政区の名称とコードは、<a href={nationalAreaSource.url} target="_blank" rel="noopener">{sourceLabel}</a>{sourceDate ? `（${jpDate(sourceDate)}時点）` : ''}をもとに掲載しています。回線の提供可否を示すデータではありません。</p>
      <ul>{nationalAreaReferenceSources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
      <a class="back-to-areas" href="/hikari/area/">全国の都道府県一覧へ</a>
    </section>
  </div>
</Base>
<style>
  .national-area-page{max-width:1040px;padding-top:26px;padding-bottom:28px}.national-area-header{max-width:920px}.area-eyebrow{font-size:14px;font-weight:700;color:#175d50;margin:20px 0 8px}.national-area-header h1{font-size:clamp(26px,3.1vw,36px);font-weight:800;line-height:1.55}.national-area-header>p:last-of-type{font-size:16px;line-height:1.95;color:#4b6055;margin-top:15px}.area-jump-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}.area-jump-links a{display:flex;align-items:center;justify-content:center;min-height:44px;background:#edf4ef;border:1px solid #ccded2;border-radius:5px;padding:9px 14px;color:#175d50;font-size:14px;font-weight:700}.prefecture-summary{border:1px solid #cfdfd5;border-radius:8px;background:#fff;padding:23px;margin-top:28px}.prefecture-summary h2{font-size:22px;font-weight:700;line-height:1.6}.prefecture-summary dl{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:14px}.prefecture-summary dl>div{background:#f3f7f4;border-radius:5px;padding:16px}.prefecture-summary dt{font-size:14px;color:#546b5b}.prefecture-summary dd{font-size:23px;font-weight:700;line-height:1.6;margin-top:5px}.prefecture-summary dd span{display:block;font-size:13px;font-weight:400;line-height:1.8;color:#596e60;margin-top:5px}.prefecture-summary>p{font-size:14px;line-height:1.9;color:#5b6b60;margin-top:15px}.building-check{margin-top:36px}.building-check h2{font-size:25px;font-weight:800;line-height:1.6}.building-check>div{display:grid;grid-template-columns:1fr 1fr;align-items:start;gap:16px;margin-top:16px}.building-check article{border:1px solid #d3e0d7;border-radius:7px;background:#fff;padding:20px}.building-check h3{font-size:19px;font-weight:700;line-height:1.6}.building-check p{font-size:16px;line-height:1.9;color:#506358;margin-top:9px}.kagoshima-detail{border:1px solid #cddfd2;border-radius:7px;background:#edf5ef;padding:22px;margin-top:32px}.kagoshima-detail h2{font-size:20px;font-weight:700;line-height:1.6}.kagoshima-detail p{font-size:15px;line-height:1.9;margin:10px 0}.kagoshima-detail a{display:block;font-size:15px;line-height:1.8;color:#175d50;text-decoration:underline;text-underline-offset:4px;padding:8px 0}.national-sources{margin-top:36px;border-top:1px solid #d4dfd7;padding-top:24px;color:#53685a;font-size:14px;line-height:1.9}.national-sources h2{font-size:18px;font-weight:700;margin-bottom:12px}.national-sources ul{list-style:disc;padding-left:20px;margin:14px 0}.national-sources a{color:#175d50;text-decoration:underline;text-underline-offset:3px;overflow-wrap:anywhere}.back-to-areas{display:inline-block;padding:9px 0;margin-top:10px;font-size:15px;font-weight:700}@media(max-width:600px){.national-area-page{padding-top:20px}.national-area-header h1{font-size:27px}.desktop-break{display:none}.area-jump-links{display:grid;grid-template-columns:1fr;gap:8px}.prefecture-summary{padding:18px}.prefecture-summary dl{grid-template-columns:1fr}.building-check h2{font-size:22px}.building-check>div{grid-template-columns:1fr}.building-check article{padding:18px}}
</style>
