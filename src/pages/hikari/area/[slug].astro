---
import Base from '../../../layouts/Base.astro';
import ConnectivityManga from '../../../components/ConnectivityManga.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { SITE } from '../../../site.config.mjs';
import { areas, providers, carrierGuide, byId, breadcrumbLd, type Area } from '../../../lib/data';
import { prefectures, getExistingMunicipalityPath, nttAreaChecks } from '../../../lib/national-areas';

export function getStaticPaths() {
  return areas.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: Area };
const crumbs = [{ name: 'ホーム', href: '/' }, { name: '鹿児島県の光回線', href: '/hikari/kagoshima/' }, { name: '地域別', href: '/hikari/area/' }, { name: a.name, href: `/hikari/area/${a.slug}/` }];
const others = areas.filter((o) => o.slug !== a.slug);
const isIsland = a.slug === 'ritou';
const kagoshimaPrefecture = prefectures.find(p=>p.code==='46')!;
const municipality = kagoshimaPrefecture.municipalities.find(m=>getExistingMunicipalityPath(kagoshimaPrefecture,m)===`/hikari/area/${a.slug}/`);
const diagnosisHref = `/shindan/?prefecture=46${municipality ? '&municipality='+municipality.code : ''}#diagnosis-form`;
const islandNote = (id: string) => (isIsland && id === 'bbiq' ? '（離島は要エリア確認）' : '');
const title = `${a.name}の光回線おすすめ｜使える回線・10ギガ・選び方`;
const description = `${a.name}で使える光回線とホームルーターを、公式の提供エリア情報をもとにまとめました。${a.tenGiga ? '10ギガが使える地域かどうか、' : ''}スマホ会社別の選び方と、申込み前に確認することを紹介します。`;
---
<Base title={title} description={description} jsonLd={[breadcrumbLd(SITE.url, crumbs)]} pr={false}>
  <div class="mx-auto max-w-3xl px-4 pt-8">
    <Breadcrumbs items={crumbs.map((c, i) => (i === crumbs.length - 1 ? { name: c.name } : c))} />
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-snug">{a.name}の光回線の選び方</h1>
    <p class="mt-4 text-[15px] leading-8">{a.lead}</p>
    <ConnectivityManga story="area" context={a.name} comparisonHref="#area-verification" diagnosisHref={diagnosisHref} />
    <section id="area-verification" class="mt-7 rounded-xl border border-brand-100 bg-brand-50 p-5" aria-labelledby="area-verification-title"><h2 id="area-verification-title" class="text-lg font-bold">まず、{a.name}の住所で公式の提供エリアを確認</h2><p class="mt-3 text-[15px] leading-8">市区町村内でも、番地・建物・希望プランで利用可否は変わります。詳しい住所は、このページではなく公式サイトの検索で確認してください。</p><div class="mt-4 grid gap-3 sm:grid-cols-2"><a href={nttAreaChecks.west.url} target="_blank" rel="noopener" class="rounded-lg bg-brand-600 px-4 py-3 text-center font-bold text-white">NTT西日本で住所を確認</a><a href="/hikari/area/46/#official-area-check" class="rounded-lg border border-brand-600 bg-white px-4 py-3 text-center font-bold text-brand-700">鹿児島県の各社公式確認先を見る</a></div><p class="mt-4 text-sm leading-7"><a href={diagnosisHref} class="font-bold text-brand-700 underline underline-offset-4">住所の確認後に、家族の回線・スマホを診断する</a></p></section>


    <div class="prose-ja">
      {a.sections.map((s) => (
        <>
          <h2>{s.title}</h2>
          {s.body.map((b) => <p>{b}</p>)}
        </>
      ))}

      <h2>スマホ会社別のおすすめ</h2>
      <table>
        <thead><tr><th>スマホ</th><th>候補</th></tr></thead>
        <tbody>
          {carrierGuide.map((c) => (
            <tr><th>{c.label}</th><td>{c.ids.map((id) => byId(id)).filter(Boolean).map((p, i) => (
              <>{i > 0 && '、'}<a href={`/hikari/${p!.id}/`}>{p!.name}</a>{islandNote(p!.id)}</>
            ))}</td></tr>
          ))}
        </tbody>
      </table>

      <h2>申込み前に確認すること</h2>
      <ol>
        <li>各社の公式サイトで、住所（郵便番号）を入れて提供エリアを確認する</li>
        <li>マンション・アパートなら、建物に入っている設備と工事の可否を管理会社に聞く</li>
        <li>スマホのセット割の条件（対象のプラン、オプションへの加入など）を確認する</li>
      </ol>
      <p class="text-xs text-gray-500">{a.sourceNote}（2026年11月21日に確認）</p>
    </div>

    <section class="mt-10">
      <h2 class="text-lg font-bold text-gray-900 mb-3">{isIsland ? 'くらべられる主なサービス' : `${a.name}で使える主なサービス`}</h2>
      <ul class="grid gap-2 sm:grid-cols-2">
        {providers.map((p) => (
          <li><a href={`/hikari/${p.id}/`} class="block rounded-lg border border-gray-200 px-4 py-3 hover:border-brand-600 transition">
            <span class="font-bold">{p.name}</span><span class="text-xs text-amber-700">{islandNote(p.id)}</span>
            <span class="block text-xs text-gray-500">{p.kind === 'router' ? '工事なし・' : ''}戸建て {p.house?.label ?? '—'}</span>
          </a></li>
        ))}
      </ul>
      <p class="mt-2 text-xs text-gray-500">※住所によっては使えないサービスがあります。</p>
    </section>

    <section class="mt-10">
      <h2 class="text-lg font-bold text-gray-900 mb-3">ほかの地域</h2>
      <ul class="flex flex-wrap gap-2">
        {others.map((o) => <li><a href={`/hikari/area/${o.slug}/`} class="inline-block rounded-full border border-gray-300 px-3 py-1.5 text-sm hover:border-brand-600">{o.name}</a></li>)}
      </ul>
    </section>
  </div>
</Base>
