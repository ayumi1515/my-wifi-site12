---
import Base from '../../layouts/Base.astro';
import ConnectivityManga from '../../components/ConnectivityManga.astro';
import VisualHero from '../../components/VisualHero.astro';
import InternetVisualGuide from '../../components/InternetVisualGuide.astro';
import RelatedConnectivityLinks from '../../components/RelatedConnectivityLinks.astro';
import ProviderCard from '../../components/ProviderCard.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import InternetFinder from '../../components/InternetFinder.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../site.config.mjs';
import { ranked, byId, areas, faqs, jpDate, lastChecked, breadcrumbLd } from '../../lib/data';
import { prefectures, getPrefecturePath, getMunicipalityPath, getMunicipalitySearchText, nationalServiceChecks, nttAreaChecks, nationalAreaSource } from '../../lib/national-areas';
const fiberAll = ranked('house', 'fiber');
const quick = [
  { id: 'bbiq', audience: 'au・UQ mobile ＋ 九州電力', reason: '九州電力とまとめる戸建てなら', note: '表示額は13カ月目以降。3年自動更新・電気との割引を含みます。' },
  { id: 'docomo-hikari', audience: 'ドコモの対象プラン', reason: '家族のドコモ回線をまとめるなら', note: '1ギガ・タイプA・2年定期。ahamoはスマホのセット割対象外です。' },
  { id: 'softbank-hikari', audience: 'ソフトバンク・ワイモバイル', reason: 'おうち割を使うなら', note: '1ギガ・2年自動更新。セット割は指定オプションが別途必要です。' },
].map(item => ({ ...item, provider: byId(item.id)! }));
const title = '全国の光回線・Wi-Fi比較｜都道府県と家族の使い方から選ぶ';
const description = '全国47都道府県・市区町村から、光回線とホームルーターの公式エリア確認先へ。地域、家族のキャリア・回線数・使う年数から組合せを診断できます。鹿児島県の詳しい比較は、地域を選択した場合に表示します。';
const regionChoices = prefectures.map(p=>({code:p.code,name:p.name,nttRegion:p.nttRegion,path:getPrefecturePath(p),municipalities:p.municipalities.map(m=>({code:m.code,name:m.name,countyName:m.countyName,parentCityName:m.parentCityName,path:getMunicipalityPath(p,m),search:getMunicipalitySearchText(p,m)}))}));
const setNames = (list: string[]) => [...new Set(list.map(s => s.replace(/（[^（）]*）$/, '')))].join('・');
---
<Base title={title} description={description} jsonLd={[breadcrumbLd(SITE.url, [{name:'総合トップ',href:'/'},{name:'通信・ネット',href:'/hikari/'}])]}>
  <div class="comparison-page">
    <header class="comparison-header site-container">
      <Breadcrumbs items={[{name:'総合トップ',href:'/'},{name:'通信・ネット'}]} />
      <VisualHero title={"全国の光回線を、\n住む地域から選ぶ。"} lead="47都道府県・市区町村から提供エリアを確認。家族のスマホ・回線数・使う年数も合わせて、候補を比べられます。" image="internet" eyebrow="全国の通信回線・Wi-Fi"><a class="region-start" href="#regional-choice">使う地域を選ぶ</a></VisualHero>
      <p class="updated">提供可否は、住所・建物・希望プランごとに確認してください。／ <a href="/about/">編集方針</a></p>
    </header>

    <div class="site-container"><ConnectivityManga story="national" context="都道府県を選び、住所ごとの提供確認と家族の通信費の診断へ進みます。地域名だけで使える回線を確定しません。" comparisonHref="#regional-choice" diagnosisHref="/shindan/#diagnosis-form" /></div>

    <section id="regional-choice" class="site-container national-choice" aria-labelledby="national-choice-title" data-national-chooser data-regions={JSON.stringify(regionChoices)} data-ntt={JSON.stringify(nttAreaChecks)}>
      <div class="region-choice-heading"><p>自分の地域から、比較を始める</p><h2 id="national-choice-title">まず、使う都道府県を選んでください</h2><p>地域名だけでは利用できる回線は決まりません。公式の住所確認と、家族の通信費の診断へ進みましょう。</p></div>
      <div class="region-fields"><div><label for="hikari-prefecture">都道府県 <span>必須</span></label><select id="hikari-prefecture" name="prefecture"><option value="">都道府県を選んでください</option>{prefectures.map(p=><option value={p.code}>{p.name}</option>)}</select></div><div><label for="hikari-city-query">市区町村名で検索 <span>任意</span></label><input id="hikari-city-query" type="search" autocomplete="off" placeholder="都道府県を先に選んでください" aria-controls="hikari-city-results" disabled /></div></div>
      <div class="city-search-results" hidden data-city-search-results><p data-city-search-status role="status" aria-live="polite"></p><ul id="hikari-city-results"></ul></div>
      <p class="region-selection-status" role="status" aria-live="polite" aria-atomic="true" data-region-status>都道府県を選ぶと、診断とエリア確認へ進めます。</p>
      <div class="region-actions"><a role="link" aria-disabled="true" tabindex="-1" class="region-diagnose" data-region-diagnose>回線・家族の通信費を診断する</a><a role="link" aria-disabled="true" tabindex="-1" class="region-area" data-region-area>市区町村からエリアを確認する</a></div>
      <div class="selected-official" hidden data-selected-official><h3 data-selected-official-title></h3><a target="_blank" rel="noopener" data-selected-official-link></a><p>NTT東西の原則の確認先です。県境など一部地域は区分が異なるため、公式検索の案内に従ってください。</p></div>
      <details class="all-prefectures"><summary>47都道府県の一覧から直接進む</summary><p>市区町村の一覧と公式のエリア確認先を掲載しています。JavaScriptを使わない場合も、こちらから進めます。</p><ul>{prefectures.map(p=><li><a href={getPrefecturePath(p)}>{p.name}</a></li>)}</ul><p class="area-source">名称・コードの出典：<a href={nationalAreaSource.url} target="_blank" rel="noopener">e-Stat 市区町村コード</a></p></details>
    </section>

    <section class="site-container national-options" aria-labelledby="national-options-title"><h2 id="national-options-title">候補は、住所ごとの提供エリアから確認</h2><p class="national-option-lead">光回線の設備が使えるか、設置場所で電波が届くかを確認してから、料金と契約条件を比べます。以下の掲載は全国の全住所で利用できることを示すものではありません。</p><div class="national-options-grid">{nationalServiceChecks.map(service=><article><p>{service.kind==='fiber'?'光回線':'工事なしのホームルーター'}</p><h3>{service.name}</h3><p>{service.note}</p><a href={service.url} target="_blank" rel="noopener">公式のエリア確認先を見る</a></article>)}</div><p class="national-option-note">自宅回線と携帯のセット割、家族割、利用予定の年数をまとめて比べたい場合は、上で地域を選び、回線・家族通信費の診断をご利用ください。</p></section>

    <div data-kagoshima-content hidden aria-label="鹿児島県の詳しい比較">
    <section class="site-container kagoshima-heading"><p>鹿児島県を選択中</p><h2>鹿児島県の詳しい比較</h2><p>ここから下は、鹿児島県の提供条件・料金例です。全国共通の利用可否や料金の順位を示すものではありません。</p><p class="updated">料金は税込・最終確認 {jpDate(lastChecked)} ／ <a href="#criteria">鹿児島県の比較基準</a></p></section>
    <section class="site-container quick-section" aria-labelledby="quick">
      <h2 id="quick" class="sr-only">スマホ別の3候補</h2>
      <div class="quick-grid">
        {quick.map(({provider:p,...item}) => <article class="quick-card">
          <p class="audience">{item.audience}</p><h3>{p.name}</h3>
          <p class="quick-price"><span>戸建て月額</span><strong>{p.house?.label}</strong></p>
          <p class="condition">{item.note}</p>
          {p.campaign && <aside class="campaign-note"><strong>{p.campaign.label}</strong><p>戸建限定・6カ月内開通・8カ月継続・口座登録</p><details><summary>還元条件の詳細</summary><p>{p.campaign.detail}</p><a href={p.campaign.url} target="_blank" rel="noopener">還元条件の出典 ↗</a></details></aside>}<AffiliateButton provider={p} building="house" />
          <a class="details-link" href={`/hikari/${p.id}/`}>料金条件・注意点を詳しく見る →</a>
        </article>)}
      </div>
      <nav class="jump-links" aria-label="比較したい内容へ"><a href="#compare">5社の料金を比べる ↓</a><a href="#finder">自分の条件で選ぶ ↓</a><a href="/guides/hikari-one-year/">1年だけ使う場合 →</a></nav>
    </section>

    <section id="compare" class="site-container compare-section" aria-labelledby="compare-title" data-building-comparison>
      <div class="section-head"><h2 id="compare-title">光回線5社を、同じ項目で比較</h2><p>月額に加えて、セット割の条件と工事費も比べましょう。</p></div>
      <div class="building-tabs" role="group" aria-label="料金を表示する建物"><button type="button" data-building-button="house" aria-pressed="true">戸建て</button><button type="button" data-building-button="mansion" aria-pressed="false">マンション・アパート</button></div>
      <p class="table-hint">表は横にスクロールできます →</p>
      <div class="comparison-table-wrap" tabindex="0" role="region" aria-label="光回線の料金と条件の比較表">
        <table class="comparison-table"><caption class="sr-only">鹿児島の光回線5社、1ギガの料金と契約条件</caption>
          <thead><tr><th scope="col">サービス</th><th scope="col">月額・表示条件</th><th scope="col">スマホ割・契約</th><th scope="col">初期費用・注意点</th><th scope="col">申込み・詳しい条件</th></tr></thead>
          <tbody>{fiberAll.map(p => <tr>
            <th scope="row"><a href={`/hikari/${p.id}/`}>{p.name}</a><span>{p.network}</span></th>
            <td>{(['house','mansion'] as const).map(building => <div data-for-building={building} hidden={building!=='house'}><strong class="table-price">{p[building]?.label ?? '—'}</strong><p>{p[building]?.note}</p></div>)}</td>
            <td><strong>{p.mobileSet.length ? setNames(p.mobileSet) : 'セット割なし'}</strong><p>{p.contract}</p></td>
            <td><p>{p.initialCost}</p><p class="table-caution">{p.cautions[0]}</p></td>
            <td>{p.id==='bbiq' ? <><div data-for-building="house">{p.campaign && <aside class="campaign-note"><strong>{p.campaign.label}</strong><p>{p.campaign.detail}</p></aside>}<AffiliateButton provider={p} building="house" showBanner={false} /></div><div data-for-building="mansion" hidden><a class="official-action" href={p.officialUrl} target="_blank" rel="noopener">BBIQ公式で建物の条件を見る ↗</a></div></> : <AffiliateButton provider={p} showBanner={false} />}<a class="details-link" href={`/hikari/${p.id}/`}>条件を詳しく見る →</a></td>
          </tr>)}</tbody>
        </table>
      </div>
      <p class="comparison-note">BBIQの表示額は電気などの割引条件を含みます。フレッツ光はプロバイダ料金が別途必要です。SoftBank 光は2026年12月以降に料金改定があり、契約によって適用月が異なります。月額だけでなく、必要オプション・工事費の残額も含めて判断してください。</p>
    </section>

    <div class="site-container finder-section"><InternetFinder /></div>
    <div class="site-container connection-visual-section"><InternetVisualGuide /></div>

    <section class="site-container route-section" aria-labelledby="routes"><h2 id="routes">迷っているポイントから選ぶ</h2><div class="route-grid"><a href="/guides/bbiq-vs-docomo-hikari/"><span>2社で迷う</span><strong>BBIQとドコモ光を比較</strong><p>スマホ・10ギガ・工事の違いで選ぶ</p><b aria-hidden="true">→</b></a><a href="/guides/bbiq-vs-biglobe-hikari/"><span>au・UQ mobile</span><strong>BBIQとビッグローブ光を比較</strong><p>電気割引・今の回線・契約期間で選ぶ</p><b aria-hidden="true">→</b></a><a href="/guides/hikari-one-year/"><span>短期で使いたい</span><strong>1年だけ使う場合の選び方</strong><p>解約時までの総額と短期向け候補を見る</p><b aria-hidden="true">→</b></a><a href="/hikari/home-router/"><span>工事ができない</span><strong>ホームルーターを比較</strong><p>月額と端末代・電波の条件を確認する</p><b aria-hidden="true">→</b></a></div></section>

    <div class="site-container"><RelatedConnectivityLinks /></div>

    <section class="site-container detail-section" aria-labelledby="ranking"><h2 id="ranking">候補が決まったら、契約条件を詳しく見る</h2><p class="section-description">料金の内訳、向く人と注意点をサービスごとにまとめています。</p><div class="provider-details">{fiberAll.map(p => <details><summary><span>{p.name}</span><span class="summary-price">戸建て {p.house?.label}</span><span aria-hidden="true">＋</span></summary><div class="provider-detail-body"><ProviderCard provider={p} building="house" /></div></details>)}</div></section>

    <section class="site-container area-section" aria-labelledby="areas"><h2 id="areas">住所のエリアが気になる人へ</h2><p class="section-description">10ギガや離島は、同じ市町でも住所・建物によって利用可否が変わります。</p><ul class="area-grid">{areas.map(a=><li><a href={`/hikari/area/${a.slug}/`}><strong>{a.name}</strong><span>{a.tenGiga?'10ギガの提供地域あり':'島・住所ごとの確認方法'} →</span></a></li>)}</ul></section>

    <section class="site-container faq-section" aria-labelledby="faq"><h2 id="faq">よくある質問</h2><div>{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
    <section class="site-container criteria-section" aria-labelledby="criteria"><h2 id="criteria">候補の選び方と料金の調べ方</h2><p>冒頭の3候補は、スマホのセット割を使える組合せで並べています。人気や通信速度の順位ではありません。料金表は公開中の5社を掲載し、条件別フォームはスマホの組合せと表示月額で候補をしぼります。</p><p>住所で使える回線か、必要なオプションを含めた支払いはいくらか、いつまで利用するかで、合う契約は変わります。料金の確認日と公式出典は<a href="#ranking">各社の詳細</a>に掲載しています。実機による速度の比較測定は行っていません。</p><p>auひかりなど、県内の提供条件と料金を確認できていないサービスは掲載していません。離島の人は<a href="/hikari/area/ritou/">離島の確認方法</a>をご覧ください。</p></section>
    </div>
  </div>
</Base>
<script>
  interface RegionChoice {code:string;name:string;nttRegion:'east'|'west';path:string;municipalities:{code:string;name:string;countyName?:string;parentCityName?:string;path:string;search:string}[]}
  const chooser=document.querySelector<HTMLElement>('[data-national-chooser]');
  if(chooser){
    const regions:RegionChoice[]=JSON.parse(chooser.dataset.regions||'[]');
    const ntt:Record<string,{name:string;url:string}>=JSON.parse(chooser.dataset.ntt||'{}');
    const prefecture=chooser.querySelector<HTMLSelectElement>('#hikari-prefecture')!;
    const cityQuery=chooser.querySelector<HTMLInputElement>('#hikari-city-query')!;
    const cityResults=chooser.querySelector<HTMLElement>('[data-city-search-results]')!;
    const cityList=chooser.querySelector<HTMLElement>('#hikari-city-results')!;
    const cityStatus=chooser.querySelector<HTMLElement>('[data-city-search-status]')!;
    const status=chooser.querySelector<HTMLElement>('[data-region-status]')!;
    const diagnose=chooser.querySelector<HTMLAnchorElement>('[data-region-diagnose]')!;
    const area=chooser.querySelector<HTMLAnchorElement>('[data-region-area]')!;
    const official=chooser.querySelector<HTMLElement>('[data-selected-official]')!;
    const officialTitle=chooser.querySelector<HTMLElement>('[data-selected-official-title]')!;
    const officialLink=chooser.querySelector<HTMLAnchorElement>('[data-selected-official-link]')!;
    const kagoshima=document.querySelector<HTMLElement>('[data-kagoshima-content]')!;
    let selectedCity:RegionChoice['municipalities'][number]|null=null;
    const normalise=(value:string)=>value.normalize('NFKC').trim().toLowerCase().replace(/[ァ-ヶ]/g,c=>String.fromCharCode(c.charCodeAt(0)-0x60));
    const setLink=(link:HTMLAnchorElement,href:string|null)=>{if(href){link.href=href;link.removeAttribute('aria-disabled');link.removeAttribute('tabindex');}else{link.removeAttribute('href');link.setAttribute('aria-disabled','true');link.tabIndex=-1;}};
    const updateLinks=()=>{
      const p=regions.find(p=>p.code===prefecture.value);
      if(!p){setLink(diagnose,null);setLink(area,null);diagnose.textContent='回線・家族の通信費を診断する';area.textContent='市区町村からエリアを確認する';status.textContent='都道府県を選ぶと、診断とエリア確認へ進めます。';return;}
      const city=selectedCity&&p.municipalities.some(m=>m.code===selectedCity!.code)?selectedCity:null;
      const place=city?`${p.name} ${city.name}`:p.name;
      setLink(diagnose,`/shindan/?prefecture=${p.code}${city?'&municipality='+city.code:''}#diagnosis-form`);
      setLink(area,city?.path||p.path);
      diagnose.textContent=`${place}で回線・家族の通信費を診断`;
      area.textContent=city?`${city.name}のエリア確認へ進む`:`${p.name}の市区町村からエリア確認`;
      status.textContent=`${place}を選択しました。診断とエリア確認に、この地域を引き継ぎます。`;
    };
    const updateRegion=()=>{
      const p=regions.find(p=>p.code===prefecture.value);cityQuery.disabled=!p;cityQuery.placeholder=p?`${p.name}の市区町村名・読みがな`:'都道府県を先に選んでください';kagoshima.hidden=p?.code!=='46';official.hidden=!p;
      if(p){const target=ntt[p.nttRegion];officialTitle.textContent=`${p.name}の原則の住所確認先`;officialLink.textContent=`${target.name}で住所を確認する`;officialLink.href=target.url;}
      else{officialTitle.textContent='';officialLink.textContent='';officialLink.removeAttribute('href');}
      updateLinks();
    };
    const searchCities=()=>{
      const p=regions.find(p=>p.code===prefecture.value);const query=normalise(cityQuery.value);selectedCity=null;updateLinks();cityList.replaceChildren();
      if(!p||!query){cityResults.hidden=true;cityStatus.textContent='';return;}
      const matches=p.municipalities.filter(m=>normalise(m.search).includes(query));cityResults.hidden=false;cityStatus.textContent=matches.length?`${matches.length}件見つかりました。${matches.length>8?'先頭8件を表示しています。名前を続けて入力すると絞れます。':'市区町村を選んでください。'}`:'一致する市区町村がありません。読みがなや名前の一部でも試してください。';
      matches.slice(0,8).forEach(m=>{const li=document.createElement('li');const button=document.createElement('button');button.type='button';const label=[m.countyName,m.parentCityName,m.name].filter(Boolean).join(' ');button.textContent=label+'を選ぶ';button.addEventListener('click',()=>{selectedCity=m;cityQuery.value=label;cityResults.hidden=true;updateLinks();});li.append(button);cityList.append(li);});
    };
    prefecture.addEventListener('change',()=>{selectedCity=null;cityQuery.value='';cityResults.hidden=true;cityList.replaceChildren();cityStatus.textContent='';updateRegion();});
    cityQuery.addEventListener('input',searchCities);
    const params=new URLSearchParams(location.search);const initial=regions.find(p=>p.code===params.get('prefecture'));
    const legacyHashes=new Set(['#compare','#finder','#ranking','#areas','#faq','#criteria','#quick']);
    if(initial){prefecture.value=initial.code;selectedCity=initial.municipalities.find(m=>m.code===params.get('municipality'))||null;if(selectedCity)cityQuery.value=[selectedCity.countyName,selectedCity.parentCityName,selectedCity.name].filter(Boolean).join(' ');}
    else if(legacyHashes.has(location.hash))prefecture.value='46';
    updateRegion();
    if(!initial&&prefecture.value==='46'&&legacyHashes.has(location.hash))document.getElementById(location.hash.slice(1))?.scrollIntoView({block:'start'});
    window.addEventListener('hashchange',()=>{if(!legacyHashes.has(location.hash))return;if(prefecture.value!=='46'){prefecture.value='46';selectedCity=null;cityQuery.value='';cityResults.hidden=true;updateRegion();}document.getElementById(location.hash.slice(1))?.scrollIntoView({block:'start'});});
  }
  document.querySelectorAll<HTMLElement>('[data-building-comparison]').forEach(comparison=>{
    const buttons=comparison.querySelectorAll<HTMLButtonElement>('[data-building-button]');
    buttons.forEach(button=>button.addEventListener('click',()=>{
      const selected=button.dataset.buildingButton;
      buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
      comparison.querySelectorAll<HTMLElement>('[data-for-building]').forEach(item=>item.hidden=item.dataset.forBuilding!==selected);
    }));
  });
</script>
<style>
