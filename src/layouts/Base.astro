---
import '../styles/global.css';
import { SITE } from '../site.config.mjs';
import PrNotice from '../components/PrNotice.astro';

interface Props {
  title: string;
  description: string;
  /** 構造化データ（JSON-LD）。配列で複数渡せる */
  jsonLd?: object[];
  /** PR表示を出すか（広告のないページでは false） */
  pr?: boolean;
  noindex?: boolean;
}
const { title, description, jsonLd = [], pr = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title}｜${SITE.name}`;
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url + '/',
  inLanguage: 'ja',
};
const ld = [websiteLd, ...jsonLd];

const nav = [
  { href: '/', label: '総合トップ' },
  { href: '/hikari/', label: '通信・ネット' },
  { href: '/hikari/area/', label: '全国のエリア確認' },
  { href: '/mobile/', label: 'スマホ・関連サービス' },
  { href: '/manga/', label: '漫画で読む' },
  { href: '/shindan/', label: '回線・スマホ診断' },
  { href: '/guides/', label: '選び方ガイド' },
  { href: '/about/', label: 'このサイトについて' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? path === '/' : href === '/hikari/' ? path.startsWith(href) && !path.startsWith('/hikari/area/') : path.startsWith(href);
const socialImage = new URL('/social-cover.png', SITE.url).href;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#124a43" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {SITE.googleSiteVerifications.map((code) => (
      <meta name="google-site-verification" content={code} />
    ))}
    <meta property="og:type" content={path === '/' ? 'website' : 'article'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="しらべまとめ帳。公式情報から、納得できる選び方を。" />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="site-body">
    <a href="#main" class="skip-link">本文へ移動</a>
    <header class="site-header">
      <div class="site-container masthead">
        <a href="/" class="site-brand" aria-label={`${SITE.name} 総合トップ`}>
          <img src="/favicon.svg" width="43" height="43" alt="" class="brand-mark" />
          <span class="brand-copy">
            <span class="brand-name">{SITE.name}</span>
            <span class="brand-tagline">公式情報から、納得できる選び方を。</span>
          </span>
        </a>
        <span class="masthead-note" aria-hidden="true"><span></span> 調べる。比べる。納得して選ぶ。</span>
        <details class="mobile-menu">
          <summary><span class="menu-lines" aria-hidden="true"></span><span>メニュー</span></summary>
          <nav aria-label="モバイルメニュー">
            {nav.map((n) => (
              <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}<span aria-hidden="true">↗</span></a>
            ))}
          </nav>
        </details>
      </div>
      <div class="navigation-bar">
        <nav class="site-container desktop-nav" aria-label="メインメニュー">
          {nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href="/shindan/" class="nav-compare">自分に合う回線を探す</a>
        </nav>
      </div>
    </header>

    {pr && <PrNotice />}

    <main id="main" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-container footer-grid">
        <div class="footer-about">
          <a href="/" class="footer-brand"><img src="/favicon.svg" width="34" height="34" alt="" /><span>{SITE.name}</span></a>
          <p>
            選ぶ前の「わからない」を、ひとつずつ。<br />
            料金・条件・向き不向きを、公式情報から調べてまとめます。
          </p>
          <a href="/about/" class="footer-editorial-link">編集方針と調べ方<span aria-hidden="true">↗</span></a>
        </div>
        <div>
          <p class="footer-heading">通信・ネットをくらべる</p>
          <ul>
            <li><a href="/hikari/">全国の光回線・Wi-Fi</a></li>
            <li><a href="/hikari/kodate/">戸建ての光回線</a></li>
            <li><a href="/hikari/mansion/">マンションの光回線</a></li>
            <li><a href="/hikari/home-router/">工事なしのホームルーター</a></li>
            <li><a href="/hikari/area/">全国の提供エリアを確認</a></li>
            <li><a href="/manga/">漫画で読む</a></li>
            <li><a href="/shindan/">回線・スマホ診断</a></li>
            <li><a href="/guides/cancellation-flow/">解約・番号引継ぎの手順</a></li>
            <li><a href="/mobile/">スマホ・SIMを比較</a></li>
            <li><a href="/security/">セキュリティソフトを比較</a></li>
            <li><a href="/houjin/">会社・お店の通信費と事務機器</a></li>
            <li><a href="/card/">クレジットカードの選び方</a></li>
            <li><a href="/houjin/card/">法人カードの選び方</a></li>
            <li><a href="/used-smartphones/">中古スマホの保証を比較</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-heading">しらべまとめ帳について</p>
          <ul>
            <li><a href="/guides/">選び方ガイド</a></li>
            <li><a href="/about/">運営者情報・編集方針</a></li>
            <li><a href="/ad-policy/">広告について</a></li>
            <li><a href="/privacy/">プライバシーポリシー</a></li>
            <li><a href="/contact/">お問い合わせ</a></li>
          </ul>
        </div>
      </div>
      <div class="site-container footer-bottom">
        <p>掲載情報は確認日時点のものです。申込み前に、公式サイトで最新の料金・条件をご確認ください。</p>
        <p>&copy; {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
