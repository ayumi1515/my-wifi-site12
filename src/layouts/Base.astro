---
import '../styles/global.css';
import { SITE } from '../site.config.mjs';
import PrNotice from '../components/PrNotice.astro';

interface Props {
  title: string;
  description: string;
  /** 構造化データ（JSON-LD）。配列で複数渡せる */
  jsonLd?: object[];
  /** PR表示を出すか（広告のないページでは false） */
  pr?: boolean;
  noindex?: boolean;
}
const { title, description, jsonLd = [], pr = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title}｜${SITE.name}`;
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url + '/',
  inLanguage: 'ja',
};
const ld = [websiteLd, ...jsonLd];

const nav = [
  { href: '/', label: '鹿児島の光回線' },
  { href: '/hikari/kodate/', label: '戸建て' },
  { href: '/hikari/mansion/', label: 'マンション' },
  { href: '/hikari/home-router/', label: '工事なし' },
  { href: '/hikari/area/', label: '地域別' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <meta property="og:type" content={path === '/' ? 'website' : 'article'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body class="min-h-screen bg-white text-gray-800 font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white px-3 py-2 rounded shadow">本文へ移動</a>
    {pr && <PrNotice />}
    <header class="bg-white border-b border-gray-200">
      <div class="mx-auto max-w-5xl px-4 h-14 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2 font-bold text-gray-900 shrink-0">
          <img src="/favicon.svg" width="28" height="28" alt="" />
          <span>{SITE.name}</span>
        </a>
        <details class="md:hidden relative">
          <summary class="list-none cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm font-bold text-gray-700">メニュー</summary>
          <nav class="absolute right-0 mt-2 w-52 rounded-lg border border-gray-200 bg-white shadow-lg z-50 py-2">
            {nav.map((n) => (
              <a href={n.href} class="block px-4 py-2.5 text-sm hover:bg-gray-50" aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
            ))}
          </nav>
        </details>
        <nav class="hidden md:flex items-center gap-5 text-sm font-bold text-gray-600">
          {nav.map((n) => (
            <a href={n.href} class:list={['hover:text-brand-600 transition', path === n.href && 'text-brand-600']} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-16 bg-gray-50 border-t border-gray-200 text-sm text-gray-600">
      <div class="mx-auto max-w-5xl px-4 py-10 grid gap-8 sm:grid-cols-3">
        <div>
          <p class="font-bold text-gray-800 mb-2">{SITE.name}</p>
          <p class="text-xs leading-relaxed">
            気になるサービスや商品を、公式の情報をもとに調べてまとめるサイトです。料金などの数字には、公式サイトで確かめた日と出典を書いています。
          </p>
        </div>
        <div>
          <p class="font-bold text-gray-800 mb-2">鹿児島の光回線</p>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/" class="hover:underline">おすすめの選び方</a></li>
            <li><a href="/hikari/kodate/" class="hover:underline">戸建て向け</a></li>
            <li><a href="/hikari/mansion/" class="hover:underline">マンション向け</a></li>
            <li><a href="/hikari/home-router/" class="hover:underline">工事なしのホームルーター</a></li>
            <li><a href="/hikari/area/" class="hover:underline">地域別の情報</a></li>
          </ul>
        </div>
        <div>
          <p class="font-bold text-gray-800 mb-2">このサイトについて</p>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/about/" class="hover:underline">運営者情報</a></li>
            <li><a href="/ad-policy/" class="hover:underline">広告について</a></li>
            <li><a href="/privacy/" class="hover:underline">プライバシーポリシー</a></li>
            <li><a href="/contact/" class="hover:underline">お問い合わせ</a></li>
          </ul>
        </div>
      </div>
      <p class="text-center text-xs text-gray-400 pb-6">&copy; {new Date().getFullYear()} {SITE.name}</p>
    </footer>
  </body>
</html>
