---
import AffiliateButton from './AffiliateButton.astro';
import { byId } from '../lib/data';
import { offers } from '../lib/offers';
import choices from '../data/guide-decisions.json';
interface Choice { tag:string; title:string; price:string; period:string; reason:string; caution:string; providerId?:string; offerId?:string; href?:string; label?:string }
const { slug } = Astro.props as { slug:string };
const content = (choices as Record<string,{heading:string;verdict:string;options:Choice[]}>)[slug];
---
{content && <section id="answer" class="decision-panel" aria-labelledby="decision-heading">
  <div class="decision-intro"><span class="decision-label">この記事の結論</span><h2 id="decision-heading">{content.heading}</h2><p>{content.verdict}</p></div>
  <div class="choice-grid">
    {content.options.map(option=>{const provider=option.providerId?byId(option.providerId):undefined;const offer=option.offerId?offers.find(o=>o.id===option.offerId):undefined;return <article class="choice-card">
      <p class="choice-tag">{option.tag}</p><h3>{option.title}</h3>
      <p class="choice-price">{option.price}<span>{option.period}</span></p>
      <p class="choice-reason">{option.reason}</p>
      <p class="choice-caution"><b>選ぶ前に</b>{option.caution}</p>
      {provider?.campaign&&<>{provider.campaign.summary&&<p class="campaign-key">{provider.campaign.summary}</p>}<details class="choice-campaign"><summary>{provider.campaign.label}</summary><p>{provider.campaign.detail}</p><a href={provider.campaign.url} target="_blank" rel="noopener">特典の条件を見る ↗</a></details></>}
      <div class="choice-action">{provider?<AffiliateButton provider={provider}/>:offer?<AffiliateButton provider={offer}/>:<a class="choice-official" href={option.href} target={option.href?.startsWith('https:')?'_blank':undefined} rel={option.href?.startsWith('https:')?'noopener':undefined}>{option.label} →</a>}</div>
      {provider&&<a class="choice-detail" href={`/hikari/${provider.id}/`}>月額・工事費・エリアを詳しく見る →</a>}
    </article>})}
  </div>
  <a class="decision-compare" href="#article-details">条件の違いを表で比較する ↓</a>
</section>}
<style>
.decision-panel{margin:0 0 28px;border:2px solid #175d50;border-radius:10px;background:#fff;overflow:hidden}.decision-intro{padding:22px 24px;background:#eff7f4}.decision-label{display:inline-block;background:#175d50;color:#fff;border-radius:3px;padding:4px 10px;font-size:13px;font-weight:700}.decision-intro h2{font-size:23px;line-height:1.5;font-weight:800;margin:12px 0 9px}.decision-intro>p{font-size:16px;line-height:1.8}.choice-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding:20px}.choice-card{display:flex;flex-direction:column;min-width:0;border:1px solid #d4dedb;border-radius:8px;padding:20px}.choice-tag{font-size:13px;font-weight:700;color:#175d50;border-bottom:1px solid #d8e5df;padding-bottom:8px}.choice-card h3{font-size:21px;font-weight:800;line-height:1.5;margin:12px 0}.choice-price{font-size:26px;font-weight:800;color:#a53d1e;line-height:1.5}.choice-price span{display:block;font-size:13px;font-weight:400;color:#526052;margin-top:3px}.choice-reason{font-size:15px;line-height:1.8;margin-top:12px}.choice-caution{font-size:13px;line-height:1.8;background:#f5f6f5;padding:10px 12px;margin:12px 0}.choice-caution b{display:block;color:#36483d}.choice-action{margin-top:auto;padding-top:8px}.choice-official{display:block;text-align:center;background:#175d50;color:#fff;padding:14px 12px;border-radius:6px;font-size:15px;font-weight:700;line-height:1.6}.choice-official:hover{background:#103c36}.choice-detail{font-size:13px;color:#175d50;text-align:center;text-decoration:underline;text-underline-offset:3px;margin-top:13px}.campaign-key{font-size:13px;line-height:1.7;margin-bottom:8px;color:#7e421e}.choice-campaign{font-size:13px;border:1px solid #f1d7bb;background:#fff8ec;padding:10px;border-radius:4px;margin-bottom:12px}.choice-campaign summary{font-weight:700;cursor:pointer;color:#9a451a}.choice-campaign p{line-height:1.8;margin-top:8px}.choice-campaign a{display:block;text-decoration:underline;margin-top:8px}.decision-compare{display:block;padding:14px 20px;text-align:center;border-top:1px solid #d8e5df;font-size:14px;font-weight:700;color:#175d50;background:#f8fbfa}@media(max-width:600px){.decision-intro{padding:18px}.decision-intro h2{font-size:20px}.decision-intro>p{font-size:15px}.choice-grid{grid-template-columns:1fr;padding:14px;gap:14px}.choice-card{padding:17px}.choice-price{font-size:25px}}
</style>
