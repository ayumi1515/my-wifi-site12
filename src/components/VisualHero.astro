---
interface Props { title:string; lead:string; image?:'internet'|'learning'; eyebrow?:string; heading?:'h1'|'h2'; compact?:boolean }
const {title,lead,image='internet',eyebrow='しらべて、比べて、自分に合う選択を。',heading='h1',compact=false}=Astro.props;
const Heading=heading;
const alt=image==='internet'?'家族でスマートフォンとチェックリストを見ながら通信回線を選ぶイラスト':'自宅でヘッドホンを使い、英語を学習する人のイラスト';
---
<div class:list={['visual-hero',`visual-${image}`,{'is-compact':compact}]}>
  <div class="visual-copy"><p class="visual-eyebrow"><span aria-hidden="true">✓</span>{eyebrow}</p><Heading>{title}</Heading><p class="visual-lead">{lead}</p><slot /></div>
  <picture class="visual-picture"><source media="(max-width:700px)" srcset={`/images/${image}-640.webp`} /><img src={`/images/${image}-1200.webp`} width="1200" height="800" alt={alt} loading={heading==='h1'?'eager':'lazy'} fetchpriority={heading==='h1'?'high':'auto'} decoding="async" /></picture>
</div>
<style>
.visual-hero{position:relative;display:grid;grid-template-columns:1fr 1fr;align-items:center;min-height:230px;overflow:hidden;border:1px solid #e5ddc9;border-radius:12px;background:#fff8e9}.visual-copy{position:relative;z-index:1;padding:23px 12px 23px 28px}.visual-eyebrow{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:700;color:#175d50;line-height:1.7}.visual-eyebrow>span{display:inline-grid;place-items:center;background:#175d50;color:white;width:20px;height:20px;border-radius:50%;font-size:12px}.visual-copy h1,.visual-copy h2{font-family:var(--font-sans);font-size:clamp(27px,3.3vw,38px);line-height:1.45;font-weight:800;white-space:pre-line;letter-spacing:0;margin:9px 0 10px;color:#173e31}.visual-lead{font-size:15px;line-height:1.85;color:#455f50;max-width:560px}.visual-picture{align-self:stretch;min-width:0;position:relative}.visual-picture img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:65% 65%}.visual-learning{background:#fff6e8}.visual-learning .visual-eyebrow{color:#a14a26}.is-compact{min-height:200px}.is-compact .visual-copy h2{font-size:28px}.visual-copy :global(nav){margin-top:14px}@media(max-width:700px){.visual-hero{grid-template-columns:1fr;min-height:0}.visual-copy{padding:19px 19px 16px}.visual-copy h1,.visual-copy h2{font-size:27px;line-height:1.5;margin:8px 0 9px}.visual-lead{font-size:15px}.visual-eyebrow{font-size:12px}.visual-picture{height:170px;order:2}.visual-picture img{object-position:65% 54%}.is-compact .visual-copy h2{font-size:24px}.is-compact .visual-picture{height:160px}}
</style>
