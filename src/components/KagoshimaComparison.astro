-inline:18px}.provider-details>details>summary{flex-wrap:wrap;padding:15px;font-size:17px}.summary-price{font-size:13px;margin-left:0}.provider-detail-body{padding:10px}.area-grid{grid-template-columns:1fr 1fr;gap:9px}.area-grid a{padding:13px}.area-grid strong{font-size:15px}.area-grid span{font-size:13px}.criteria-section p{font-size:14px}}
.campaign-note details{margin-top:4px;font-size:13px;line-height:1.7}.campaign-note summary{cursor:pointer;font-weight:700;text-decoration:underline;text-underline-offset:3px}.campaign-note details p{margin-top:7px;font-size:13px;line-height:1.8}.campaign-note details a{font-size:13px;text-decoration:underline;text-underline-offset:3px}
