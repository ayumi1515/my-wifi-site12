---
// 鹿児島県の光回線の比較（候補3つ・5社の比較表・条件で選ぶ・詳細・地域・質問・基準）
// /hikari/kagoshima/ で使う。以前は /hikari/ の中で、鹿児島を選んだときだけ表示していた。
import ProviderCard from './ProviderCard.astro';
import AffiliateButton from './AffiliateButton.astro';
import InternetFinder from './InternetFinder.astro';
import InternetVisualGuide from './InternetVisualGuide.astro';
import RelatedConnectivityLinks from './RelatedConnectivityLinks.astro';
import { ranked, byId, areas, faqs } from '../lib/data';
const fiberAll = ranked('house', 'fiber');
const quick = [
  { id: 'bbiq', audience: 'au・UQ mobile ＋ 九州電力', reason: '九州電力とまとめる戸建てなら', note: '表示額は13カ月目以降。3年自動更新・電気との割引を含みます。' },
  { id: 'docomo-hikari', audience: 'ドコモの対象プラン', reason: '家族のドコモ回線をまとめるなら', note: '1ギガ・タイプA・2年定期。ahamoはスマホのセット割対象外です。' },
  { id: 'softbank-hikari', audience: 'ソフトバンク・ワイモバイル', reason: 'おうち割を使うなら', note: '1ギガ・2年自動更新。セット割は指定オプションが別途必要です。' },
].map(item => ({ ...item, provider: byId(item.id)! }));
const setNames = (list: string[]) => [...new Set(list.map(s => s.replace(/（[^（）]*）$/, '')))].join('・');
---
<div class="comparison-page kagoshima-comparison">
    <section class="site-container quick-section" aria-labelledby="quick">
      <div class="section-head"><h2 id="quick">結論：使っているスマホで、第一候補が決まります</h2><p>鹿児島県の光回線は、まず「スマホのセット割が使える回線」から考えると迷いにくくなります。表示額は1ギガ・税込の例です。</p></div>
      <div class="quick-grid">
        {quick.map(({provider:p,...item}) => <article class="quick-card">
          <p class="audience">{item.audience}</p><h3>{p.name}</h3>
          <p class="quick-price"><span>戸建て月額</span><strong>{p.house?.label}</strong></p>
          <p class="condition">{item.note}</p>
          {p.campaign && <aside class="campaign-note"><strong>{p.campaign.label}</strong><p>戸建限定・6カ月内開通・8カ月継続・口座登録</p><details><summary>還元条件の詳細</summary><p>{p.campaign.detail}</p><a href={p.campaign.url} target="_blank" rel="noopener">還元条件の出典 ↗</a></details></aside>}<AffiliateButton provider={p} building="house" />
          <a class="details-link" href={`/hikari/${p.id}/`}>料金条件・注意点を詳しく見る →</a>
        </article>)}
      </div>
      <nav class="jump-links" aria-label="比較したい内容へ"><a href="#compare">5社の料金を比べる ↓</a><a href="#finder">自分の条件で選ぶ ↓</a><a href="/guides/hikari-one-year/">1年だけ使う場合 →</a></nav>
    </section>

    <section id="compare" class="site-container compare-section" aria-labelledby="compare-title" data-building-comparison>
      <div class="section-head"><h2 id="compare-title">光回線5社を、同じ項目で比較</h2><p>月額に加えて、セット割の条件と工事費も比べましょう。</p></div>
      <div class="building-tabs" role="group" aria-label="料金を表示する建物"><button type="button" data-building-button="house" aria-pressed="true">戸建て</button><button type="button" data-building-button="mansion" aria-pressed="false">マンション・アパート</button></div>
      <p class="table-hint">表は横にスクロールできます →</p>
      <div class="comparison-table-wrap" tabindex="0" role="region" aria-label="光回線の料金と条件の比較表">
        <table class="comparison-table"><caption class="sr-only">鹿児島の光回線5社、1ギガの料金と契約条件</caption>
          <thead><tr><th scope="col">サービス</th><th scope="col">月額・表示条件</th><th scope="col">スマホ割・契約</th><th scope="col">初期費用・注意点</th><th scope="col">申込み・詳しい条件</th></tr></thead>
          <tbody>{fiberAll.map(p => <tr>
            <th scope="row"><a href={`/hikari/${p.id}/`}>{p.name}</a><span>{p.network}</span></th>
            <td>{(['house','mansion'] as const).map(building => <div data-for-building={building} hidden={building!=='house'}><strong class="table-price">{p[building]?.label ?? '—'}</strong><p>{p[building]?.note}</p></div>)}</td>
            <td><strong>{p.mobileSet.length ? setNames(p.mobileSet) : 'セット割なし'}</strong><p>{p.contract}</p></td>
            <td><p>{p.initialCost}</p><p class="table-caution">{p.cautions[0]}</p></td>
            <td>{p.id==='bbiq' ? <><div data-for-building="house">{p.campaign && <aside class="campaign-note"><strong>{p.campaign.label}</strong><p>{p.campaign.detail}</p></aside>}<AffiliateButton provider={p} building="house" showBanner={false} /></div><div data-for-building="mansion" hidden><a class="official-action" href={p.officialUrl} target="_blank" rel="noopener">BBIQ公式で建物の条件を見る ↗</a></div></> : <AffiliateButton provider={p} showBanner={false} />}<a class="details-link" href={`/hikari/${p.id}/`}>条件を詳しく見る →</a></td>
          </tr>)}</tbody>
        </table>
      </div>
      <p class="comparison-note">BBIQの表示額は電気などの割引条件を含みます。フレッツ光はプロバイダ料金が別途必要です。SoftBank 光は2026年12月以降に料金改定があり、契約によって適用月が異なります。月額だけでなく、必要オプション・工事費の残額も含めて判断してください。</p>
    </section>

    <slot name="after-compare" />
    <div class="site-container finder-section"><InternetFinder /></div>
    <div class="site-container connection-visual-section"><InternetVisualGuide /></div>

    <section class="site-container route-section" aria-labelledby="routes"><h2 id="routes">迷っているポイントから選ぶ</h2><div class="route-grid"><a href="/guides/bbiq-vs-docomo-hikari/"><span>2社で迷う</span><strong>BBIQとドコモ光を比較</strong><p>スマホ・10ギガ・工事の違いで選ぶ</p><b aria-hidden="true">→</b></a><a href="/guides/bbiq-vs-biglobe-hikari/"><span>au・UQ mobile</span><strong>BBIQとビッグローブ光を比較</strong><p>電気割引・今の回線・契約期間で選ぶ</p><b aria-hidden="true">→</b></a><a href="/guides/hikari-one-year/"><span>短期で使いたい</span><strong>1年だけ使う場合の選び方</strong><p>解約時までの総額と短期向け候補を見る</p><b aria-hidden="true">→</b></a><a href="/hikari/home-router/"><span>工事ができない</span><strong>ホームルーターを比較</strong><p>月額と端末代・電波の条件を確認する</p><b aria-hidden="true">→</b></a></div></section>

    <div class="site-container"><RelatedConnectivityLinks /></div>

    <section class="site-container detail-section" aria-labelledby="ranking"><h2 id="ranking">候補が決まったら、契約条件を詳しく見る</h2><p class="section-description">料金の内訳、向く人と注意点をサービスごとにまとめています。</p><div class="provider-details">{fiberAll.map(p => <details><summary><span>{p.name}</span><span class="summary-price">戸建て {p.house?.label}</span><span aria-hidden="true">＋</span></summary><div class="provider-detail-body"><ProviderCard provider={p} building="house" /></div></details>)}</div></section>

    <section class="site-container area-section" aria-labelledby="areas"><h2 id="areas">住所のエリアが気になる人へ</h2><p class="section-description">10ギガや離島は、同じ市町でも住所・建物によって利用可否が変わります。</p><ul class="area-grid">{areas.map(a=><li><a href={`/hikari/area/${a.slug}/`}><strong>{a.name}</strong><span>{a.tenGiga?'10ギガの提供地域あり':'島・住所ごとの確認方法'} →</span></a></li>)}</ul></section>

    <section class="site-container faq-section" aria-labelledby="faq"><h2 id="faq">よくある質問</h2><div>{faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
    <section class="site-container criteria-section" aria-labelledby="criteria"><h2 id="criteria">候補の選び方と料金の調べ方</h2><p>冒頭の3候補は、スマホのセット割を使える組合せで並べています。人気や通信速度の順位ではありません。料金表は公開中の5社を掲載し、条件別フォームはスマホの組合せと表示月額で候補をしぼります。</p><p>住所で使える回線か、必要なオプションを含めた支払いはいくらか、いつまで利用するかで、合う契約は変わります。料金の確認日と公式出典は<a href="#ranking">各社の詳細</a>に掲載しています。実機による速度の比較測定は行っていません。</p><p>auひかりなど、県内の提供条件と料金を確認できていないサービスは掲載していません。離島の人は<a href="/hikari/area/ritou/">離島の確認方法</a>をご覧ください。</p></section>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-building-comparison]').forEach(comparison=>{
    const buttons=comparison.querySelectorAll<HTMLButtonElement>('[data-building-button]');
    buttons.forEach(button=>button.addEventListener('click',()=>{
      const selected=button.dataset.buildingButton;
      buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
      comparison.querySelectorAll<HTMLElement>('[data-for-building]').forEach(item=>item.hidden=item.dataset.forBuilding!==selected);
    }));
  });
</script>
<style>
  .comparison-page{background:#fff;color:#23352e;padding-bottom:25px;font-size:16px;line-height:1.85}.comparison-header{padding-top:14px}.eyebrow{margin:14px 0 7px;color:#175d50;font-size:14px;font-weight:700}.comparison-header h1{margin-top:10px!important;font-family:var(--font-sans);font-size:clamp(26px,3.5vw,38px);font-weight:800;line-height:1.5;margin:0 0 12px}.header-lead{max-width:900px;font-size:16px;line-height:1.9}.updated{color:#647067;font-size:13px;margin-top:6px}.updated a{text-decoration:underline}.jump-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.jump-links a{padding:8px 16px;background:#edf4ef;border:1px solid #d7e4dc;border-radius:5px;color:#124a43;font-size:14px;font-weight:700}.quick-section{padding-top:15px}.section-head{margin-bottom:16px}.comparison-page h2{font-family:var(--font-sans);font-size:clamp(21px,2.5vw,26px);font-weight:800;line-height:1.55}.section-head p,.section-description{color:#58685e;font-size:15px;line-height:1.8;margin-top:6px}.quick-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:start;gap:16px}.quick-card{display:flex;flex-direction:column;padding:17px;border:1px solid #ccdad2;border-top:4px solid #175d50;border-radius:8px;background:#fff}.audience{display:inline-block;align-self:flex-start;background:#edf4ef;border-radius:4px;padding:3px 8px;font-size:13px;font-weight:700;color:#175d50}.quick-card h3{font-size:23px;font-weight:800;margin-top:8px}.choice-reason{font-size:15px;margin-top:2px}.quick-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;margin:12px 0 5px}.quick-price>span{font-size:13px;color:#58685e}.quick-price strong{font-size:26px;color:#175d50;line-height:1.5}.campaign-note{border:1px solid #ecd8be;background:#fff7e9;border-radius:5px;padding:9px 10px;margin-bottom:12px;color:#8c4a25}.campaign-note>strong{display:block;font-size:16px;line-height:1.6}.campaign-note>p{font-size:13px;line-height:1.8;margin-top:5px}.campaign-note>a{font-size:13px;text-decora