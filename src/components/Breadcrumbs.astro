---
interface Item { name: string; href?: string }
const { items } = Astro.props as { items: Item[] };
---
<nav aria-label="パンくずリスト" class="text-xs text-gray-500 mb-4">
  <ol class="flex flex-wrap gap-1">
    {items.map((it, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && <span aria-hidden="true">›</span>}
        {it.href ? <a href={it.href} class="hover:underline">{it.name}</a> : <span class="text-gray-700">{it.name}</span>}
      </li>
    ))}
  </ol>
</nav>
