---
// スマホの会社ごとに「スマホ代をこのカードで払うとおトク」を出す部品。
// brand を渡すとその会社の箱だけ、渡さないと全社の一覧（表）。中身は src/data/carrier-cards.json（公式で確認）。
// 広告があるカードはまだないので、公式へのふつうのリンク。報酬で並び順を変えない。
import data from '../data/carrier-cards.json';
type Entry = { carrier: string; card: string; points: string[]; fee: string; caution?: string; url: string };
interface Props { brand?: string; heading?: string }
const { brand, heading } = Astro.props;
const brands = data.brands as Record<string, Entry>;
const one = brand ? brands[brand] : undefined;
const date = data.checkedAt.replace(/-/g, '/');
---
{brand ? (
  one ? (
    <aside class="cc-box" aria-label={`${one.carrier}のスマホ代をカードで払うと`}>
      <p class="cc-kicker">スマホ代の払い方でもおトクに</p>
      <h3>{heading ?? `${one.carrier}なら、${one.card}で払う`}</h3>
      <ul>{one.points.map((t) => <li>{t}</li>)}</ul>
      <p class="cc-fee">{one.fee}</p>
      {one.caution && <p class="cc-caution">{one.caution}</p>}
      <a href={one.url} target="_blank" rel="noopener">{one.carrier}の公式でくわしく見る →</a>
      <p class="cc-date">各社の公式サイトで{date}に確認（金額は税込）。割引は対象の料金プランだけです。</p>
    </aside>
  ) : (
    <aside class="cc-box" aria-label="スマホ代をカードで払うと">
      <p class="cc-kicker">スマホ代の払い方でもおトクに</p>
      <h3>{data.general.title}</h3>
      <p>{data.general.body}</p>
      <p class="cc-fee">{data.general.offerNote}</p>
      <a href={data.general.url} target="_blank" rel="noopener">エポスカードの公式でくわしく見る →</a>
      <p class="cc-date">公式サイトで{date}に確認。</p>
    </aside>
  )
) : (
  <section class="cc-all" aria-labelledby="cc-all-title">
    <h2 id="cc-all-title">{heading ?? 'スマホ代は、この会社ならこのカードで払うとおトク'}</h2>
    <p class="cc-lead">スマホの会社と組んだカードで料金を払うと、毎月の割引やポイントがつくことがあります。割引は対象の料金プランだけで、カードの年会費もかかる場合があるので、合計で考えましょう。</p>
    <div class="cc-table" tabindex="0" role="region" aria-label="スマホの会社とカード">
      <table>
        <thead><tr><th scope="col">スマホの会社</th><th scope="col">おトクなカード</th><th scope="col">内容（対象プランのみ）</th><th scope="col">年会費</th></tr></thead>
        <tbody>
          {Object.entries(brands).map(([, b]) => <tr><th scope="row">{b.carrier}</th><td><a href={b.url} target="_blank" rel="noopener">{b.card}</a></td><td><ul>{b.points.map((t) => <li>{t}</li>)}</ul>{b.caution && <p class="cc-caution">{b.caution}</p>}</td><td>{b.fee.replace('年会費：', '')}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="cc-date">{data.general.body}（例：<a href={data.general.url} target="_blank" rel="noopener">エポスカード</a>）　各社の公式サイトで{date}に確認、金額は税込。</p>
  </section>
)}
<style>
  .cc-box { margin-top: 16px; padding: 16px 18px; border: 2px solid #b45b36; border-radius: 12px; background: #fff8f1; }
  .cc-kicker { font-size: 12px; font-weight: 800; color: #b45b36; }
  .cc-box h3 { margin-top: 4px; font-size: 18px; font-weight: 800; line-height: 1.5; color: #173d2b; }
  .cc-box ul { margin: 8px 0 0; padding-left: 1.2em; list-style: disc; display: grid; gap: 4px; }
  .cc-box li, .cc-box p { font-size: 14px; line-height: 1.8; color: #2f4a3a; }
  .cc-fee { margin-top: 6px; font-weight: 700; }
  .cc-caution { margin-top: 4px; font-size: 13px !important; color: #8c4426 !important; }
  .cc-box a, .cc-all a { display: inline-block; margin-top: 8px; font-size: 14px; font-weight: 700; color: #175d50; text-decoration: underline; text-underline-offset: 3px; }
  .cc-date { margin-top: 6px; font-size: 12px !important; color: #69786e !important; }
  .cc-all { margin-top: 34px; }
  .cc-all h2 { font-size: clamp(20px, 2.6vw, 25px); font-weight: 800; line-height: 1.55; color: #173d2b; }
  .cc-lead { margin-top: 8px; font-size: 15px; line-height: 1.9; color: #4f6a5a; }
  .cc-table { overflow-x: auto; margin-top: 12px; border: 1px solid #ccd9d0; border-radius: 8px; }
  .cc-table table { width: 100%; min-width: 720px; border-collapse: collapse; font-size: 14px; }
  .cc-table th, .cc-table td { padding: 10px 12px; border-bottom: 1px solid #dce5de; text-align: left; vertical-align: top; line-height: 1.7; }
  .cc-table thead th { background: #175d50; color: #fff; }
  .cc-table tbody th { background: #f1f6f1; color: #175d50; white-space: nowrap; }
  .cc-table ul { margin: 0; padding-left: 1.1em; list-style: disc; }
  .cc-table td a { margin-top: 0; }
</style>
