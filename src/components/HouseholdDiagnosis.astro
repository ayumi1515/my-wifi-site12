---
import AffiliateButton from './AffiliateButton.astro';
import PointsComparison from './PointsComparison.astro';
import { providers } from '../lib/data';
import { prefectures } from '../lib/national-areas';
import mobileServices from '../data/mobile-services.json';
import categoryAffiliates from '../data/category-affiliates.json';
import homeData from '../data/household-homes.json';

const regions = prefectures.map(p => ({ code:p.code, name:p.name, municipalities:p.municipalities.map(m => ({code:m.code,name:m.name,countyName:m.countyName,parentCityName:m.parentCityName})) }));
const tenureOptions = [{value:'unknown',label:'分からない'},{value:'under1',label:'1年未満'},{value:'1to2',label:'1年以上〜2年未満'},{value:'2to10',label:'2年以上〜10年未満'},{value:'10to20',label:'10年以上〜20年未満'},{value:'20plus',label:'20年以上'}];
const carrierNames = [
  {id:'docomo',name:'ドコモ',officialUrl:'https://www.docomo.ne.jp/charge/'},
  {id:'au',name:'au',officialUrl:'https://www.au.com/mobile/charge/smartphone/'},
  {id:'softbank',name:'ソフトバンク',officialUrl:'https://www.softbank.jp/mobile/price_plan/'},
  {id:'ymobile',name:'ワイモバイル',officialUrl:'https://www.ymobile.jp/plan/'},
  ...mobileServices.map(s => ({id:s.id,name:s.name,officialUrl:s.officialUrl})),
];
const carrierOrder = ['docomo','au','softbank','ymobile','uq-mobile','rakuten-mobile','ahamo','linemo','povo','iijmio','mineo','nuro-mobile','his-mobile','aeon-mobile','nihon-tsushin','x-mobile'];
const carriers = carrierOrder.map(id => carrierNames.find(c=>c.id===id)!).filter(Boolean);
const ads = categoryAffiliates as Record<string,{name:string;affiliate:{href:string;label:string;banner?:{href:string;src:string;width:number;height:number;pixel?:string}}}>;
const homes = homeData.homes;
---
<section class="household-diagnosis" data-household-diagnosis data-regions={JSON.stringify(regions)} data-home-names={JSON.stringify(homes.map(h=>({id:h.id,name:h.name,url:h.url})))} data-carriers={JSON.stringify(carriers.map(c=>({id:c.id,name:c.name})))}>
  <div class="household-intro"><h2 class="visually-hidden">通信費診断の回答</h2><p class="privacy-note">詳しい住所・氏名は不要。回答は送信・保存しません。</p></div>
  <div class="diagnosis-progress" data-wizard-progress aria-label="診断の進み具合"><ol><li data-progress-step="1" aria-current="step"><span>1</span>住まい</li><li data-progress-step="2"><span>2</span>スマホ</li><li data-progress-step="3"><span>3</span>結果</li></ol><p data-step-status role="status" aria-live="polite">入力 1 / 2：住まい</p></div>
  <p class="runtime-note" data-runtime-note>診断の準備中です。使えない場合は、<a href="/hikari/area/">全国のエリア確認</a>や<a href="/mobile/">スマホ・SIM比較</a>からも確認できます。</p>
  <form id="diagnosis-form" class="household-form" action="/shindan/" method="get" novalidate>
    <fieldset class="runtime-controls" disabled data-runtime-controls><legend class="visually-hidden">通信費診断の回答</legend>
      <div class="wizard-toolbar"><p>細かな設定は任意です</p><button type="button" class="all-fields-toggle" data-all-fields aria-pressed="false" disabled>すべての項目を表示</button></div>
      <section class="wizard-step" data-wizard-step="1" aria-labelledby="household-step-one-title">
        <header class="step-heading"><p>STEP 1</p><h3 id="household-step-one-title" tabindex="-1">住まいを選んでください</h3></header>
        <fieldset class="question"><legend>見直したいもの</legend><div class="goal-grid"><label><input name="goal" type="radio" value="both" checked /><span><strong>Wi-Fi＋スマホ</strong><small>まとめて比べる</small></span></label><label><input name="goal" type="radio" value="mobile" /><span><strong>スマホだけ</strong><small>今の自宅回線を使う</small></span></label><label><input name="goal" type="radio" value="home" /><span><strong>Wi-Fiだけ</strong><small>スマホは見直さない</small></span></label></div><p class="help" data-goal-help>自宅回線と家族のスマホを合わせて比べます。</p></fieldset>
        <fieldset class="question"><legend>住んでいる地域</legend><div class="fields"><div class="field"><label for="household-prefecture">都道府県 <span>必須</span></label><select id="household-prefecture" name="prefecture" required><option value="">都道府県を選ぶ</option>{prefectures.map(p=><option value={p.code}>{p.name}</option>)}</select></div><div class="field"><label for="household-current-home">今のWi-Fi <span>不明でもOK</span></label><select id="household-current-home" name="currentHome"><option value="other">そのほか・分からない</option><option value="none">自宅の回線はない</option><option value="docomo-hikari">ドコモ光</option><option value="biglobe-hikari">ビッグローブ光</option><option value="softbank-hikari">SoftBank 光</option><option value="bbiq">BBIQ</option><option value="en-hikari">enひかり</option><option value="home5g">home 5G</option><option value="softbank-air">SoftBank Air</option></select></div></div><p class="help">番地は不要です。使えるかどうかは、結果の公式窓口で確認できます。</p></fieldset>
        <fieldset class="question" data-home-questions><legend>建物と、工事の希望</legend><div class="fields"><div class="field"><label for="household-building">建物</label><select id="household-building" name="building"><option value="house">戸建て</option><option value="mansion">マンション・アパート</option></select></div><div class="field"><label for="household-construction">光回線の工事</label><select id="household-construction" name="construction"><option value="unknown">まだ分からない</option><option value="yes">できる・光回線を使いたい</option><option value="no">できない・工事なしがよい</option></select></div></div><p class="help">工事が分からない場合は、先に確認する窓口をご案内します。</p></fieldset>
        <details class="optional-settings" data-optional-settings><summary>詳しく設定する（任意）</summary><div class="optional-content"><div class="fields"><div class="field"><label for="household-municipality">市区町村・行政区 <span>任意</span></label><select id="household-municipality" name="municipality" disabled><option value="">都道府県を先に選んでください</option></select></div><div class="field"><label for="household-years">切替後に使う期間</label><select id="household-years" name="years"><option value="1">1年</option><option value="2" selected>2年</option><option value="3">3年</option><option value="5">5年</option></select></div><div class="field"><label for="household-start">切り替える時期</label><select id="household-start" name="start"><option value="now">2026年11月中</option><option value="december">2026年12月以降</option></select></div><div class="field"><label for="household-support">相談の希望</label><select id="household-support" name="support"><option value="either">どちらでもよい</option><option value="shop">店舗で相談したい</option><option value="online">オンラインで手続きできる</option></select></div><div class="field" data-home-tenure-field><label for="household-home-tenure">今のネット契約からの年数</label><select id="household-home-tenure" name="homeTenure">{tenureOptions.map(o=><option value={o.value}>{o.label}</option>)}</select></div><div class="field" data-current-home-cost-field><label for="household-current-home-monthly">今の自宅回線の実支払月額 <span>任意</span></label><div class="amount-input"><input id="household-current-home-monthly" name="currentHomeMonthly" type="number" min="0" max="1000000" step="1" inputmode="numeric" placeholder="分からなければ空欄" /><span>円／月</span></div></div></div><p class="help">自宅の実支払額は、セット割に必要な電話等の比較対象オプションを含め、端末代や比較対象外のオプションを除いて入力します。自宅回線なしと確認できた場合は0を入力してください。スマホだけの比較では自宅回線の基本料は含めません。契約年数だけでは解約費用は確定しないため、残額は契約先で確認します。利用予定の年数は将来の料金を保証しません。</p></div></details>
        <div data-cost-slot="1"></div>
      </section>
      <section class="wizard-step" data-wizard-step="2" aria-labelledby="household-step-two-title" hidden>
        <header class="step-heading"><p>STEP 2</p><h3 id="household-step-two-title" tabindex="-1">スマホの使い方を教えてください</h3></header>
        <fieldset class="question" data-family-questions><legend>見直すスマホ</legend><div class="fields"><div class="field"><label for="household-line-count">何回線を見直しますか？</label><select id="household-line-count" name="lineCount">{Array.from({length:6},(_,i)=><option value={i+1}>{i+1}回線</option>)}</select></div></div><p class="help">人数ではなく、スマホの契約数を選びます。</p>
          <div class="family-lines">{Array.from({length:6},(_,i)=><fieldset class="family-line" data-family-line={i} hidden={i>0} disabled={i>0}>
            <legend>回線{i+1}</legend>
            <div class="fields"><div class="field"><label for={`household-carrier-${i}`}>今のスマホ会社</label><select id={`household-carrier-${i}`} name={`carrier-${i}`}><option value="other">そのほか・分からない</option>{carriers.map(c=><option value={c.id}>{c.name}</option>)}</select></div><div class="field"><label for={`household-data-${i}`}>毎月使うギガ数 <span>必須</span></label><select id={`household-data-${i}`} name={`data-${i}`} required><option value="">通信量を選ぶ</option>{[1,3,5,10,20,30,35,50,120].map(gb=><option value={gb}>{gb}GBまで</option>)}<option value="999">無制限を希望</option></select></div></div><p class="help">ギガ数が分からないときは、今のプランの容量を確認してください。</p>
            <details class="optional-settings line-settings" data-optional-settings><summary>この回線を詳しく設定</summary><div class="optional-content"><div class="fields"><div class="field"><label for={`household-current-plan-${i}`}>今の料金プラン <span>任意</span></label><select id={`household-current-plan-${i}`} name={`currentPlan-${i}`} disabled><option value="">キャリアを先に選んでください</option></select></div><div class="field"><label for={`household-current-tier-${i}`}>今の容量・料金区分 <span>任意</span></label><select id={`household-current-tier-${i}`} name={`currentTier-${i}`} disabled><option value="">料金プランを先に選んでください</option></select></div><div class="field"><label for={`household-current-line-monthly-${i}`}>この回線の実支払月額 <span>任意</span></label><div class="amount-input"><input id={`household-current-line-monthly-${i}`} name={`currentLineMonthly-${i}`} type="number" min="0" max="1000000" step="1" inputmode="numeric" placeholder="明細の通信プラン料金" /><span>円／月</span></div></div><div class="field"><label for={`household-tenure-${i}`}>今の回線の契約年数</label><select id={`household-tenure-${i}`} name={`tenure-${i}`}>{tenureOptions.map(o=><option value={o.value}>{o.label}</option>)}</select></div></div><p class="current-plan-reference" data-current-plan-reference>料金プランを選ぶと、割引前の参考基本料を確認できます。実支払額や節約額には使いません。</p><details class="current-plan-details" data-current-plan-details hidden><summary>現在プランの掲載条件</summary><p data-current-plan-note></p></details><p class="help">実支払額は、明細の通信プラン料金を入力します。端末分割代・従量の通話料は除きます。今のキャリア・料金プラン・料金区分を変えると、この実支払額をクリアします。ドコモ・ahamoの契約年数は、両プラン間の変更前のドコモ契約期間も含めます。</p><label class="check-label"><input name={`keep-${i}`} type="checkbox" data-keep-carrier /><span>同じブランドの中で見直す</span></label></div></details>
          </fieldset>)}</div>
        </fieldset>
        <div data-cost-slot="2"></div>
      </section>
      <details id="household-cost-fields" class="optional-settings cost-settings" data-cost-settings data-optional-settings><summary>ポイント・節約額も比べる（任意）</summary><div class="optional-content"><div class="field points-setting"><label for="household-points-preference">よく使うポイント <span>任意</span></label><select id="household-points-preference" name="pointsPreference"><option value="none">こだわらない</option><option value="dpoint">dポイント</option><option value="rakuten">楽天ポイント</option><option value="ponta">Pontaポイント</option><option value="paypay">PayPayポイント</option></select><p class="help">選んだポイントの還元条件を、結果に別枠で表示します。現金の支払額とポイントを分けて比べられます。</p></div><div class="fields"><div class="field"><label for="household-current-monthly"><span class="dynamic-label" data-current-monthly-label>現在の自宅＋家族のスマホの合計月額</span> <span>任意・個別明細より優先</span></label><div class="amount-input"><input id="household-current-monthly" name="currentMonthly" type="number" min="0" max="1000000" step="1" inputmode="numeric" placeholder="例：18000" /><span>円／月</span></div></div><div class="field"><label for="household-switching-cost">乗換えにかかる費用の合計 <span>任意</span></label><div class="amount-input"><input id="household-switching-cost" name="switchingCost" type="number" min="0" max="10000000" step="1" inputmode="numeric" placeholder="分からなければ空欄" /><span>円</span></div></div></div><p class="help">各スマホと自宅回線の実支払額がそろうと合算します。合計を直接入力した場合は、その額を優先します。同じ範囲の通信プラン料金を比較するため、自宅はセット割に必要な電話等を含め、端末分割代・従量の通話料・比較対象外の任意オプションは除きます。乗換費用は、旧契約の解約金・工事費や端末代の残額と、新契約の事務・工事・端末代の合計です。確認できた0円は「0」、不明な金額は空欄にしてください。</p><label class="check-label" data-family-assumption><input name="familyDiscount" type="checkbox" checked /><span>対象の家族割を使う前提で比べる</span></label><p class="help" data-family-assumption>家族割グループへの申込み・家族確認など、対象条件を満たす想定です。回線数を選ぶだけで適用は確定しません。</p><label class="check-label"><input name="useCampaigns" type="checkbox" /><span>対象条件を満たし、予定期間内に特典を受け取る想定で比べる（条件は結果で確認）</span></label><p class="help">未確認の最大額は計算に加えません。現在の月額が利用期間中続くと仮定して比べます。見直す範囲を変えると、実支払額・合計月額・乗換費用はクリアします。</p><p class="current-baseline-summary" data-current-baseline-summary role="status" aria-live="polite"></p></div></details>
      <div class="visible-assumptions"><p data-assumption-summary>比較期間：2年 ／ 2026年11月開始 ／ 特典なし</p><p data-family-assumption-summary>対象の家族割を使う前提です。条件は任意設定で変更できます。</p></div>
      <div class="form-actions"><button type="button" class="wizard-back" data-wizard-back hidden>← 戻る</button><button type="button" class="estimate-button" data-wizard-next disabled>スマホの入力へ →</button><button type="submit" class="estimate-button" data-wizard-submit hidden disabled>診断結果を見る →</button><button type="reset" class="reset-button">回答をリセット</button></div>
    </fieldset>
  </form>
  <p class="household-status" role="status" aria-live="polite" aria-atomic="true"></p>
  <section class="household-results" aria-labelledby="household-result-title" hidden><header class="results-heading"><p>STEP 3・入力した条件で比較</p><h2 id="household-result-title" tabindex="-1">家族の通信費の診断結果</h2><p data-result-region></p><a class="results-edit" href="#diagnosis-form">回答を直す</a></header><div class="results-body"></div><a class="edit-answers" href="#diagnosis-form">条件を変えて、もう一度比べる</a></section>
  <noscript><style>.household-form,.runtime-note{display:none}</style><div class="no-script"><h2>比較ページから候補を探す</h2><p>診断はJavaScriptを使います。<a href="/hikari/area/">全国のエリア確認</a>や<a href="/mobile/">スマホ・SIM比較</a>から、料金と条件を確認できます。</p></div></noscript>
  <template data-household-points-template><PointsComparison compact /></template>
  {homes.map(h=>(['house','mansion'] as const).map(building=>{const p=providers.find(p=>p.id===h.id);return <template data-household-home-template={`${h.id}:${building}`}><AffiliateButton provider={p??{id:h.id,name:h.name,officialUrl:h.url,affiliate:null}} building={building} actionFirst={true} /></template>;}))}
  {carriers.map(c=><template data-household-mobile-template={c.id}><AffiliateButton provider={{name:ads[c.id]?.name??c.name,officialUrl:c.officialUrl,affiliate:ads[c.id]?.affiliate??null}} actionFirst={true} notice="掲載プラン・端末の対応・特典の対象条件を申込先で確認してください。" /></template>)}
</section>

<script>
  import { estimateHousehold, currentPlanOptions, currentHouseholdBaseline, type HouseholdInput } from '../lib/household-diagnosis';
  interface Region {code:string;name:string;municipalities:{code:string;name:string;countyName?:string;parentCityName?:string}[]}
  type Estimate = ReturnType<typeof estimateHousehold>;
  type Proposal = Estimate['proposals'][number];
  const root=document.querySelector<HTMLElement>('[data-household-diagnosis]');
  if(root){
    const form=root.querySelector<HTMLFormElement>('form')!;
    const runtime=form.querySelector<HTMLFieldSetElement>('[data-runtime-controls]')!;
    const prefecture=form.querySelector<HTMLSelectElement>('[name="prefecture"]')!;
    const municipality=form.querySelector<HTMLSelectElement>('[name="municipality"]')!;
    const lineCount=form.querySelector<HTMLSelectElement>('[name="lineCount"]')!;
    const lineFields=[...form.querySelectorAll<HTMLFieldSetElement>('[data-family-line]')];
    const homeQuestions=form.querySelector<HTMLFieldSetElement>('[data-home-questions]')!;
    const familyQuestions=form.querySelector<HTMLFieldSetElement>('[data-family-questions]')!;
    const currentMonthly=form.querySelector<HTMLInputElement>('[name="currentMonthly"]')!;
    const currentHome=form.querySelector<HTMLSelectElement>('[name="currentHome"]')!;
    const currentHomeMonthly=form.querySelector<HTMLInputElement>('[name="currentHomeMonthly"]')!;
    const currentHomeCostField=form.querySelector<HTMLElement>('[data-current-home-cost-field]')!;
    const switchingCost=form.querySelector<HTMLInputElement>('[name="switchingCost"]')!;
    const results=root.querySelector<HTMLElement>('.household-results')!;
    const body=root.querySelector<HTMLElement>('.results-body')!;
    const status=root.querySelector<HTMLElement>('.household-status')!;
    const resultTitle=root.querySelector<HTMLElement>('#household-result-title')!;
    const steps=[...form.querySelectorAll<HTMLElement>('[data-wizard-step]')];
    const nextButton=form.querySelector<HTMLButtonElement>('[data-wizard-next]')!;
    const submitButton=form.querySelector<HTMLButtonElement>('[data-wizard-submit]')!;
    const backButton=form.querySelector<HTMLButtonElement>('[data-wizard-back]')!;
    const allFieldsButton=form.querySelector<HTMLButtonElement>('[data-all-fields]')!;
    const costSettings=form.querySelector<HTMLDetailsElement>('[data-cost-settings]')!;
    const optionalSettings=[...form.querySelectorAll<HTMLDetailsElement>('[data-optional-settings]')];
    let currentStep=1;
    let allFields=false;
    const regions:Region[]=JSON.parse(root.dataset.regions||'[]');
    const homeNames:{id:string;name:string;url:string}[]=JSON.parse(root.dataset.homeNames||'[]');
    const carriers:{id:string;name:string}[]=JSON.parse(root.dataset.carriers||'[]');
    let lastGoal='both';
    const money=(n:number)=>`${Math.round(n).toLocaleString('ja-JP')}円`;
    const pointLabels:Record<string,string>={none:'指定なし',dpoint:'dポイント',rakuten:'楽天ポイント',ponta:'Pontaポイント',paypay:'PayPayポイント'};
    const selectedPoints=()=>form.querySelector<HTMLSelectElement>('[name="pointsPreference"]')?.value||'none';
    const el=(tag:string,text='',className='')=>{const node=document.createElement(tag);node.textContent=text;if(className)node.className=className;return node;};
    const anchor=(text:string,href:string,className='')=>{const a=document.createElement('a');a.textContent=text;a.href=href;a.className=className;return a;};
    const external=(text:string,href:string,className='')=>{const a=anchor(text,href,className);a.target='_blank';a.rel='noopener';return a;};
    const getGoal=()=>String(new FormData(form).get('goal')||'both') as HouseholdInput['goal'];
    const count=()=>Math.min(6,Math.max(1,Number(lineCount.value)||1));
    const clearResult=()=>{results.hidden=true;body.replaceChildren();status.textContent='';};
    const showStep=(step:number,focus=false)=>{
      currentStep=step;
      form.hidden=step===3;
      if(step!==3)results.hidden=true;
      steps.forEach(section=>{section.hidden=step===3||(!allFields&&Number(section.dataset.wizardStep)!==step)||(getGoal()==='home'&&section.dataset.wizardStep==='2');});
      nextButton.hidden=allFields||step!==1||getGoal()==='home';
      submitButton.hidden=step===3||(!allFields&&step===1&&getGoal()!=='home');
      backButton.hidden=allFields||step!==2;
      root.querySelectorAll<HTMLElement>('[data-progress-step]').forEach(item=>{const active=Number(item.dataset.progressStep)===step;item.classList.toggle('is-complete',Number(item.dataset.progressStep)<step);item.classList.toggle('is-skipped',item.dataset.progressStep==='2'&&getGoal()==='home');if(active)item.setAttribute('aria-current','step');else item.removeAttribute('aria-current');});
      root.querySelector<HTMLElement>('[data-step-status]')!.textContent=step===3?'診断結果を表示しています':allFields?'すべての入力項目を表示しています':getGoal()==='home'?'住まいを選んだら、結果を確認できます':`入力 ${step} / 2：${step===1?'住まい':'スマホ'}`;
      if(focus&&step!==3){steps.find(section=>Number(section.dataset.wizardStep)===step)?.querySelector<HTMLElement>('h3')?.focus({preventScroll:true});form.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});}
    };
    const revealDetails=(control:HTMLElement)=>{let parent=control.parentElement;while(parent&&parent!==form){if(parent instanceof HTMLDetailsElement)parent.open=true;parent=parent.parentElement;}};
    const validateStep=(step:number)=>{
      const section=steps.find(section=>Number(section.dataset.wizardStep)===step)!;
      const invalid=[...section.querySelectorAll<HTMLInputElement|HTMLSelectElement>('input,select')].find(control=>control.willValidate&&!control.checkValidity());
      if(!invalid)return true;
