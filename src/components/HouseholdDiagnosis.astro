    const drawResults=(estimate:Estimate,input:HouseholdInput,selectedIndex=0)=>{
      body.replaceChildren();const p=regions.find(p=>p.code===input.prefecture);const m=p?.municipalities.find(m=>m.code===input.municipality);root.querySelector('[data-result-region]')!.textContent=[p?.name,m?.name].filter(Boolean).join(' ')+' ／ '+(input.goal==='home'?'自宅回線のみ':count()+'回線')+'・'+input.years+'年の予定で比較';
