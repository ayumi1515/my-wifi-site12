---
import AffiliateButton from './AffiliateButton.astro';
import { providers } from '../lib/data';
import { prefectures } from '../lib/national-areas';
import mobileServices from '../data/mobile-services.json';
import categoryAffiliates from '../data/category-affiliates.json';
import homeData from '../data/household-homes.json';

const regions = prefectures.map(p => ({ code:p.code, name:p.name, municipalities:p.municipalities.map(m => ({code:m.code,name:m.name,countyName:m.countyName,parentCityName:m.parentCityName})) }));
const tenureOptions = [{value:'unknown',label:'分からない'},{value:'under1',label:'1年未満'},{value:'1to2',label:'1年以上〜2年未満'},{value:'2to10',label:'2年以上〜10年未満'},{value:'10to20',label:'10年以上〜20年未満'},{value:'20plus',label:'20年以上'}];
const carrierNames = [
  {id:'docomo',name:'ドコモ',officialUrl:'https://www.docomo.ne.jp/charge/'},
  {id:'au',name:'au',officialUrl:'https://www.au.com/mobile/charge/smartphone/'},
  {id:'softbank',name:'ソフトバンク',officialUrl:'https://www.softbank.jp/mobile/price_plan/'},
  {id:'ymobile',name:'ワイモバイル',officialUrl:'https://www.ymobile.jp/plan/'},
  ...mobileServices.map(s => ({id:s.id,name:s.name,officialUrl:s.officialUrl})),
];
const carrierOrder = ['docomo','au','softbank','ymobile','uq-mobile','rakuten-mobile','ahamo','linemo','povo','iijmio','mineo','nuro-mobile','his-mobile','aeon-mobile','nihon-tsushin','x-mobile'];
const carriers = carrierOrder.map(id => carrierNames.find(c=>c.id===id)!).filter(Boolean);
const ads = categoryAffiliates as Record<string,{name:string;affiliate:{href:string;label:string;banner?:{href:string;src:string;width:number;height:number;pixel?:string}}}>;
const homes = homeData.homes;
---
<section class="household-diagnosis" data-household-diagnosis data-regions={JSON.stringify(regions)} data-home-names={JSON.stringify(homes.map(h=>({id:h.id,name:h.name,url:h.url})))} data-carriers={JSON.stringify(carriers.map(c=>({id:c.id,name:c.name})))}>
  <div class="household-intro"><h2>家族全体の通信費を、条件をそろえて比べる</h2><p>自宅の回線と、一人ひとりのスマホを一緒に見直します。使う通信量と契約の年数、利用予定の期間を選んでください。</p><p class="privacy-note">詳しい住所・氏名・電話番号は不要です。回答はこの画面内で処理し、送信・保存しません。</p></div>
  <p class="runtime-note" data-runtime-note>診断の準備中です。使えない場合は、<a href="/hikari/area/">全国のエリア確認</a>や<a href="/mobile/">スマホ・SIM比較</a>からも確認できます。</p>
  <form id="diagnosis-form" class="household-form" action="/shindan/" method="get">
    <fieldset class="runtime-controls" disabled data-runtime-controls><legend class="visually-hidden">通信費診断の回答</legend>
      <fieldset class="question"><legend>見直す範囲を選ぶ</legend><div class="goal-grid"><label><input name="goal" type="radio" value="both" checked /><span><strong>自宅＋家族のスマホ</strong><small>組合せで通信費を比べる</small></span></label><label><input name="goal" type="radio" value="mobile" /><span><strong>スマホだけ</strong><small>自宅は今の契約を使う</small></span></label><label><input name="goal" type="radio" value="home" /><span><strong>自宅の回線だけ</strong><small>スマホの月額は試算しない</small></span></label></div><p class="help" data-goal-help>自宅回線と家族のスマホを合わせて比べます。セット割・家族割は、掲載条件を満たす組合せだけで計算します。</p></fieldset>
      <fieldset class="question"><legend>使う地域</legend><div class="fields"><div class="field"><label for="household-prefecture">都道府県 <span>必須</span></label><select id="household-prefecture" name="prefecture" required><option value="">都道府県を選んでください</option>{prefectures.map(p=><option value={p.code}>{p.name}</option>)}</select></div><div class="field"><label for="household-municipality">市区町村・行政区 <span>任意</span></label><select id="household-municipality" name="municipality" disabled><option value="">都道府県を先に選んでください</option></select></div></div><p class="help">番地や部屋番号は入力しません。提供エリアと建物の設備は、結果に表示する公式窓口で確認します。</p></fieldset>
      <fieldset class="question"><legend>今の自宅回線と、使う期間</legend><div class="fields"><div class="field"><label for="household-current-home">今使っている自宅の回線</label><select id="household-current-home" name="currentHome"><option value="other">そのほか・分からない</option><option value="none">自宅の回線はない</option><option value="docomo-hikari">ドコモ光</option><option value="biglobe-hikari">ビッグローブ光</option><option value="softbank-hikari">SoftBank 光</option><option value="bbiq">BBIQ</option><option value="en-hikari">enひかり</option><option value="home5g">home 5G</option><option value="softbank-air">SoftBank Air</option></select></div><div class="field"><label for="household-years">切替後に使う予定の期間</label><select id="household-years" name="years"><option value="1">1年</option><option value="2" selected>2年</option><option value="3">3年</option><option value="5">5年</option></select></div><div class="field"><label for="household-start">切り替える時期</label><select id="household-start" name="start"><option value="now">2026年11月中</option><option value="december">2026年12月以降</option></select></div><div class="field"><label for="household-support">相談・手続きの希望</label><select id="household-support" name="support"><option value="either">どちらでもよい</option><option value="shop">店舗で相談したい</option><option value="online">オンラインで手続きできる</option></select></div></div><p class="help">スマホだけを見直す場合は、今の自宅回線とのセット割を確認します。利用予定年数は、将来の料金を保証するものではありません。</p></fieldset>
      <fieldset class="question" data-home-questions><legend>自宅の回線を見直す条件</legend><div class="fields"><div class="field"><label for="household-building">建物の種類</label><select id="household-building" name="building"><option value="house">戸建て</option><option value="mansion">マンション・アパート</option></select></div><div class="field"><label for="household-construction">光回線の工事はできますか？</label><select id="household-construction" name="construction"><option value="unknown">まだ分からない</option><option value="yes">できる・光回線を使いたい</option><option value="no">できない・工事なしで使いたい</option></select></div><div class="field"><label for="household-home-tenure">今のネット契約からの年数</label><select id="household-home-tenure" name="homeTenure">{tenureOptions.map(o=><option value={o.value}>{o.label}</option>)}</select></div></div><p class="help">今の契約年数だけでは解約金・工事費や端末代の残額は確定しません。契約先のマイページ等で実際の金額も確認してください。</p></fieldset>
      <fieldset class="question" data-family-questions><legend>家族のスマホ</legend><div class="fields"><div class="field"><label for="household-line-count">見直すスマホの回線数</label><select id="household-line-count" name="lineCount">{Array.from({length:6},(_,i)=><option value={i+1}>{i+1}回線</option>)}</select></div></div><p class="help">人数ではなく、見直すスマホの契約数を選びます。家族それぞれの通信量と、今のブランドを確認してください。ドコモ・ahamoの継続年数は、両プラン間の変更前のドコモ契約期間も含めて選びます。</p>
        <div class="family-lines">{Array.from({length:6},(_,i)=><fieldset class="family-line" data-family-line={i} hidden={i>0} disabled={i>0}><legend>回線{i+1}</legend><div class="fields"><div class="field"><label for={`household-carrier-${i}`}>今のキャリア・ブランド</label><select id={`household-carrier-${i}`} name={`carrier-${i}`}><option value="other">そのほか・分からない</option>{carriers.map(c=><option value={c.id}>{c.name}</option>)}</select></div><div class="field"><label for={`household-data-${i}`}>毎月使うデータ量 <span>必須</span></label><select id={`household-data-${i}`} name={`data-${i}`} required><option value="">通信量を選んでください</option>{[1,3,5,10,20,30,35,50,120].map(gb=><option value={gb}>{gb}GBまで</option>)}<option value="999">無制限を希望</option></select></div><div class="field"><label for={`household-tenure-${i}`}>今の回線の継続契約期間</label><select id={`household-tenure-${i}`} name={`tenure-${i}`}>{tenureOptions.map(o=><option value={o.value}>{o.label}</option>)}</select></div></div><label class="check-label"><input name={`keep-${i}`} type="checkbox" data-keep-carrier /><span>同じブランドの中で見直す</span></label></fieldset>)}</div>
        <label class="check-label family-assumption"><input name="familyDiscount" type="checkbox" checked /><span>家族割のグループ条件を満たす前提で比べる</span></label><p class="help">同じグループへの申込みや家族確認などが必要です。家族の回線数を入力するだけで、自動的に割引が適用されるわけではありません。</p>
      </fieldset>
      <fieldset id="household-cost-fields" class="question"><legend>乗り換えて、いくら変わるかを確認する</legend><div class="fields"><div class="field"><label for="household-current-monthly"><span class="dynamic-label" data-current-monthly-label>現在の自宅＋家族のスマホの合計月額</span> <span>任意</span></label><div class="amount-input"><input id="household-current-monthly" name="currentMonthly" type="number" min="0" max="1000000" step="1" inputmode="numeric" placeholder="例：18000" /><span>円／月</span></div></div><div class="field"><label for="household-switching-cost">乗換えにかかる費用の合計 <span>任意</span></label><div class="amount-input"><input id="household-switching-cost" name="switchingCost" type="number" min="0" max="10000000" step="1" inputmode="numeric" placeholder="分からない場合は空欄" /><span>円</span></div></div></div><p class="help">乗換費用は、旧契約の解約金・工事費や端末代の残額と、新契約の事務・工事・端末代を合計してください。0円と確認できた場合は「0」を入力します。分からない費用は0円と見なしません。</p><label class="check-label"><input name="useCampaigns" type="checkbox" /><span>対象条件を満たし、予定期間内に特典を受け取る想定で比べる（条件は結果で確認）</span></label><p class="help">特典の金額・対象プラン・受取時期は結果で確認します。条件が不明な最大額や、未確認のキャンペーンは節約額に加えません。</p><p class="scope-note">現在の月額は、選んだ見直し範囲の合計を入力してください。範囲を変えると月額・乗換費用の入力をクリアします。</p></fieldset>
      <div class="form-actions"><button type="submit" class="estimate-button" disabled>家族の組合せと節約目安を見る</button><button type="reset" class="reset-button">回答をリセット</button></div>
    </fieldset>
  </form>
  <p class="household-status" role="status" aria-live="polite" aria-atomic="true"></p>
  <section class="household-results" aria-labelledby="household-result-title" hidden><header class="results-heading"><p>入力した条件で比較</p><h2 id="household-result-title" tabindex="-1">家族の通信費の診断結果</h2><p data-result-region></p></header><div class="results-body"></div><a class="edit-answers" href="#diagnosis-form">条件を変えて、もう一度比べる</a></section>
  <noscript><style>.household-form,.runtime-note{display:none}</style><div class="no-script"><h2>比較ページから候補を探す</h2><p>診断はJavaScriptを使います。<a href="/hikari/area/">全国のエリア確認</a>や<a href="/mobile/">スマホ・SIM比較</a>から、料金と条件を確認できます。</p></div></noscript>
  {homes.map(h=>(['house','mansion'] as const).map(building=>{const p=providers.find(p=>p.id===h.id);return <template data-household-home-template={`${h.id}:${building}`}><AffiliateButton provider={p??{id:h.id,name:h.name,officialUrl:h.url,affiliate:null}} building={building} actionFirst={true} /></template>;}))}
  {carriers.map(c=><template data-household-mobile-template={c.id}><AffiliateButton provider={{name:ads[c.id]?.name??c.name,officialUrl:c.officialUrl,affiliate:ads[c.id]?.affiliate??null}} actionFirst={true} notice="掲載プラン・端末の対応・特典の対象条件を申込先で確認してください。" /></template>)}
</section>

<script>
  import { estimateHousehold, type HouseholdInput } from '../lib/household-diagnosis';
  interface Region {code:string;name:string;municipalities:{code:string;name:string;countyName?:string;parentCityName?:string}[]}
  type Estimate = ReturnType<typeof estimateHousehold>;
  type Proposal = Estimate['proposals'][number];
  const root=document.querySelector<HTMLElement>('[data-household-diagnosis]');
  if(root){
    const form=root.querySelector<HTMLFormElement>('form')!;
    const runtime=form.querySelector<HTMLFieldSetElement>('[data-runtime-controls]')!;
    const prefecture=form.querySelector<HTMLSelectElement>('[name="prefecture"]')!;
    const municipality=form.querySelector<HTMLSelectElement>('[name="municipality"]')!;
    const lineCount=form.querySelector<HTMLSelectElement>('[name="lineCount"]')!;
    const lineFields=[...form.querySelectorAll<HTMLFieldSetElement>('[data-family-line]')];
    const homeQuestions=form.querySelector<HTMLFieldSetElement>('[data-home-questions]')!;
    const familyQuestions=form.querySelector<HTMLFieldSetElement>('[data-family-questions]')!;
    const currentMonthly=form.querySelector<HTMLInputElement>('[name="currentMonthly"]')!;
    const switchingCost=form.querySelector<HTMLInputElement>('[name="switchingCost"]')!;
    const results=root.querySelector<HTMLElement>('.household-results')!;
    const body=root.querySelector<HTMLElement>('.results-body')!;
    const status=root.querySelector<HTMLElement>('.household-status')!;
    const resultTitle=root.querySelector<HTMLElement>('#household-result-title')!;
    const regions:Region[]=JSON.parse(root.dataset.regions||'[]');
    const homeNames:{id:string;name:string;url:string}[]=JSON.parse(root.dataset.homeNames||'[]');
    const carriers:{id:string;name:string}[]=JSON.parse(root.dataset.carriers||'[]');
    let lastGoal='both';
    const money=(n:number)=>`${Math.round(n).toLocaleString('ja-JP')}円`;
    const el=(tag:string,text='',className='')=>{const node=document.createElement(tag);node.textContent=text;if(className)node.className=className;return node;};
    const anchor=(text:string,href:string,className='')=>{const a=document.createElement('a');a.textContent=text;a.href=href;a.className=className;return a;};
    const external=(text:string,href:string,className='')=>{const a=anchor(text,href,className);a.target='_blank';a.rel='noopener';return a;};
    const getGoal=()=>String(new FormData(form).get('goal')||'both') as HouseholdInput['goal'];
    const count=()=>Math.min(6,Math.max(1,Number(lineCount.value)||1));
    const clearResult=()=>{results.hidden=true;body.replaceChildren();status.textContent='';};
    const updateCities=(selected='')=>{const p=regions.find(p=>p.code===prefecture.value);municipality.replaceChildren(new Option(p?'市区町村は選択しなくても比較できます':'都道府県を先に選んでください',''));municipality.disabled=!p;p?.municipalities.forEach(m=>municipality.add(new Option([m.countyName,m.parentCityName,m.name].filter(Boolean).join(' '),m.code)));if(p?.municipalities.some(m=>m.code===selected))municipality.value=selected;};
    const updateControls=()=>{
      const goal=getGoal();
      if(goal!==lastGoal){currentMonthly.value='';switchingCost.value='';lastGoal=goal;}
      homeQuestions.hidden=homeQuestions.disabled=goal==='mobile';
      familyQuestions.hidden=familyQuestions.disabled=goal==='home';
      lineFields.forEach((fieldset,index)=>{const enabled=index<count();fieldset.hidden=fieldset.disabled=!enabled;const keep=fieldset.querySelector<HTMLInputElement>('[data-keep-carrier]')!;keep.disabled=goal==='home';});
      root.querySelector('[data-current-monthly-label]')!.textContent=goal==='both'?'現在の自宅＋家族のスマホの合計月額':goal==='mobile'?'現在の家族のスマホだけの合計月額':'現在の自宅回線だけの月額';
      root.querySelector('[data-goal-help]')!.textContent=goal==='both'?'自宅回線と家族のスマホを合わせて比べます。セット割・家族割は、掲載条件を満たす組合せだけで計算します。':goal==='mobile'?'自宅の基本料は変えず、家族のスマホを比べます。セット割に必要な追加オプション費は試算に含まれる場合があります。':'スマホの契約は変えず、自宅回線の費用だけを比べます。現在の携帯プランの詳細が不明なため、スマホのセット割は金額に反映しません。';
      lineFields.forEach(f=>{const label=f.querySelector<HTMLElement>('.check-label')!;label.hidden=goal==='home';});
    };
    const optionalNumber=(value:FormDataEntryValue|null)=>{if(value===null||String(value).trim()==='')return null;const n=Number(value);return Number.isFinite(n)&&n>=0?n:null;};
    const readInput=():HouseholdInput=>{
      const f=new FormData(form);const goal=getGoal();
      return {goal,prefecture:prefecture.value,municipality:municipality.value,building:(f.get('building')||'house') as HouseholdInput['building'],construction:(f.get('construction')||'unknown') as HouseholdInput['construction'],years:Number(f.get('years')||2) as HouseholdInput['years'],homeTenure:(f.get('homeTenure')||'unknown') as HouseholdInput['homeTenure'],start:(f.get('start')||'now') as HouseholdInput['start'],support:(f.get('support')||'either') as HouseholdInput['support'],familyDiscount:f.has('familyDiscount'),currentHome:String(f.get('currentHome')||'other'),currentMonthly:optionalNumber(f.get('currentMonthly')),switchingCost:optionalNumber(f.get('switchingCost')),useCampaigns:f.has('useCampaigns'),lines:goal==='home'?[]:Array.from({length:count()},(_,i)=>({carrier:String(f.get(`carrier-${i}`)||'other'),dataGb:Number(f.get(`data-${i}`)||0),tenure:(f.get(`tenure-${i}`)||'unknown') as HouseholdInput['homeTenure'],keepCarrier:f.has(`keep-${i}`)}))};
    };
    const addFact=(dl:HTMLElement,label:string,value:string)=>{const row=el('div');row.append(el('dt',label),el('dd',value));dl.append(row);};
    const homeName=(id:string|null)=>id?(homeNames.find(h=>h.id===id)?.name||id):'自宅回線の変更なし';
    const drawSelected=(proposal:Proposal,input:HouseholdInput,index:number)=>{
      const selected=el('section','','selected-proposal');
      selected.append(el('h3',index===0?'掲載条件で、利用期間の費用を抑える組合せ':'比較案'+(index+1)));
      const price=el('p','','total-monthly');price.append(el('span','月額の参考合計'),el('strong',money(proposal.monthly)),el('span','／月（税込）'));selected.append(price);
      const quick=el('div','','quick-apply-area');quick.append(el('p','エリア・対象条件を確認して、申込みへ進む','quick-apply-title'));const quickGrid=el('div','','quick-apply-grid');
      const addQuick=(template:HTMLTemplateElement|null,label:string,officialUrl?:string)=>{const source=template?.content.querySelector<HTMLAnchorElement>('a');if(!source)return;const button=source.cloneNode(true) as HTMLAnchorElement;button.classList.add('quick-apply');if(!button.hasAttribute('data-affiliate-link')&&officialUrl)button.href=officialUrl;const item=el('div','','quick-apply-item');const ad=button.relList.contains('sponsored');item.append(el('p',(ad?'PR・':'公式・')+label,'quick-disclosure'),button);quickGrid.append(item);};
      if(input.goal!=='mobile'&&proposal.homeId)addQuick(root.querySelector<HTMLTemplateElement>(`[data-household-home-template="${proposal.homeId}:${input.building}"]`),'自宅回線の申込み窓口');
      if(input.goal!=='home'){const groups=new Map<string,Proposal['lines']>();proposal.lines.forEach(line=>groups.set(line.brandId,[...(groups.get(line.brandId)||[]),line]));groups.forEach((lines,brandId)=>addQuick(root.querySelector<HTMLTemplateElement>(`[data-household-mobile-template="${brandId}"]`),`スマホ${lines.length}回線の申込み窓口`,lines[0].url));}
      quick.append(quickGrid);selected.append(quick);
      const breakdown=el('dl','','price-breakdown');if(input.goal!=='mobile')addFact(breakdown,'自宅回線',money(proposal.homeMonthly));addFact(breakdown,'必要なオプション',money(proposal.optionMonthly));if(input.goal!=='home')addFact(breakdown,'スマホ合計',money(proposal.mobileMonthly));selected.append(breakdown);
      const costs=el('dl','','switching-breakdown');addFact(costs,`特典適用前の${input.years}年分の参考額`,money(proposal.referenceTotal));addFact(costs,'特典控除後の期間参考額（乗換費用は別）',money(proposal.referenceTotal-proposal.campaignAmount));addFact(costs,'乗換費用',input.switchingCost===null?'未入力・金額未確認':money(input.switchingCost));addFact(costs,'条件・受取を仮定した特典',money(proposal.campaignAmount));selected.append(costs);
      if(proposal.periodSavings!==null){const saving=el('div','','saving-callout');saving.append(el('p',`${input.years}年間の特典・費用込みの差額目安`),el('strong',proposal.periodSavings>=0?money(proposal.periodSavings)+'の節約目安':money(-proposal.periodSavings)+'増える目安'));selected.append(saving);}else{const help=el('div','','saving-help');if(proposal.monthlySavings!==null)help.append(el('strong',proposal.monthlySavings>=0?'入力した月額から '+money(proposal.monthlySavings)+'／月 低い目安':'入力した月額より '+money(-proposal.monthlySavings)+'／月 高い目安'));help.append(el('p','期間全体の節約目安は、現在の月額と乗換費用を両方入力した場合に表示します。分からない費用を0円として計算しません。'),anchor('月額・乗換費用を入力する','#household-cost-fields'));selected.append(help);}
      const conditions=el('details','','estimate-conditions');conditions.append(el('summary','この組合せの料金・特典の対象条件を確認'));conditions.append(el('p',proposal.note,'proposal-note'));
      if(proposal.campaignNote)conditions.append(el('p',proposal.campaignNote,'campaign-note'));
      conditions.append(el('p','通話・初期費用・工事・端末・解約費や、未確定の将来改定は月額の参考額に含みません。乗換費用には、確認した金額を別に入力してください。','amount-limit'));selected.append(conditions);
      const applyJump=anchor('この組合せの申込先と条件を見る','#household-apply','apply-jump');selected.append(applyJump);
