---
import AffiliateButton from './AffiliateButton.astro';
import { jpDate, type Provider } from '../lib/data';
import { connectivityMangaImages, getConnectivityManga, type ConnectivityMangaStory, type ConnectivityMangaPanel, type ConnectivityMangaPanelOverride } from '../lib/connectivity-manga';

interface Props {
  story: ConnectivityMangaStory;
  context?: string;
  diagnosisHref?: string;
  comparisonHref?: string;
  products?: Provider[];
  id?: string;
  panels?: ConnectivityMangaPanelOverride[];
}
const { story, context = '', diagnosisHref = '/shindan/', comparisonHref = '#compare', products = [], id = 'connectivity-manga', panels: suppliedPanels } = Astro.props;
const content = getConnectivityManga(story, context);
const panels = (suppliedPanels?.length ? suppliedPanels : content.panels).slice(0, 4).map((panel, index): ConnectivityMangaPanel => {
  const fallback = content.panels[index];
  const frame = panel.frame ?? fallback.frame;
  return {
    title: panel.title || fallback.title,
    sheet: panel.sheet ?? fallback.sheet,
    frame: Number.isFinite(frame) ? Math.min(5, Math.max(0, Math.floor(frame))) : fallback.frame,
    alt: panel.alt ?? fallback.alt,
    point: panel.point ?? fallback.point,
    lines: panel.lines.map((line, lineIndex) => typeof line === 'string' ? { who: lineIndex % 2 === 0 ? '夫' : '妻', text: line } : line),
  };
});
const areaFirst = story === 'area' || story === 'national';
const comparisonLabel = story === 'area' ? '住所の提供エリアを確認する' : story === 'national' ? '使う地域を選んで比較する' : '料金・条件を比較する';
const diagnosisLabel = '家族の条件で診断する';
const firstAction = areaFirst ? { href: comparisonHref, label: comparisonLabel } : { href: diagnosisHref, label: diagnosisLabel };
const secondAction = areaFirst ? { href: diagnosisHref, label: diagnosisLabel } : { href: comparisonHref, label: comparisonLabel };
---
<section id={id} class="connectivity-manga" aria-labelledby={`${id}-title`}>
  <header class="connectivity-heading">
    <p class="connectivity-kicker">漫画でわかる · 全4コマ</p>
    <h2 id={`${id}-title`}>{content.title}</h2>
    <p class="connectivity-lead">{content.lead}</p>
    <p class="connectivity-fiction">この漫画は、架空の夫婦による選び方の例です。</p>
  </header>
  <div class="connectivity-story">
    {panels.map((panel, index) => <section class="connectivity-panel" aria-labelledby={`${id}-panel-${index + 1}`}>
      <h3 id={`${id}-panel-${index + 1}`}><span aria-hidden="true">{index + 1}</span>{panel.title}</h3>
      <div class="connectivity-scene" role="img" aria-label={panel.alt}>
        <img src={connectivityMangaImages[panel.sheet]} width="1024" height="1536" alt="" loading="lazy" decoding="async" style={`left:${-(panel.frame % 2) * 100}%;top:${-Math.floor(panel.frame / 2) * 100}%`} />
      </div>
      <div class="connectivity-dialogue">{panel.lines.map(line => <p class:list={['connectivity-speech', { wife: line.who === '妻' }]}><span class="connectivity-speaker">{line.who}</span><span>{line.text}</span></p>)}</div>
      <p class="connectivity-point"><span>比べるヒント</span>{panel.point}</p>
    </section>)}
  </div>
  <nav class="connectivity-next" aria-label="漫画の次にすること">
    <p>{areaFirst ? '住所で使える候補を確かめてから、家族の条件で絞りましょう。' : '次は、あなたの家族の条件で比べてみましょう。'}</p>
    <div><a class="connectivity-primary" href={firstAction.href}>{firstAction.label}<span aria-hidden="true">→</span></a><a class="connectivity-secondary" href={secondAction.href}>{secondAction.label}<span aria-hidden="true">→</span></a></div>
    <span class="connectivity-privacy">診断は詳しい住所・氏名・連絡先の入力不要です。</span>
  </nav>
  {products.length > 0 && <section class="connectivity-products" aria-labelledby={`${id}-products`}>
    <div class="connectivity-products-heading"><h3 id={`${id}-products`}>候補の料金と、申込先の条件を見る</h3><p>住所の提供判定・対象プラン・追加費用を確認してから選んでください。</p></div>
    <div class="connectivity-product-grid">{products.map(product => <article>
      <h4>{product.name}</h4>
      <dl><div><dt>戸建て月額</dt><dd>{product.house?.label ?? '公式で確認'}</dd></div><div><dt>マンション月額</dt><dd>{product.mansion?.label ?? '公式で確認'}</dd></div></dl>
      <p class="connectivity-product-condition">{story === 'mansion' ? product.mansion?.note : product.house?.note}</p>
      <p class="connectivity-product-caution">{product.cautions[0]}</p>
      <AffiliateButton provider={product} showBanner={true} actionFirst={true} building={story === 'mansion' ? 'mansion' : undefined} />
      <a class="connectivity-detail" href={`/hikari/${product.id}/`}>料金・契約条件を詳しく読む →</a>
      <p class="connectivity-checked">公式情報の確認：{jpDate(product.checkedAt)}</p>
    </article>)}</div>
  </section>}
</section>
<style>
  .connectivity-manga{margin:30px 0 34px;color:#263b32;min-width:0;overflow-wrap:anywhere;scroll-margin-top:24px}.connectivity-heading{margin-bottom:21px}.connectivity-kicker{font-size:13px;font-weight:800;letter-spacing:.05em;color:#a04b29}.connectivity-heading h2{font-family:var(--font-sans);font-size:clamp(24px,3vw,31px);font-weight:800;line-height:1.55;margin:8px 0 10px}.connectivity-lead{font-size:16px;line-height:1.85;color:#526257}.connectivity-fiction{font-size:12px;line-height:1.8;color:#637166;margin-top:7px}.connectivity-story{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;gap:22px 20px}.connectivity-panel{min-width:0;border:1px solid #cdd8cd;border-radius:11px;overflow:hidden;background:#fffdf7;box-shadow:0 3px 0 #e7ece4}.connectivity-panel h3{display:flex;align-items:center;gap:11px;min-height:65px;padding:13px 16px;font-size:17px;font-weight:800;line-height:1.6;background:#f3f6ee}.connectivity-panel h3>span{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:30px;height:30px;border-radius:50%;background:#175d50;color:#fff;font-size:14px}.connectivity-scene{position:relative;aspect-ratio:1;overflow:hidden;border-block:1px solid #d8dfd3;background:#f4ead9}.connectivity-scene img{position:absolute;width:200%;height:300%;max-width:none;object-fit:fill}.connectivity-dialogue{display:grid;gap:12px;padding:18px 16px 15px}.connectivity-speech{display:flex;align-items:flex-start;gap:9px;line-height:1.85;font-size:16px;font-weight:600}.connectivity-speech>span:last-child{flex:1;min-width:0;padding:10px 12px;border:1px solid #d4e2d5;border-radius:3px 14px 14px 14px;background:#fff}.connectivity-speech.wife>span:last-child{background:#fff3e6;border-color:#e7c9aa}.connectivity-speaker{display:flex;flex-shrink:0;align-items:center;justify-content:center;width:28px;height:28px;margin-top:7px;border-radius:50%;background:#dcebe3;color:#175d50;font-size:12px;font-weight:800}.wife .connectivity-speaker{background:#f8dfc1;color:#925026}.connectivity-point{border-top:1px dashed #d5dfd0;margin:0 16px;padding:13px 0 16px;color:#526256;font-size:13px;line-height:1.85}.connectivity-point>span{display:block;color:#175d50;font-size:11px;font-weight:800;letter-spacing:.05em;margin-bottom:3px}.connectivity-next{margin-top:26px;border:2px solid #175d50;background:#f1f7f0;border-radius:10px;padding:23px;text-align:center}.connectivity-next>p{font-size:17px;font-weight:800;line-height:1.8;margin-bottom:15px}.connectivity-next>div{display:grid;grid-template-columns:1fr 1fr;gap:12px;max-width:760px;margin-inline:auto}.connectivity-primary,.connectivity-secondary{display:flex;align-items:center;justify-content:center;gap:15px;min-height:56px;padding:13px 16px;border-radius:6px;font-size:16px;font-weight:800;line-height:1.7;text-decoration:none}.connectivity-primary{border:1px solid #954420;background:#ad512e;box-shadow:0 3px 0 #843a20;color:#fff}.connectivity-primary:hover{background:#934222}.connectivity-secondary{border:1px solid #b8cfc1;background:#fff;color:#175d50}.connectivity-secondary:hover{background:#e7f1e9}.connectivity-primary:focus-visible,.connectivity-secondary:focus-visible{outline:3px solid #175d50;outline-offset:4px}.connectivity-privacy{display:block;margin-top:13px;font-size:12px;line-height:1.7;color:#5b6b60}.connectivity-products{margin-top:28px}.connectivity-products-heading h3{font-size:22px;line-height:1.6;font-weight:800}.connectivity-products-heading p{font-size:14px;line-height:1.85;color:#5a6d60;margin-top:7px}.connectivity-product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-items:start;gap:17px;margin-top:16px}.connectivity-product-grid>article{min-width:0;padding:20px;border:1px solid #ccdacf;border-radius:8px;background:#fff}.connectivity-product-grid h4{font-size:21px;font-weight:800;line-height:1.6;margin-bottom:12px}.connectivity-product-grid dl{display:grid;gap:8px;padding:12px 14px;border-radius:6px;background:#f2f7f2}.connectivity-product-grid dl>div{display:flex;justify-content:space-between;align-items:baseline;gap:12px}.connectivity-product-grid dt{font-size:12px;color:#5d7163;flex-shrink:0}.connectivity-product-grid dd{font-size:18px;line-height:1.5;font-weight:800;color:#175d50;text-align:right}.connectivity-product-condition{font-size:13px;line-height:1.8;color:#5a6b5f;margin:12px 0}.connectivity-product-caution{padding:10px 12px;border-radius:5px;background:#fff6e9;color:#86502d;font-size:13px;line-height:1.8;margin:12px 0 16px}.connectivity-detail{display:block;text-align:center;font-size:13px;font-weight:700;color:#175d50;text-decoration:underline;text-underline-offset:3px;margin-top:13px}.connectivity-checked{font-size:12px;color:#617165;line-height:1.7;margin-top:12px}.connectivity-product-grid :global(.affiliate-block){margin-top:0!important}.connectivity-product-grid :global(.affiliate-banner){margin-top:0!important}@media(max-width:650px){.connectivity-manga{margin:24px 0 28px}.connectivity-heading{margin-bottom:18px}.connectivity-heading h2{font-size:24px}.connectivity-lead{font-size:15px}.connectivity-story{grid-template-columns:1fr;gap:21px}.connectivity-panel h3{min-height:58px;padding:12px 14px;font-size:16px;gap:10px}.connectivity-panel h3>span{width:28px;height:28px;font-size:13px}.connectivity-dialogue{padding:16px 13px 14px;gap:11px}.connectivity-speech{gap:8px;font-size:16px}.connectivity-speech>span:last-child{padding:9px 10px}.connectivity-point{margin-inline:13px}.connectivity-next{padding:21px 15px;margin-top:23px}.connectivity-next>p{font-size:16px}.connectivity-next>div{grid-template-columns:1fr;gap:11px}.connectivity-primary,.connectivity-secondary{font-size:16px;min-height:54px;padding:13px 11px}.connectivity-product-grid{grid-template-columns:1fr;gap:15px}.connectivity-product-grid>article{padding:18px}.connectivity-products-heading h3{font-size:20px}.connectivity-product-grid dd{font-size:17px}.connectivity-product-grid dl>div{align-items:start}}
</style>
